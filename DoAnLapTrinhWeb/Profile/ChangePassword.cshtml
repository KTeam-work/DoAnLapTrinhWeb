@page
@model TV1.Pages.Profile.ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="tv1-card">
    <h2>Đổi mật khẩu</h2>

    <form method="post" class="tv1-form">
        <label asp-for="OldPassword">Mật khẩu hiện tại</label>
        <input asp-for="OldPassword" type="password" placeholder="••••••••" />

        <label asp-for="NewPassword">Mật khẩu mới</label>
        <input asp-for="NewPassword" type="password" placeholder="••••••••" />

        <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
        <input asp-for="ConfirmPassword" type="password" placeholder="••••••••" />

        <button type="submit" class="tv1-btn">Cập nhật mật khẩu</button>
    </form>

    <div class="tv1-links">
        <a asp-page="/Profile/Index">Quay lại hồ sơ</a>
    </div>
</div>
