@model DoAnLapTrinhWeb.Models.User
@{
    ViewBag.Title = "Tài khoản";
    ViewBag.Active = "profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string initials = string.IsNullOrWhiteSpace(Model.FullName)
        ? "?"
        : string.Join("", Model.FullName.Split(' ').Where(s => s.Length > 0).Select(s => s[0])).ToUpper();
    if (initials.Length > 2) { initials = initials.Substring(initials.Length - 2); }
}

<style>
    .section {
        max-width: 960px;
        margin: 0 auto;
        padding: 48px 32px 64px;
    }

    .profile-head {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 32px;
    }

    .avatar {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: linear-gradient(160deg,var(--caramel),var(--tea-dark));
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--cream);
        font-family: 'Fraunces',serif;
        font-size: 26px;
        font-weight: 600;
        flex-shrink: 0;
    }

    .profile-head h1 {
        font-family: 'Fraunces',serif;
        font-size: 26px;
        color: var(--tea-dark);
        margin: 0 0 4px;
    }

    .profile-head p {
        font-size: 13.5px;
        color: #8a7263;
        margin: 0;
    }

    .stat-row {
        display: flex;
        gap: 16px;
        margin-bottom: 32px;
        flex-wrap: wrap;
    }

    .stat-card {
        background: #fff;
        border: 2px solid var(--milk);
        border-radius: 16px;
        padding: 18px 22px;
        min-width: 150px;
        flex: 1;
    }

        .stat-card b {
            display: block;
            font-family: 'Fraunces',serif;
            font-size: 22px;
            color: var(--tea-dark);
        }

        .stat-card span {
            font-size: 12.5px;
            color: #8a7263;
        }

    .grid-2 {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 24px;
    }

    .card {
        background: #fff;
        border: 2px solid var(--milk);
        border-radius: 20px;
        padding: 26px 24px;
    }

        .card h2 {
            font-family: 'Fraunces',serif;
            font-size: 18px;
            color: var(--tea-dark);
            margin: 0 0 18px;
        }

    .field {
        margin-bottom: 16px;
    }

        .field label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
            color: var(--tea-dark);
        }

        .field input {
            width: 100%;
            padding: 12px 15px;
            border-radius: 14px;
            border: 2px solid var(--milk);
            background: var(--cream);
            font-family: 'Quicksand',sans-serif;
            font-size: 14.5px;
            color: var(--pearl);
            outline: none;
            transition: border-color .18s ease, background .18s ease;
        }

            .field input:focus {
                border-color: var(--caramel);
                background: #fff;
            }

    .btn-primary {
        padding: 12px 22px;
        border: none;
        border-radius: 14px;
        background: var(--tea-dark);
        color: var(--cream);
        font-family: 'Quicksand',sans-serif;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s ease;
    }

        .btn-primary:hover {
            background: var(--tea);
        }

    .order-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .order-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 14px;
        border-radius: 14px;
        background: var(--cream);
        font-size: 13.5px;
    }

        .order-row .name {
            font-weight: 600;
            color: var(--tea-dark);
        }

        .order-row .meta {
            font-size: 11.5px;
            color: #a7947f;
        }

        .order-row .price {
            font-weight: 700;
            color: var(--tea);
        }

    .link-row {
        margin-top: 18px;
        display: flex;
        gap: 14px;
        font-size: 13px;
    }

        .link-row a {
            color: var(--tea);
            font-weight: 600;
            text-decoration: none;
        }

            .link-row a:hover {
                text-decoration: underline;
            }

    @@media (max-width:820px) {
        .grid-2 {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="section">
    <div class="profile-head">
        <div class="avatar">@initials</div>
        <div>
            <h1>Xin chào, @Model.FullName</h1>
            <p>Thành viên từ @Model.CreatedAt.ToString("MM/yyyy")</p>
        </div>
    </div>

    <div class="stat-row">
        <div class="stat-card"><b>128</b><span>điểm tích luỹ</span></div>
        <div class="stat-card"><b>24</b><span>ly đã đặt</span></div>
        <div class="stat-card"><b>1</b><span>ly miễn phí sắp mở khoá</span></div>
    </div>

    <div class="grid-2">
        <div class="card">
            <h2>Thông tin cá nhân</h2>
            @using (Html.BeginForm("UpdateProfile", "Profile", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="field">
                    <label for="FullName">Họ và tên</label>
                    <input type="text" id="FullName" name="FullName" value="@Model.FullName" />
                </div>
                <div class="field">
                    <label for="Email">Email</label>
                    <input type="email" id="Email" name="Email" value="@Model.Email" />
                </div>
                <div class="field">
                    <label for="PhoneNumber">Số điện thoại</label>
                    <input type="tel" id="PhoneNumber" name="PhoneNumber" value="@Model.PhoneNumber" />
                </div>
                <button type="submit" class="btn-primary">Lưu thay đổi</button>
            }
            <div class="link-row">
                <a href="@Url.Action("ChangePassword", "Profile")">Đổi mật khẩu</a>
                <a href="@Url.Action("Logout", "Account")">Đăng xuất</a>
            </div>
        </div>

        <div class="card">
            <h2>Đơn gần đây</h2>
            <div class="order-list">
                <div class="order-row">
                    <div><div class="name">Trà Sữa Truyền Thống</div><div class="meta">Hôm qua, 15:20</div></div>
                    <div class="price">29.000đ</div>
                </div>
                <div class="order-row">
                    <div><div class="name">Trà Đào Cam Sả</div><div class="meta">3 ngày trước</div></div>
                    <div class="price">35.000đ</div>
                </div>
                <div class="order-row">
                    <div><div class="name">Hồng Trà Dâu Tây</div><div class="meta">Tuần trước</div></div>
                    <div class="price">36.000đ</div>
                </div>
            </div>
        </div>
    </div>
</section>