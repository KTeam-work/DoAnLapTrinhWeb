@model DoAnLapTrinhWeb.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Đổi mật khẩu";
    ViewBag.Active = "profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .section {
        max-width: 560px;
        margin: 0 auto;
        padding: 64px 32px;
    }

    .card {
        background: #fff;
        border: 2px solid var(--milk);
        border-radius: 22px;
        padding: 36px 32px;
    }

    .card h1 {
            font-family: 'Fraunces',serif;
            font-size: 24px;
            color: var(--tea-dark);
           margin: 0 0 6px;
    }

    .card p.lead {
            font-size: 13.5px;
            color: #8a7263;
            margin: 0 0 26px;
     }

    .field {
        margin-bottom: 18px;
    }

        .field label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
            color: var(--tea-dark);
        }

    .field input {
            width: 100%;
            padding: 12px 15px;
            border-radius: 14px;
            border: 2px solid var(--milk);
            background: var(--cream);
            font-family: 'Quicksand',sans-serif;
            font-size: 14.5px;
            color: var(--pearl);
            outline: none;
            transition: border-color .18s ease, background .18s ease;
    }

            .field input:focus {
                border-color: var(--caramel);
                background: #fff;
            }

        .field small {
            display: block;
            margin-top: 5px;
            font-size: 11.5px;
            color: #a7947f;
        }

    .btn-primary {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 14px;
        background: var(--tea-dark);
        color: var(--cream);
        font-family: 'Quicksand',sans-serif;
        font-size: 14.5px;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s ease, transform .15s ease;
    }

        .btn-primary:hover {
            background: var(--tea);
            transform: translateY(-1px);
        }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 18px;
        font-size: 13px;
        color: var(--tea);
        text-decoration: none;
        font-weight: 600;
    }

        .back-link:hover {
            text-decoration: underline;
        }

    .error-summary {
        background: #FCE8E1;
        border: 1px solid #E98B6E;
        color: #7A2E17;
        padding: 10px 14px;
        border-radius: 12px;
        font-size: 13px;
        margin-bottom: 16px;
    }
</style>


<section class="section">
    <div class="card">
        <h1>Đổi mật khẩu</h1>
        <p class="lead">Chọn một mật khẩu mới thật khó đoán để bảo vệ tài khoản của bạn.</p>

        @using (Html.BeginForm("ChangePassword", "Profile", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            if (!ViewData.ModelState.IsValid)
            {
                <div class="error-summary">@Html.ValidationSummary(true, "", new { })</div>
            }

            <div class="field">
                <label for="CurrentPassword">Mật khẩu hiện tại</label>
                @Html.PasswordFor(m => m.CurrentPassword, new { id = "CurrentPassword", placeholder = "••••••••" })
                @Html.ValidationMessageFor(m => m.CurrentPassword)
            </div>
            <div class="field">
                <label for="NewPassword">Mật khẩu mới</label>
                @Html.PasswordFor(m => m.NewPassword, new { id = "NewPassword", placeholder = "••••••••" })
                @Html.ValidationMessageFor(m => m.NewPassword)
                <small>Tối thiểu 6 ký tự</small>
            </div>
            <div class="field">
                <label for="ConfirmNewPassword">Xác nhận mật khẩu mới</label>
                @Html.PasswordFor(m => m.ConfirmNewPassword, new { id = "ConfirmNewPassword", placeholder = "••••••••" })
                @Html.ValidationMessageFor(m => m.ConfirmNewPassword)
            </div>

            <button type="submit" class="btn-primary">Cập nhật mật khẩu</button>
        }

        <a class="back-link" href="@Url.Action("Index", "Profile")">← Quay lại tài khoản</a>
    </div>
</section>
