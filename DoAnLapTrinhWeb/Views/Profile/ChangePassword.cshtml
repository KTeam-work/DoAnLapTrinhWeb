@{
    ViewBag.Title = "Đổi mật khẩu";
    ViewBag.Active = "profile";
    string role = (Session["UserRole"]?.ToString() ?? "").Trim();
    if (role == "R02")
    {
        // Nhân viên sử dụng StaffLayout
        Layout = "~/Views/Shared/_StaffLayout.cshtml";
    }
    else
    {
        // Admin sử dụng AdminLayout
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
}

<style>
    .section {
        max-width: 560px;
        margin: 0 auto;
        padding: 48px 24px;
        font-family: 'Quicksand', sans-serif;
    }

    .card {
        background: #fff;
        border: 1.5px solid var(--milk, #ece6de);
        border-radius: 22px;
        padding: 36px 32px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }

        .card h1 {
            font-family: 'Fraunces', serif;
            font-size: 24px;
            color: var(--tea-dark, #2b170b);
            margin: 0 0 6px;
        }

        .card p.lead {
            font-size: 13.5px;
            color: #8a7263;
            margin: 0 0 24px;
        }

    .field {
        margin-bottom: 20px;
    }

        .field label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 6px;
            color: var(--tea-dark, #2b170b);
        }

    /* Bọc input để gắn nút icon mắt xem mật khẩu */
    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

        .input-wrapper input {
            width: 100%;
            padding: 12px 45px 12px 15px;
            border-radius: 14px;
            border: 1.5px solid var(--milk, #ece6de);
            background: var(--cream, #fbf9f6);
            font-family: 'Quicksand', sans-serif;
            font-size: 14.5px;
            color: var(--pearl, #2b170b);
            outline: none;
            transition: border-color .18s ease, background .18s ease;
            box-sizing: border-box;
        }

            .input-wrapper input:focus {
                border-color: var(--caramel, #c08253);
                background: #fff;
            }

    /* Nút icon con mắt toggle */
    .toggle-pwd {
        position: absolute;
        right: 14px;
        background: transparent;
        border: none;
        cursor: pointer;
        color: #8a7263;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        outline: none;
        transition: color .2s ease;
    }

        .toggle-pwd:hover {
            color: var(--tea-dark, #2b170b);
        }

        .toggle-pwd svg {
            width: 20px;
            height: 20px;
        }

    .field small {
        display: block;
        margin-top: 6px;
        font-size: 11.5px;
        color: #a7947f;
    }

    .btn-primary {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 14px;
        background: var(--tea-dark, #3c2415);
        color: #fff;
        font-family: 'Quicksand', sans-serif;
        font-size: 14.5px;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s ease, transform .15s ease;
        margin-top: 8px;
    }

        .btn-primary:hover {
            background: var(--caramel, #c08253);
            transform: translateY(-1px);
        }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 20px;
        font-size: 13px;
        color: var(--tea-dark, #3c2415);
        text-decoration: none;
        font-weight: 600;
        transition: color .15s;
    }

        .back-link:hover {
            color: var(--caramel, #c08253);
            text-decoration: underline;
        }

    .error-summary {
        background: #FCE8E1;
        border: 1px solid #E98B6E;
        color: #7A2E17;
        padding: 10px 14px;
        border-radius: 12px;
        font-size: 13px;
        margin-bottom: 18px;
        font-weight: 600;
    }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        font-size: 12px;
        color: #c62828;
        font-weight: 600;
    }
</style>

<section class="section">
    <div class="card">
        <h1>Đổi mật khẩu</h1>
        <p class="lead">Chọn một mật khẩu mới thật khó đoán để bảo vệ tài khoản của bạn.</p>

        @using (Html.BeginForm("ChangePassword", "Profile", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            if (!ViewData.ModelState.IsValid)
            {
                <div class="error-summary">@Html.ValidationSummary(true, "", new { })</div>
            }

            <!-- Mật khẩu hiện tại (Đã gắn sẵn mật khẩu cũ từ DB) -->
            <div class="field">
                <label for="CurrentPassword">Mật khẩu hiện tại</label>
                <div class="input-wrapper">
                    @Html.Password("CurrentPassword", (string)ViewBag.CurrentPassword, new { placeholder = "••••••••", id = "CurrentPassword" })
                    <button type="button" class="toggle-pwd" onclick="togglePasswordVisibility('CurrentPassword', this)" title="Ẩn/Hiện mật khẩu">
                        <svg class="eye-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        <svg class="eye-closed" style="display:none;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                        </svg>
                    </button>
                </div>
                @Html.ValidationMessage("CurrentPassword")
            </div>

            <!-- Mật khẩu mới -->
            <div class="field">
                <label for="NewPassword">Mật khẩu mới</label>
                <div class="input-wrapper">
                    @Html.Password("NewPassword", "", new { placeholder = "••••••••", id = "NewPassword" })
                    <button type="button" class="toggle-pwd" onclick="togglePasswordVisibility('NewPassword', this)" title="Ẩn/Hiện mật khẩu">
                        <svg class="eye-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        <svg class="eye-closed" style="display:none;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                        </svg>
                    </button>
                </div>
                @Html.ValidationMessage("NewPassword")
                <small>Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</small>
            </div>

            <!-- Xác nhận mật khẩu mới -->
            <div class="field">
                <label for="ConfirmNewPassword">Xác nhận mật khẩu mới</label>
                <div class="input-wrapper">
                    @Html.Password("ConfirmNewPassword", "", new { placeholder = "••••••••", id = "ConfirmNewPassword" })
                    <button type="button" class="toggle-pwd" onclick="togglePasswordVisibility('ConfirmNewPassword', this)" title="Ẩn/Hiện mật khẩu">
                        <svg class="eye-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        <svg class="eye-closed" style="display:none;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                        </svg>
                    </button>
                </div>
                @Html.ValidationMessage("ConfirmNewPassword")
            </div>

            <button type="submit" class="btn-primary">Cập nhật mật khẩu</button>
        }

        <a class="back-link" href="@Url.Action("Index", "Profile")">← Quay lại tài khoản</a>
    </div>
</section>

<script>
    function togglePasswordVisibility(inputId, btn) {
        var input = document.getElementById(inputId);
        var eyeOpen = btn.querySelector('.eye-open');
        var eyeClosed = btn.querySelector('.eye-closed');

        if (input.type === "password") {
            input.type = "text";
            eyeOpen.style.display = "none";
            eyeClosed.style.display = "block";
        } else {
            input.type = "password";
            eyeOpen.style.display = "block";
            eyeClosed.style.display = "none";
        }
    }
</script>