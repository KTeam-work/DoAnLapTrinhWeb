@{
    ViewBag.Title = "Cổng Thanh Toán - LumiTea";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --lumitea-primary: #1A4D3E;
            --lumitea-accent: #F6C90E;
            --lumitea-bg: #F8FAFC;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--lumitea-bg);
        }

        .payment-container {
            max-width: 550px;
            margin: 0 auto;
        }

        .payment-card {
            background: #fff;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.03);
            text-align: center;
        }

        .qr-box {
            width: 250px;
            height: 250px;
            margin: 0 auto 1.5rem;
            padding: 10px;
            border: 2px dashed #cbd5e1;
            border-radius: 16px;
            background: #fff;
            position: relative;
        }

        .qr-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 12px;
        }

        

        @@keyframes scan {
            0% { top: 0; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: 100%; opacity: 0; }
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem 0;
            border-bottom: 1px dashed #e2e8f0;
            font-size: 0.95rem;
        }
        .info-row:last-child {
            border-bottom: none;
        }

        .btn-confirm {
            background-color: var(--lumitea-primary);
            color: white;
            font-weight: 700;
            border: none;
            border-radius: 12px;
            padding: 14px;
            width: 100%;
            transition: all 0.2s;
            margin-top: 1.5rem;
        }
        .btn-confirm:hover {
            background-color: #12382c;
            transform: translateY(-2px);
        }

        .timer-box {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: 700;
            font-family: monospace;
            font-size: 1.1rem;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>

    <div class="container py-5">
        <div class="payment-container">

            <div class="text-center mb-4">
                <h3 class="fw-extrabold m-0" style="color: var(--lumitea-primary); letter-spacing: -0.5px;">Thanh toán đơn hàng</h3>
                <p class="text-muted small mt-1">Vui lòng hoàn tất thanh toán để quán chuẩn bị món</p>
            </div>

            <div class="payment-card">

                
                <div class="d-flex justify-content-center align-items-center gap-2 mb-3">
                    <i class="fa-solid fa-building-columns fs-3 text-primary"></i>
                    <h5 class="fw-bold m-0 text-dark">Chuyển khoản VietQR</h5>
                </div>

                <!-- ĐÔNG HỒ -->
                <div class="timer-box">
                    <i class="fa-regular fa-clock"></i> <span id="countdownTimer">10:00</span>
                </div>

                <!-- QR CODE -->
                <div class="qr-box shadow-sm">
                    <div ></div>
                   
                    <img src="~/Assets/momo.jpg" alt="Mã QR Thanh Toán">
                </div>
                

                <p class="text-muted small mb-4">Mở ứng dụng ngân hàng và quét mã QR phía trên.</p>

                <div class="bg-light p-3 rounded-3 text-start mb-2">
                    <!-- THÔNG TIN  -->
                    <div class="info-row">
                        <span class="text-muted">Mã đơn hàng</span>
                        <span class="fw-bold text-dark">#ORD-1082</span> 
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Chủ tài khoản</span>
                        <span class="fw-bold text-dark">LUMI TEA VN</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Nội dung CK</span>
                        <span class="fw-bold text-dark text-primary">LUMITEA 1082</span>
                    </div>
                    <div class="info-row align-items-center border-0 pb-0 pt-3 mt-1" style="border-top: 2px solid #e2e8f0 !important;">
                        <span class="fw-bold text-dark">Số tiền cần thanh toán</span>
                     
                        <span class="fw-extrabold fs-4 text-danger" style="color: var(--lumitea-primary) !important;">153.000 đ</span>
                    </div>
                </div>

                <!-- FORM GIẢ THANH TOÁN THÀNH CÔNG, CHUYỂN SANG RESULT -->
                <form action="/Payment/Result" method="GET">
                    <input type="hidden" name="orderId" value="ORD-1082" />
                    <input type="hidden" name="status" value="success" />

                    <button type="submit" class="btn-confirm d-flex justify-content-center align-items-center gap-2">
                        <i class="fa-solid fa-circle-check"></i> Tôi đã thanh toán xong
                    </button>
                </form>

                <div class="mt-3">
                    <a href="~/Order/Checkout" class="text-decoration-none text-muted small fw-medium">
                        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại chọn phương thức khác
                    </a>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    // SCRIPT ĐỒNG HỒ
    document.addEventListener("DOMContentLoaded", function () {
        let time = 600; 
        const timerElement = document.getElementById("countdownTimer");

        const countdown = setInterval(function () {
            let minutes = Math.floor(time / 60);
            let seconds = time % 60;

            minutes = minutes < 10 ? "0" + minutes : minutes;
            seconds = seconds < 10 ? "0" + seconds : seconds;

            timerElement.textContent = minutes + ":" + seconds;

            if (time <= 0) {
                clearInterval(countdown);
                timerElement.textContent = "00:00";
                alert("Đã hết thời gian thanh toán. Vui lòng đặt lại đơn hàng.");
            }
            time--;
        }, 1000);
    });
    </script>
</body>
</html>