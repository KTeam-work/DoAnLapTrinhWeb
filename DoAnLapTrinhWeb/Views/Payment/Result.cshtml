@{
    ViewBag.Title = "Kết Quả Thanh Toán - LumiTea";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Biến giả lập trạng thái từ Controller truyền sang (Success hoặc Failed)
    // Trong thực tế, bạn sẽ lấy từ ViewBag.Status hoặc Model.PaymentStatus
    string paymentStatus = "Success";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="~/Css/StylePayment_Result.css" rel="stylesheet" />

</head>
<body>

    <div class="container py-5">
        <div class="result-container">

            <div class="result-card">

                @if (paymentStatus == "Success")
                {
                    <!-- GIAO DIỆN THÀNH CÔNG -->
                    <div class="status-icon-box status-success">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <h3 class="fw-extrabold text-dark mb-2">Thanh toán thành công!</h3>
                    <p class="text-muted small">Cảm ơn bạn. Đơn hàng của bạn đang được quán chuẩn bị.</p>

                    <div class="receipt-box">
                        <div class="info-row">
                            <span class="text-muted">Mã giao dịch</span>
                            <span class="fw-bold text-dark">VNQ-982731</span> 
                        </div>
                        <div class="info-row">
                            <span class="text-muted">Mã đơn hàng</span>
                            <span class="fw-bold text-dark">#ORD-1082</span>
                        </div>
                        <div class="info-row">
                            <span class="text-muted">Phương thức</span>
                            <span class="fw-bold text-dark">Chuyển khoản VietQR</span>
                        </div>
                        <div class="info-row">
                            <span class="text-muted">Thời gian</span>
                            <span class="fw-bold text-dark">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="info-row align-items-center mt-2 pt-2 border-top">
                            <span class="fw-bold text-dark">Số tiền</span>
                            <span class="fw-extrabold fs-5 text-success">153.000 đ</span>
                        </div>
                    </div>

                    <a href="~/Order/Tracking" class="btn btn-main d-block text-decoration-none">
                        Theo dõi đơn hàng
                    </a>
                    <a href="~/Menu/Index" class="btn btn-sub d-block text-decoration-none">
                        Quay về thực đơn
                    </a>
                }
                else
                {
                    <!-- GIAO DIỆN THẤT BẠI -->
                    <div class="status-icon-box status-failed">
                        <i class="fa-solid fa-xmark"></i>
                    </div>
                    <h3 class="fw-extrabold text-dark mb-2">Thanh toán thất bại!</h3>
                    <p class="text-muted small">Đã có lỗi xảy ra trong quá trình giao dịch hoặc bạn đã hủy thanh toán.</p>

                    <div class="receipt-box text-center py-4">
                        <i class="fa-solid fa-triangle-exclamation fs-1 text-warning mb-3"></i>
                        <h6 class="fw-bold text-dark m-0">Đơn hàng #ORD-1082 chưa được ghi nhận.</h6>
                        <p class="text-muted small mt-1 mb-0">Tài khoản của bạn chưa bị trừ tiền.</p>
                    </div>

                    <a href="~/Payment/Index" class="btn btn-main d-block text-decoration-none text-white">
                        Thử thanh toán lại
                    </a>
                    <a href="~/Order/Checkout" class="btn btn-sub d-block text-decoration-none">
                        Đổi phương thức thanh toán
                    </a>
                }

            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>