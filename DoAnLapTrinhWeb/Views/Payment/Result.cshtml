@{
    ViewBag.Title = "Kết Quả Thanh Toán - LumiTea";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Biến giả lập trạng thái từ Controller truyền sang (Success hoặc Failed)
    // Trong thực tế, bạn sẽ lấy từ ViewBag.Status hoặc Model.PaymentStatus
    string paymentStatus = "Success";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --lumitea-primary: #1A4D3E;
            --lumitea-accent: #F6C90E;
            --lumitea-bg: #F8FAFC;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--lumitea-bg);
        }

        .result-container {
            max-width: 500px;
            margin: 0 auto;
        }

        .result-card {
            background: #fff;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            padding: 2.5rem 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.03);
            text-align: center;
        }

        
        .status-icon-box {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            font-size: 2.5rem;
        }

        .status-success {
            background-color: rgba(22, 163, 74, 0.1);
            color: #16a34a;
            box-shadow: 0 0 0 10px rgba(22, 163, 74, 0.05);
        }

        .status-failed {
            background-color: rgba(220, 38, 38, 0.1);
            color: #dc2626;
            box-shadow: 0 0 0 10px rgba(220, 38, 38, 0.05);
        }

        .receipt-box {
            background-color: #f8fafc;
            border-radius: 12px;
            padding: 1.5rem;
            margin: 1.5rem 0;
            text-align: left;
            border: 1px dashed #cbd5e1;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            font-size: 0.95rem;
        }

        .btn-main {
            background-color: var(--lumitea-primary);
            color: white;
            font-weight: 700;
            border: none;
            border-radius: 12px;
            padding: 14px;
            width: 100%;
            transition: all 0.2s;
            margin-bottom: 0.75rem;
        }

            .btn-main:hover {
                background-color: #12382c;
                color: white;
                transform: translateY(-2px);
            }

        .btn-sub {
            background-color: transparent;
            color: #64748B;
            font-weight: 600;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            padding: 14px;
            width: 100%;
            transition: all 0.2s;
        }

            .btn-sub:hover {
                background-color: #f1f5f9;
                color: var(--lumitea-primary);
            }
    </style>
</head>
<body>

    <div class="container py-5">
        <div class="result-container">

            <div class="result-card">

                @if (paymentStatus == "Success")
                {
                    <!-- GIAO DIỆN THÀNH CÔNG -->
                    <div class="status-icon-box status-success">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <h3 class="fw-extrabold text-dark mb-2">Thanh toán thành công!</h3>
                    <p class="text-muted small">Cảm ơn bạn. Đơn hàng của bạn đang được quán chuẩn bị.</p>

                    <div class="receipt-box">
                        <div class="info-row">
                            <span class="text-muted">Mã giao dịch</span>
                            <span class="fw-bold text-dark">VNQ-982731</span> 
                        </div>
                        <div class="info-row">
                            <span class="text-muted">Mã đơn hàng</span>
                            <span class="fw-bold text-dark">#ORD-1082</span>
                        </div>
                        <div class="info-row">
                            <span class="text-muted">Phương thức</span>
                            <span class="fw-bold text-dark">Chuyển khoản VietQR</span>
                        </div>
                        <div class="info-row">
                            <span class="text-muted">Thời gian</span>
                            <span class="fw-bold text-dark">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="info-row align-items-center mt-2 pt-2 border-top">
                            <span class="fw-bold text-dark">Số tiền</span>
                            <span class="fw-extrabold fs-5 text-success">153.000 đ</span>
                        </div>
                    </div>

                    <a href="~/Order/Tracking" class="btn btn-main d-block text-decoration-none">
                        Theo dõi đơn hàng
                    </a>
                    <a href="~/Menu/Index" class="btn btn-sub d-block text-decoration-none">
                        Quay về thực đơn
                    </a>
                }
                else
                {
                    <!-- GIAO DIỆN THẤT BẠI -->
                    <div class="status-icon-box status-failed">
                        <i class="fa-solid fa-xmark"></i>
                    </div>
                    <h3 class="fw-extrabold text-dark mb-2">Thanh toán thất bại!</h3>
                    <p class="text-muted small">Đã có lỗi xảy ra trong quá trình giao dịch hoặc bạn đã hủy thanh toán.</p>

                    <div class="receipt-box text-center py-4">
                        <i class="fa-solid fa-triangle-exclamation fs-1 text-warning mb-3"></i>
                        <h6 class="fw-bold text-dark m-0">Đơn hàng #ORD-1082 chưa được ghi nhận.</h6>
                        <p class="text-muted small mt-1 mb-0">Tài khoản của bạn chưa bị trừ tiền.</p>
                    </div>

                    <a href="~/Payment/Index" class="btn btn-main d-block text-decoration-none text-white">
                        Thử thanh toán lại
                    </a>
                    <a href="~/Order/Checkout" class="btn btn-sub d-block text-decoration-none">
                        Đổi phương thức thanh toán
                    </a>
                }

            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>