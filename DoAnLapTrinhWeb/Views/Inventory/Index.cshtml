@{
    ViewBag.Title = "Lập Phiếu Nhập Kho";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LumiTea ERP - Lập Phiếu Nhập Kho</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Css/StyleInventory_Index.css" />
</head>
<body>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="container-fluid px-3 px-md-4 mt-4">

        <!-- PAGE HEADER -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <a href="@Url.Action("LichSuNhap", "Inventory")" class="text-decoration-none text-muted small hover-green">
                        <i class="bi bi-arrow-left"></i> Về lịch sử nhập kho
                    </a>
                    <span class="badge badge-draft rounded-pill px-2.5 py-1 fs-12">
                        <i class="bi bi-pencil-fill me-1"></i> Phiếu Nháp
                    </span>
                </div>
                <h2 class="h4 mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                    Lập Phiếu Nhập Kho Nguyên Liệu
                </h2>
            </div>

            <!-- Action buttons header -->
            <div class="d-flex align-items-center gap-2">
                <button type="button" onclick="confirmSubmit()" class="btn btn-lumitea btn-sm px-3 shadow-sm">
                    <i class="bi bi-check2-circle me-1"></i> Tạo Phiếu Chờ Nhập
                </button>
            </div>
        </div>

        <form id="stockImportForm">
            <div class="row g-4">

                <!-- GENERAL INFORMATION CARD -->
                <div class="col-12">
                    <div class="lumitea-card">
                        <div class="lumitea-card-header d-flex justify-content-between align-items-center">
                            <h5 class="h6 mb-0 fw-bold text-dark">
                                <i class="bi bi-info-circle-fill me-2 text-success"></i> 1. Thông Tin Chung
                            </h5>
                            <span class="text-muted small">* Trường bắt buộc nhập</span>
                        </div>
                        <div class="card-body p-3 p-md-4">
                            <div class="row g-3">

                                <!-- Mã phiếu -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">Mã Phiếu Nhập *</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-hash"></i></span>
                                        <input type="text" id="importCode" class="form-control fw-semibold text-success" value="@ViewBag.NewPoId" readonly>
                                    </div>
                                </div>

                                <!-- Nhà cung cấp -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">Nhà Cung Cấp *</label>
                                    <select id="supplierSelect" class="form-select form-select-sm" required>
                                        <option value="" disabled selected>-- Chọn Nhà Cung Cấp --</option>
                                        @if (ViewBag.Suppliers != null)
                                        {
                                            foreach (var s in ViewBag.Suppliers)
                                            {
                                                <option value="@s.supplier_id.Trim()">@s.supplier_name</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <!-- Ngày & Giờ nhập -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">Ngày & Giờ Nhập *</label>
                                    <input type="datetime-local" id="importDateTime" class="form-control form-control-sm" required>
                                </div>

                                <!-- Kho nhập -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">Kho Nhập *</label>
                                    <select id="warehouseSelect" class="form-select form-select-sm" required>
                                        <option value="Kho Chính Q1" selected>Kho Chính - Trụ sở Quận 1</option>
                                        <option value="Kho Topping & Bột">Kho Topping & Bột Nguyên Liệu</option>
                                        <option value="Kho Lạnh Bảo Quản">Kho Lạnh (Sữa tươi & Cream)</option>
                                        <option value="Kho Bao Bì">Kho Bao Bì & Muỗng Ly</option>
                                    </select>
                                </div>

                                <!-- Người thực hiện -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">Người Thực Hiện</label>
                                    <input type="text" class="form-control form-control-sm bg-light" value="@(Session["FullName"] ?? "Nguyễn Tấn Kỳ")" readonly>
                                </div>

                                <!-- Lý do nhập -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">Lý Do Nhập *</label>
                                    <select id="reasonSelect" class="form-select form-select-sm">
                                        <option value="Nhập mua hàng định kỳ" selected>Nhập mua hàng định kỳ</option>
                                        <option value="Nhập bổ sung gấp (Chạy Event)">Nhập bổ sung gấp (Chạy Event)</option>
                                        <option value="Nhập điều chuyển nội bộ">Nhập điều chuyển nội bộ</option>
                                        <option value="Khác">Khác...</option>
                                    </select>
                                </div>

                                <!-- Số hóa đơn chứng từ kèm -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">Số Hóa Đơn / Chứng Từ Kèm</label>
                                    <input type="text" id="invoiceDocNo" class="form-control form-control-sm" placeholder="VD: HD-PL-88912">
                                </div>

                                <!-- Ghi chú -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label">Ghi Chú Đơn Hàng</label>
                                    <input type="text" id="importNotes" class="form-control form-control-sm" placeholder="Ghi chú điều kiện giao hàng, bảo quản...">
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- DETAILED ITEMS TABLE CARD (Giữ nguyên giao diện gốc) -->
                <div class="col-12">
                    <div class="lumitea-card">
                        <div class="lumitea-card-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                            <div>
                                <h5 class="h6 mb-0 fw-bold text-dark">
                                    <i class="bi bi-box-seam-fill me-2 text-success"></i> 2. Danh Sách Nguyên Liệu Nhập Kho
                                </h5>
                                <span class="text-muted small">Hệ thống tự nạp mặt hàng theo Nhà cung cấp được chọn. Bạn kiểm tra và nhập số lượng thực tế.</span>
                            </div>
                            <button type="button" onclick="addNewManualRow()" class="btn btn-outline-lumitea btn-sm px-3">
                                <i class="bi bi-plus-circle-fill me-1"></i>Thêm Mặt Hàng Khác
                            </button>
                        </div>

                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-custom align-middle" id="itemsTable">
                                    <thead>
                                        <tr>
                                            <th style="width: 40px;" class="text-center">#</th>
                                            <th style="min-width: 220px;">Tên Nguyên Liệu / Mã NL</th>
                                            <th style="width: 100px;" class="text-center">ĐVT</th>
                                            <th style="width: 120px;" class="text-end">SL Nhập</th>
                                            <th style="width: 140px;" class="text-end">Đơn Giá (VNĐ)</th>
                                            <th style="width: 140px;">Mã Lô Hàng</th>
                                            <th style="width: 140px;">Hạn Sử Dụng</th>
                                            <th style="width: 150px;" class="text-end">Thành Tiền (VNĐ)</th>
                                            <th style="width: 50px;" class="text-center"><i class="bi bi-gear-fill"></i></th>
                                        </tr>
                                    </thead>
                                    <tbody id="itemsTableBody">
                                        <tr>
                                            <td colspan="9" class="text-center py-4 text-muted">
                                                <i class="bi bi-arrow-up-circle me-1 text-success"></i> Vui lòng chọn <b>Nhà Cung Cấp</b> ở trên để nạp danh sách nguyên liệu.
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <button type="button" onclick="addNewManualRow()" class="btn btn-sm btn-link text-success text-decoration-none fw-semibold">
                                <i class="bi bi-plus-circle"></i> + Thêm nguyên liệu ngoài danh mục
                            </button>
                            <span class="text-muted small">
                                <i class="bi bi-info-circle me-1"></i> Nhấn biểu tượng <i class="bi bi-trash text-danger"></i> để bỏ mặt hàng nếu đợt này NCC không giao.
                            </span>
                        </div>
                    </div>
                </div>

                <!-- COST BREAKDOWN & ADJUSTMENTS -->
                <div class="col-12 col-lg-7">
                    <div class="lumitea-card h-100">
                        <div class="lumitea-card-header">
                            <h5 class="h6 mb-0 fw-bold text-dark">
                                <i class="bi bi-card-text me-2 text-success"></i> Điều Khoản Thanh Toán & Ghi Chú Kho
                            </h5>
                        </div>
                        <div class="card-body p-3 p-md-4">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Hình thức thanh toán</label>
                                    <select class="form-select form-select-sm" id="paymentMethod">
                                        <option value="Chuyển khoản ngân hàng (Công nợ)" selected>Chuyển khoản (Công nợ 30 ngày)</option>
                                        <option value="Tiền mặt trực tiếp">Tiền mặt trực tiếp khi nhận hàng</option>
                                        <option value="Đã thanh toán trước">Đã thanh toán trước (Tiền tạm ứng)</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Trạng thái kiểm định chất lượng</label>
                                    <select class="form-select form-select-sm" id="qualityStatus">
                                        <option value="Đạt 100% chất lượng" selected>🟢 Đạt 100% chất lượng & Đóng gói</option>
                                        <option value="Đang chờ kiểm mẫu">🟡 Đang chờ kiểm mẫu phòng Lab</option>
                                        <option value="Nhập kho có điều kiện">🟠 Nhập kho có điều kiện (Theo dõi)</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Hướng dẫn bảo quản đặc biệt</label>
                                    <textarea class="form-control form-control-sm" rows="2" placeholder="Ví dụ: Sữa tươi bảo quản 2-4 độ C. Trà đen cất nơi khô ráo thoáng mát..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SUMMARY BREAKDOWN CARD -->
                <div class="col-12 col-lg-5">
                    <div class="lumitea-card">
                        <div class="lumitea-card-header bg-light">
                            <h5 class="h6 mb-0 fw-bold text-dark">
                                <i class="bi bi-calculator-fill me-2 text-success"></i> Tổng Chi Phí Phiếu Nhập
                            </h5>
                        </div>
                        <div class="card-body p-3 p-md-4 space-y-2">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Tổng số mặt hàng:</span>
                                <span class="fw-bold" id="summaryTotalItemsCount">0 loại</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Tổng tiền hàng (Chưa thuế):</span>
                                <span class="fw-semibold" id="summarySubtotal">0 đ</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="text-muted small">Chiết khấu / Giảm giá:</span>
                                </div>
                                <div class="input-group input-group-sm w-50">
                                    <input type="number" id="discountInput" class="form-control text-end" value="0" min="0" oninput="calculateTotals()">
                                    <span class="input-group-text">đ</span>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="text-muted small">Chi phí vận chuyển:</span>
                                </div>
                                <div class="input-group input-group-sm w-50">
                                    <input type="number" id="shippingFeeInput" class="form-control text-end" value="0" min="0" oninput="calculateTotals()">
                                    <span class="input-group-text">đ</span>
                                </div>
                            </div>

                            <hr class="my-3">

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold text-dark d-block">TỔNG THANH TOÁN</span>
                                    <span class="text-muted fs-12">(Đã bao gồm chi phí phát sinh)</span>
                                </div>
                                <span class="total-amount-display" id="summaryFinalTotal">0 đ</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </main>

    <!-- STICKY BOTTOM SUMMARY -->
    <div class="sticky-summary-footer">
        <div class="container-fluid px-3 px-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div>
                        <span class="text-muted fs-12 d-block">TỔNG CỘNG PHIẾU NHẬP:</span>
                        <span class="total-amount-display" id="footerFinalTotal">0 đ</span>
                    </div>
                    <div class="vr d-none d-sm-block" style="height: 35px;"></div>
                    <div class="d-none d-sm-block">
                        <span class="text-muted fs-12 d-block">Mặt hàng nhập:</span>
                        <span class="fw-bold text-dark" id="footerItemsCount">0 mặt hàng</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 w-100 w-md-auto justify-content-end">
                    <button type="button" onclick="confirmSubmit()" class="btn btn-lumitea btn-sm px-4 shadow-sm">
                        <i class="bi bi-box-arrow-in-down me-1"></i> Tạo Phiếu Chờ Nhập
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="liveToast" class="toast align-items-center text-white bg-dark border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2" id="toastMessage">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i> Đã cập nhật.
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- JS CDN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const allIngredients = [
            @if (ViewBag.Ingredients != null)
            {
                foreach (var ing in ViewBag.Ingredients)
                {
                    <text>{ code: '@ing.ingredient_id.Trim()', name: '@ing.name', unit: '@ing.unit' },</text>
                }
            }
        ];

        let rowCounter = 0;

        document.addEventListener('DOMContentLoaded', function () {
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('importDateTime').value = now.toISOString().slice(0, 16);
        });

        // Chọn NCC -> Tự nạp nguyên liệu của NCC
        $('#supplierSelect').on('change', function () {
            let supplierId = $(this).val();
            if (!supplierId) return;

            let supplierName = $('#supplierSelect option:selected').text();
            let tbody = $('#itemsTableBody');
            tbody.html('<tr><td colspan="9" class="text-center py-4 text-muted"><i class="bi bi-hourglass-split me-1"></i> Đang nạp danh mục hàng hóa của ' + supplierName + '...</td></tr>');

            $.getJSON('@Url.Action("GetIngredientsBySupplier", "Inventory")', { supplierId: supplierId }, function (res) {
                tbody.empty();
                rowCounter = 0;

                if (res.success && res.data.length > 0) {
                    res.data.forEach(item => {
                        rowCounter++;
                        let defaultQty = 1000;
                        let lineTotal = defaultQty * item.price;

                        let tr = `
                            <tr id="row-${rowCounter}" data-code="${item.code}">
                                <td class="text-center row-number">${rowCounter}</td>
                                <td>
                                    <strong>${item.name}</strong>
                                    <div class="small text-muted font-mono">Mã: ${item.code}</div>
                                    <input type="hidden" class="item-select" value="${item.code}">
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border font-mono item-unit">${item.unit}</span>
                                </td>
                                <td>
                                    <input type="number" step="1" min="1" class="form-control form-control-sm text-end fw-bold item-qty" value="${defaultQty}" oninput="calculateRow(${rowCounter})">
                                </td>
                                <td>
                                    <input type="number" step="100" min="0" class="form-control form-control-sm text-end item-price" value="${item.price}" oninput="calculateRow(${rowCounter})">
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm font-mono item-batch bg-light text-muted" value="Để trống (Nhập khi hàng về)" readonly>
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm item-expiry bg-light text-muted" value="Để trống (Nhập khi hàng về)" readonly>
                                </td>
                                <td class="text-end fw-bold text-success item-total">
                                    ${lineTotal.toLocaleString('vi-VN')} đ
                                </td>
                                <td class="text-center">
                                    <button type="button" onclick="removeRow(${rowCounter})" class="btn btn-sm btn-link text-danger p-0" title="Không nhập món này đợt này">
                                        <i class="bi bi-trash fs-6"></i>
                                    </button>
                                </td>
                            </tr>
                        `;
                        tbody.append(tr);
                    });

                    calculateTotals();
                    showToast("Đã nạp " + res.data.length + " mặt hàng của " + supplierName);
                } else {
                    tbody.html('<tr><td colspan="9" class="text-center py-4 text-muted">Nhà cung cấp này chưa có danh mục mặt hàng. Bấm "+ Thêm nguyên liệu ngoài danh mục" để chọn thủ công.</td></tr>');
                    calculateTotals();
                }
            });
        });

        // Thêm thủ công 1 dòng ngoài danh mục
        function addNewManualRow() {
            if (allIngredients.length === 0) {
                alert("Chưa có dữ liệu nguyên liệu nào trong kho!");
                return;
            }

            rowCounter++;
            const tbody = document.getElementById('itemsTableBody');

            if (tbody.children.length === 1 && tbody.children[0].children.length === 1) {
                tbody.innerHTML = '';
            }

            const tr = document.createElement('tr');
            tr.id = `row-${rowCounter}`;
            const first = allIngredients[0];

            tr.innerHTML = `
                <td class="text-center row-number">${tbody.children.length + 1}</td>
                <td>
                    <select class="form-select form-select-sm item-select" onchange="onManualIngredientChange(${rowCounter})">
                        ${allIngredients.map(i => `<option value="${i.code}">${i.code} -${i.name}</option>`).join('')}
                    </select>
                </td>
                <td class="text-center">
                    <span class="badge bg-light text-dark border font-mono item-unit">${first.unit}</span>
                </td>
                <td>
                    <input type="number" step="1" min="1" class="form-control form-control-sm text-end fw-bold item-qty" value="1000" oninput="calculateRow(${rowCounter})">
                </td>
                <td>
                    <input type="number" step="100" min="0" class="form-control form-control-sm text-end item-price" value="1000" oninput="calculateRow(${rowCounter})">
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm font-mono item-batch bg-light text-muted" value="Để trống (Nhập khi hàng về)" readonly>
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm item-expiry bg-light text-muted" value="Để trống (Nhập khi hàng về)" readonly>
                </td>
                <td class="text-end fw-bold text-success item-total">1.000.000 đ</td>
                <td class="text-center">
                    <button type="button" onclick="removeRow(${rowCounter})" class="btn btn-sm btn-link text-danger p-0">
                        <i class="bi bi-trash fs-6"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(tr);
            updateRowNumbers();
            calculateTotals();
        }

        function onManualIngredientChange(id) {
            let row = $(`#row-${id}`);
            let code = row.find('.item-select').val();
            let ing = allIngredients.find(i => i.code === code);
            if (ing) {
                row.find('.item-unit').text(ing.unit);
            }
            calculateRow(id);
        }

        function removeRow(id) {
            $(`#row-${id}`).remove();
            updateRowNumbers();
            calculateTotals();
        }

        function updateRowNumbers() {
            $('#itemsTableBody tr').each(function (idx) {
                $(this).find('.row-number').text(idx + 1);
            });
        }

        function calculateRow(id) {
            const row = document.getElementById(`row-${id}`);
            if (!row) return;
            const qty = parseFloat(row.querySelector('.item-qty').value) || 0;
            const price = parseFloat(row.querySelector('.item-price').value) || 0;
            const total = qty * price;

            row.querySelector('.item-total').textContent = total.toLocaleString('vi-VN') + ' đ';
            calculateTotals();
        }

        function calculateTotals() {
            let subtotal = 0;
            let count = 0;

            $('#itemsTableBody tr').each(function () {
                let qtyInput = $(this).find('.item-qty');
                if (qtyInput.length > 0) {
                    let qty = parseFloat(qtyInput.val()) || 0;
                    let price = parseFloat($(this).find('.item-price').val()) || 0;
                    subtotal += (qty * price);
                    count++;
                }
            });

            const discount = parseFloat(document.getElementById('discountInput').value) || 0;
            const shipping = parseFloat(document.getElementById('shippingFeeInput').value) || 0;
            const finalTotal = Math.max(0, subtotal - discount + shipping);

            document.getElementById('summaryTotalItemsCount').textContent = `${count} loại`;
            document.getElementById('summarySubtotal').textContent = subtotal.toLocaleString('vi-VN') + ' đ';
            document.getElementById('summaryFinalTotal').textContent = finalTotal.toLocaleString('vi-VN') + ' đ';

            document.getElementById('footerFinalTotal').textContent = finalTotal.toLocaleString('vi-VN') + ' đ';
            document.getElementById('footerItemsCount').textContent = `${count} mặt hàng`;
        }

        // Nút Tạo Phiếu Chờ Nhập -> Trạng thái Pending
        function confirmSubmit() {
            let supplier = $('#supplierSelect').val();
            if (!supplier) {
                alert("Vui lòng chọn Nhà cung cấp!");
                return;
            }

            let items = [];
            $('#itemsTableBody tr').each(function () {
                let code = $(this).find('.item-select').val();
                let qty = parseFloat($(this).find('.item-qty').val()) || 0;
                let price = parseFloat($(this).find('.item-price').val()) || 0;

                if (code && qty > 0) {
                    items.push({
                        ingredient_id: code,
                        quantity: qty,
                        unit_price: price
                    });
                }
            });

            if (items.length === 0) {
                alert("Vui lòng nhập ít nhất 1 dòng nguyên liệu hợp lệ!");
                return;
            }

            let discount = parseFloat($('#discountInput').val()) || 0;
            let shipping = parseFloat($('#shippingFeeInput').val()) || 0;

            $.ajax({
                url: '@Url.Action("SavePurchaseOrder", "Inventory")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    supplierId: supplier,
                    status: 'Pending',
                    discount: discount,
                    shippingFee: shipping,
                    items: items
                }),
                success: function (res) {
                    if (res.success) {
                        alert(res.message);
                        window.location.href = '@Url.Action("LichSuNhap", "Inventory")';
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert("Lỗi kết nối máy chủ khi lưu phiếu nhập.");
                }
            });
        }

        function showToast(message) {
            const toastEl = document.getElementById('liveToast');
            document.getElementById('toastMessage').innerHTML = `<i class="bi bi-check-circle-fill text-success fs-5"></i> ${message}`;
            const toast = new bootstrap.Toast(toastEl, { delay: 2500 });
            toast.show();
        }
    </script>
</body>
</html>