@model IEnumerable<DoAnLapTrinhWeb.Models.PurchaseOrder>

@{
    ViewBag.Title = "Lịch Sử Nhập Kho";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LumiTea - Lịch Sử Nhập Kho</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Css/StyleInventory_LichSuNhap.css" />
</head>
<body>

    <div class="container-fluid px-4 mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-1 text-success">Lịch Sử Nhập Kho</h4>
                <p class="text-muted small mb-0">Quản lý và tra cứu các phiếu nhập nguyên liệu vào kho LumiTea</p>
            </div>
            <a href="@Url.Action("Index", "Inventory")" class="btn btn-success px-3">
                <i class="fa-solid fa-plus me-2"></i>Tạo Phiếu Nhập Mới
            </a>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã Phiếu</th>
                            <th>Ngày Nhập</th>
                            <th>Nhà Cung Cấp</th>
                            <th>Số Mặt Hàng</th>
                            <th>Tổng Tiền (VNĐ)</th>
                            <th>Người Lập</th>
                            <th>Trạng Thái</th>
                            <th class="text-end">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var isPending = item.status == "Pending";
                                var isCompleted = item.status == "Completed";

                                <tr>
                                    <td><strong class="text-primary">@item.po_id.Trim()</strong></td>
                                    <td>@item.created_at.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(item.Supplier != null ? item.Supplier.supplier_name : "N/A")</td>
                                    <td>@(item.PurchaseOrderDetails != null ? item.PurchaseOrderDetails.Count : 0) mặt hàng</td>
                                    <td class="fw-bold">@item.total_amount.ToString("N0") đ</td>
                                    <td>@(item.User != null ? item.User.full_name : "Thủ kho")</td>
                                    <td>
                                        @if (isPending)
                                        {
                                            <span class="badge bg-warning text-dark">Chờ nhập kho</span>
                                        }
                                        else if (isCompleted)
                                        {
                                            <span class="badge bg-success">Đã hoàn tất</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Đã hủy</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (isPending)
                                        {
                                            <button class="btn btn-sm btn-success me-1" onclick="viewReceipt('@item.po_id.Trim()', 'Pending')" title="Kiểm đếm & Xác nhận hàng về">
                                                <i class="fa-solid fa-check"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger me-1" onclick="cancelReceipt('@item.po_id.Trim()')" title="Hủy phiếu">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-outline-primary" onclick="viewReceipt('@item.po_id.Trim()', '@item.status')" title="Xem chi tiết">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Chưa có phiếu nhập kho nào trong hệ thống.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Kiểm Đếm & Nhập Mã Lô, HSD -->
    <div class="modal fade" id="receiptDetailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalHeaderTitle">Kiểm Đếm & Xác Nhận Hàng Về Kho</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row mb-3 small">
                        <div class="col-6"><strong>Mã Phiếu:</strong> <span id="receiptCode" class="text-primary fw-bold"></span></div>
                        <div class="col-6 text-end"><strong>Nhà Cung Cấp:</strong> <span id="receiptSupplier"></span></div>
                    </div>

                    <table class="table table-bordered align-middle small mb-3">
                        <thead class="table-light">
                            <tr>
                                <th>STT</th>
                                <th>Tên Nguyên Liệu</th>
                                <th>ĐVT</th>
                                <th class="text-end">Số Lượng</th>
                                <th class="text-end">Đơn Giá (đ)</th>
                                <th style="width: 180px;">Mã Lô (Batch) *</th>
                                <th style="width: 180px;">Hạn Sử Dụng *</th>
                            </tr>
                        </thead>
                        <tbody id="confirmItemsBody">
                        </tbody>
                    </table>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-success fw-bold px-4" id="btnModalConfirm" onclick="confirmImportFromModal()">
                        <i class="fa-solid fa-box-archive me-2"></i> Xác Nhận Hàng Về (Cộng Kho)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentViewingPoId = '';

        function viewReceipt(code, status) {
            currentViewingPoId = code;
            $.getJSON('@Url.Action("GetPurchaseOrderDetail", "Inventory")', { poId: code }, function (res) {
                if (!res.success) { alert(res.message); return; }

                let po = res.data;
                $('#receiptCode').text(po.po_id);
                $('#receiptSupplier').text(po.supplier_name);

                let tbody = $('#confirmItemsBody');
                tbody.empty();

                po.items.forEach(itm => {
                    let batchHtml = (status === 'Pending')
                        ? `<input type="text" class="form-control form-control-sm input-batch" data-podid="${itm.pod_id}" placeholder="Nhập mã lô..." required>`
                        : (itm.batch_no || '---');

                    let expiryHtml = (status === 'Pending')
                        ? `<input type="date" class="form-control form-control-sm input-expiry" data-podid="${itm.pod_id}" required>`
                        : (itm.expiry_date || '---');

                    tbody.append(`
                        <tr data-podid="${itm.pod_id}">
                            <td>${itm.stt}</td>
                            <td><strong>${itm.ingredient_name}</strong> (${itm.ingredient_id})</td>
                            <td>${itm.unit}</td>
                            <td class="text-end fw-bold">${itm.quantity.toLocaleString('vi-VN')}</td>
                            <td class="text-end">${itm.unit_price.toLocaleString('vi-VN')}</td>
                            <td>${batchHtml}</td>
                            <td>${expiryHtml}</td>
                        </tr>
                    `);
                });

                if (status === 'Pending') {
                    $('#btnModalConfirm').show();
                    $('#modalHeaderTitle').text('Kiểm Đếm & Xác Nhận Hàng Về (Nhập Mã Lô & HSD)');
                } else {
                    $('#btnModalConfirm').hide();
                    $('#modalHeaderTitle').text('Chi Tiết Phiếu Nhập Kho (Đã Hoàn Tất)');
                }

                new bootstrap.Modal(document.getElementById('receiptDetailModal')).show();
            });
        }

        function confirmImportFromModal() {
            if (!currentViewingPoId) return;

            let items = [];
            let isValid = true;

            $('#confirmItemsBody tr').each(function () {
                let podId = $(this).data('podid');
                let batch = $(this).find('.input-batch').val();
                let expiry = $(this).find('.input-expiry').val();

                if (!batch || !expiry) {
                    isValid = false;
                }

                items.push({
                    pod_id: podId,
                    batch_no: batch,
                    expiry_date: expiry
                });
            });

            if (!isValid) {
                alert("Vui lòng điền đầy đủ Mã Lô và Hạn Sử Dụng cho tất cả mặt hàng trước khi xác nhận!");
                return;
            }

            if (!confirm("Xác nhận hàng đã về kho và cộng dồn số lượng tồn thực tế?")) return;

            $.ajax({
                url: '@Url.Action("ConfirmImportWithBatch", "Inventory")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ poId: currentViewingPoId, items: items }),
                success: function (res) {
                    if (res.success) {
                        alert(res.message);
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert("Lỗi kết nối máy chủ.");
                }
            });
        }

        function cancelReceipt(code) {
            if (!confirm("Bạn có chắc muốn HỦY phiếu nhập " + code + "?")) return;
            $.post('@Url.Action("CancelPurchaseOrder", "Inventory")', { poId: code }, function (res) {
                if (res.success) { alert(res.message); location.reload(); }
                else { alert(res.message); }
            });
        }
    </script>
</body>
</html>