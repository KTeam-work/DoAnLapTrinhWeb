<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LumiTea - Lịch Sử Nhập Kho</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet"  href="~/Css/StyleInventory_LichSuNhap.css"/>
</head>
<body>

    <!-- Main Content -->
    <div class="main-content mt-4">
        <!-- Top Header -->
        <div class="page-header">
            <div>
                <h4 class="fw-bold mb-1" style="color: var(--brand-primary);">Lịch Sử Nhập Kho</h4>
                <p class="text-muted small mb-0">Quản lý và tra cứu các phiếu nhập nguyên liệu vào kho LumiTea</p>
            </div>
            <a href="#" class="btn btn-brand px-3">
                <i class="fa-solid fa-plus me-2"></i>Tạo Phiếu Nhập Mới
            </a>
        </div>

        <!-- Metric Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fa-solid fa-receipt"></i></div>
                    <div>
                        <div class="text-muted small">Tổng số phiếu nhập</div>
                        <div class="fs-4 fw-bold">128 Phiếu</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fa-solid fa-sack-dollar"></i></div>
                    <div>
                        <div class="text-muted small">Tổng chi phí nhập (Tháng này)</div>
                        <div class="fs-4 fw-bold text-success">145.850.000 đ</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fa-solid fa-truck-ramp-box"></i></div>
                    <div>
                        <div class="text-muted small">Nhà cung cấp đã nhập</div>
                        <div class="fs-4 fw-bold">12 Đơn vị</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter & Search Section -->
        <div class="card-custom p-3 mb-4">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Tìm kiếm theo mã phiếu, NCC, người lập...">
                    </div>
                </div>
                <div class="col-md-3">
                    <input type="date" class="form-control" id="filterDate">
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="filterStatus">
                        <option value="all">Tất cả trạng thái</option>
                        <option value="draft">Chờ nhập kho (Nháp)</option>
                        <option value="completed">Đã hoàn tất</option>
                        <option value="cancelled">Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button class="btn btn-outline-secondary w-100" onclick="resetFilter()">
                        <i class="fa-solid fa-rotate-left me-1"></i>Đặt lại
                    </button>
                </div>
            </div>
        </div>

        <!-- History Table -->
        <div class="card-custom">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mã Phiếu</th>
                            <th>Ngày Nhập</th>
                            <th>Nhà Cung Cấp</th>
                            <th>Số Mặt Hàng</th>
                            <th>Tổng Tiền (VNĐ)</th>
                            <th>Người Lập</th>
                            <th>Trạng Thái</th>
                            <th class="text-end">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody">
                        <!-- Mẫu 1: Phiếu Nháp (Có nút Nhập Kho và Nút Hủy) -->
                        <tr data-status="draft">
                            <td><strong class="text-primary">NK20261025-001</strong></td>
                            <td>25/10/2026 08:30</td>
                            <td>Công Ty Trà Việt</td>
                            <td>4 mặt hàng</td>
                            <td class="fw-bold">15.000.000 đ</td>
                            <td>Nguyễn Văn Tuấn</td>
                            <td><span class="badge-draft">Chờ nhập kho</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-success me-1" onclick="confirmImport('NK20261025-001')" title="Xác nhận nhập kho">
                                    <i class="fa-solid fa-check"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger me-1" onclick="cancelReceipt('NK20261025-001')" title="Hủy phiếu">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-primary" onclick="viewReceipt('NK20261025-001', 'draft')" title="Xem chi tiết">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </td>
                        </tr>
                        <!-- Mẫu 2: Đã hoàn tất -->
                        <tr data-status="completed">
                            <td><strong class="text-primary">NK20261024-001</strong></td>
                            <td>24/10/2026 14:32</td>
                            <td>Phúc Long Tea Co.</td>
                            <td>3 mặt hàng</td>
                            <td class="fw-bold">20.000.000 đ</td>
                            <td>Nguyễn Văn Tuấn</td>
                            <td><span class="badge-completed">Đã hoàn tất</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary" onclick="viewReceipt('NK20261024-001', 'completed')" title="Xem chi tiết">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </td>
                        </tr>
                        <!-- Mẫu 3: Đã hủy -->
                        <tr data-status="cancelled">
                            <td><strong class="text-primary">NK20261022-003</strong></td>
                            <td>22/10/2026 11:00</td>
                            <td>Lipton VN</td>
                            <td>1 mặt hàng</td>
                            <td class="fw-bold">5.000.000 đ</td>
                            <td>Trần Thị Mai</td>
                            <td><span class="badge-cancelled">Đã hủy</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary" onclick="viewReceipt('NK20261022-003', 'cancelled')" title="Xem chi tiết">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination Footer -->
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted">Hiển thị 1 - 3 trong tổng số 128 phiếu nhập</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
                        <li class="page-item active"><a class="page-link" href="#" style="background-color: var(--brand-primary); border-color: var(--brand-primary);">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item"><a class="page-link" href="#">Sau</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- Modal Chi Tiết / In Phiếu Nhập -->
    <div class="modal fade" id="receiptDetailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalTitle">Chi Tiết Phiếu Nhập Kho</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4" id="printableReceipt">
                    <!-- Receipt Header Info -->
                    <div class="d-flex justify-content-between align-items-start pb-3 border-bottom mb-3">
                        <div>
                            <h4 class="fw-bold mb-1" style="color: var(--brand-primary);">LUMI TEA KITCHEN & ERP</h4>
                            <p class="small text-muted mb-0">Địa chỉ: Chi nhánh Quận 1, TP. Hồ Chí Minh</p>
                            <p class="small text-muted mb-0">Điện thoại: (028) 3822 9999</p>
                        </div>
                        <div class="text-end">
                            <h5 class="fw-bold text-uppercase text-dark mb-1">PHIẾU NHẬP KHO</h5>
                            <div class="badge bg-light text-dark border" id="receiptCode">NK20261024-001</div>
                            <div class="small text-muted mt-1" id="receiptDate">Ngày nhập: 24/10/2026 14:32</div>
                        </div>
                    </div>

                    <!-- Supplier & Staff Info -->
                    <div class="row mb-4 small">
                        <div class="col-6">
                            <div class="p-2 rounded bg-light">
                                <strong>Nhà cung cấp:</strong> <span id="receiptSupplier">Phúc Long Tea Co.</span><br>
                                <strong>Ghi chú:</strong> <span id="receiptNote">Nhập lô trà mùa thu đợt 2</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded bg-light">
                                <strong>Người lập phiếu:</strong> <span id="receiptStaff">Nguyễn Văn Tuấn</span><br>
                                <strong>Trạng thái:</strong> <span id="receiptStatusText" class="fw-bold">Đã nhập kho</span>
                            </div>
                        </div>
                    </div>

                    <!-- Items Detail Table -->
                    <table class="table table-bordered align-middle small mb-3">
                        <thead class="table-light">
                            <tr>
                                <th>STT</th>
                                <th>Mã / Tên Nguyên Liệu</th>
                                <th>ĐVT</th>
                                <th class="text-end">Số Lượng</th>
                                <th class="text-end">Đơn Giá (đ)</th>
                                <th class="text-end">Thành Tiền (đ)</th>
                            </tr>
                        </thead>
                        <tbody id="receiptItemsBody">
                            <tr>
                                <td>1</td>
                                <td><strong>Trà Đen Ceylon Thượng Hạng</strong><br><small class="text-muted">Lô: BATCH-202610-01 | HSD: 24/10/2027</small></td>
                                <td>Gam (g)</td>
                                <td class="text-end">20.000</td>
                                <td class="text-end">700</td>
                                <td class="text-end fw-bold">14.000.000</td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td><strong>Trân Châu Đen Hoàng Kim</strong><br><small class="text-muted">Lô: BATCH-202610-02 | HSD: 24/04/2027</small></td>
                                <td>Gam (g)</td>
                                <td class="text-end">10.000</td>
                                <td class="text-end">600</td>
                                <td class="text-end fw-bold">6.000.000</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" class="text-end fw-bold">Tổng Cộng:</td>
                                <td class="text-end fw-bold fs-6 text-success" id="receiptTotal">20.000.000 đ</td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Signature Area -->
                    <div class="row text-center mt-4 pt-2 small">
                        <div class="col-4">
                            <strong>Người Lập Phiếu</strong>
                            <div style="height: 50px;"></div>
                            <span class="text-muted">Nguyễn Văn Tuấn</span>
                        </div>
                        <div class="col-4">
                            <strong>Thủ Kho</strong>
                            <div style="height: 50px;"></div>
                            <span class="text-muted">(Ký & ghi rõ họ tên)</span>
                        </div>
                        <div class="col-4">
                            <strong>Nhà Cung Cấp</strong>
                            <div style="height: 50px;"></div>
                            <span class="text-muted">(Ký & ghi rõ họ tên)</span>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer Controls -->
                <div class="modal-footer no-print">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <!-- Nút Hủy và Xác nhận hiện linh hoạt trong modal nếu phiếu đang là DRAFT -->
                    <button type="button" class="btn btn-outline-danger fw-bold" id="btnModalCancel" style="display: none;" onclick="cancelReceiptFromModal()">
                        <i class="fa-solid fa-xmark me-1"></i> Hủy Phiếu
                    </button>
                    <button type="button" class="btn btn-success fw-bold" id="btnModalConfirm" style="display: none;" onclick="confirmImportFromModal()">
                        <i class="fa-solid fa-box-archive me-2"></i> Xác Nhận Nhập Kho
                    </button>
                    <button type="button" class="btn btn-brand" onclick="window.print()">
                        <i class="fa-solid fa-print me-2"></i>In Phiếu
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let currentViewingCode = '';
        let currentViewingStatus = '';

        // Mở Modal xem chi tiết phiếu
        function viewReceipt(code, status) {
            currentViewingCode = code;
            currentViewingStatus = status;
            var modal = new bootstrap.Modal(document.getElementById('receiptDetailModal'));
            document.getElementById('receiptCode').innerText = code;

            const btnModalConfirm = document.getElementById('btnModalConfirm');
            const btnModalCancel = document.getElementById('btnModalCancel');
            const statusText = document.getElementById('receiptStatusText');

            if (status === 'draft') {
                statusText.innerText = "Chờ nhập kho";
                statusText.className = "fw-bold text-warning";
                btnModalConfirm.style.display = 'block';
                btnModalCancel.style.display = 'block';
            } else if (status === 'completed') {
                statusText.innerText = "Đã hoàn tất";
                statusText.className = "fw-bold text-success";
                btnModalConfirm.style.display = 'none';
                btnModalCancel.style.display = 'none';
            } else {
                statusText.innerText = "Đã hủy";
                statusText.className = "fw-bold text-danger";
                btnModalConfirm.style.display = 'none';
                btnModalCancel.style.display = 'none';
            }

            modal.show();
        }

        // Xử lý xác nhận nhập kho
        function confirmImport(code) {
            if (confirm("Xác nhận hàng đã về đủ cho phiếu " + code + "? Hệ thống sẽ tiến hành cộng dồn số lượng vào kho.")) {
                // TODO: Gửi request cập nhật TrangThai = 'COMPLETED' và cộng kho lên Backend
                alert("Đã xác nhận thành công! Kho đã được cập nhật.");
                location.reload();
            }
        }

        // Xử lý Hủy phiếu nhập (Chỉ áp dụng khi phiếu còn DRAFT)
        function cancelReceipt(code) {
            if (confirm("Bạn có chắc chắn muốn HỦY phiếu nhập " + code + " này không? Hành động này không thể hoàn tác.")) {
                // TODO: Gửi request cập nhật TrangThai = 'CANCELLED' lên Backend (Không cộng kho)
                alert("Đã hủy phiếu nhập thành công.");
                location.reload();
            }
        }

        // Gọi từ trong Modal
        function confirmImportFromModal() {
            if (currentViewingCode) {
                confirmImport(currentViewingCode);
            }
        }

        function cancelReceiptFromModal() {
            if (currentViewingCode) {
                cancelReceipt(currentViewingCode);
            }
        }

        // Đặt lại bộ lọc
        function resetFilter() {
            document.getElementById('searchInput').value = '';
            document.getElementById('filterDate').value = '';
            document.getElementById('filterStatus').value = 'all';
        }
    </script>
</body>
</html>