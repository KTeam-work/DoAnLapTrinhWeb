@model IEnumerable<DoAnLapTrinhWeb.Models.Ingredient>

@{
    ViewBag.Title = "Danh Mục Nguyên Liệu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LumiTea - Quản Lý Danh Mục Nguyên Liệu & Lô Hàng</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Css/StyleIngredient.css?v=1.0" rel="stylesheet" />
</head>
<body>

    <main class="container-fluid px-4 py-4">

        <!-- BREADCRUMB & HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small text-muted">
                        <li class="breadcrumb-item">Vận hành Kho</li>
                        <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Danh mục Nguyên liệu</li>
                    </ol>
                </nav>
                <h3 class="fw-bold mb-0 text-lumitea">
                    <i class="bi bi-boxes me-2"></i>Quản Lý Danh Mục Nguyên Liệu
                </h3>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm fw-semibold bg-white">
                    <i class="bi bi-arrow-repeat me-1"></i> Đồng bộ POS
                </button>
                <button class="btn btn-outline-secondary btn-sm fw-semibold bg-white" onclick="alert('Mở màn hình Nhập/Xuất kho')">
                    <i class="bi bi-download me-1"></i> Nhập/Xuất kho
                </button>
                <a href="@Url.Action("Create")" class="btn btn-primary btn-sm fw-semibold px-3 text-white">
                    <i class="bi bi-plus-lg me-1"></i> Thêm nguyên liệu
                </a>
            </div>
        </div>

        <!-- STATS CARDS (ĐÃ ĐƯỢC ĐƯA TRỞ LẠI) -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card-custom p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="small fw-bold text-muted text-uppercase mb-1">Nguyên Liệu Hoạt Động</div>
                            <div class="h3 fw-bold mb-0">48 <span class="fs-6 text-muted fw-normal">/ 51 SKU</span></div>
                            <div class="small text-success mt-2"><i class="bi bi-check-circle me-1"></i>94.1% khả dụng chuẩn</div>
                        </div>
                        <div class="icon-box bg-light text-dark p-2 rounded-2">
                            <i class="bi bi-box-seam fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card-custom p-3 h-100 border-danger-subtle">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="small fw-bold text-danger text-uppercase mb-1">Sắp Hết Tồn / Cần Nhập</div>
                            <div class="h3 fw-bold mb-0 text-danger">05 <span class="fs-6 text-muted fw-normal">loại chạm ngưỡng</span></div>
                            <div class="small text-muted mt-2">Ưu tiên: Trà Đen, Bột Sữa...</div>
                        </div>
                        <div class="icon-box bg-danger-subtle text-danger p-2 rounded-2">
                            <i class="bi bi-exclamation-triangle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card-custom p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="small fw-bold text-muted text-uppercase mb-1">Tổng Giá Trị Tồn Kho</div>
                            <div class="h3 fw-bold mb-0">42,850,000 <span class="fs-6 fw-normal">đ</span></div>
                            <div class="small text-muted mt-2">Chi phí vốn hàng tồn (COGS)</div>
                        </div>
                        <div class="icon-box bg-primary-subtle text-primary p-2 rounded-2">
                            <i class="bi bi-currency-dollar fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card-custom p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="small fw-bold text-muted text-uppercase mb-1">Tạm Ngừng Sử Dụng</div>
                            <div class="h3 fw-bold mb-0">03 <span class="fs-6 text-muted fw-normal">loại lưu kho</span></div>
                            <div class="small text-muted mt-2">Hứa vụ cũ & bao bì ngừng dùng</div>
                        </div>
                        <div class="icon-box bg-light text-muted p-2 rounded-2">
                            <i class="bi bi-slash-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- BẢNG FILTER & TÌM KIẾM -->
        <div class="card-custom p-3 mb-4">
            @using (Html.BeginForm("Index", "Ingredient", FormMethod.Get))
            {
                <div class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <!-- Thuộc tính name="searchString" phải trùng tên với tham số ở Controller -->
                            <input type="text" id="searchInput" name="searchString" value="@Request.QueryString["searchString"]" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo mã hoặc tên nguyên liệu...">
                        </div>
                    </div>
                
                </div>
            }
        </div>

        <!-- BẢNG DANH SÁCH NGUYÊN LIỆU (RENDER TRỰC TIẾP TỪ DATABASE MODEL) -->
        <div class="card-custom overflow-hidden mb-4 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40px;" class="ps-3"><input type="checkbox" class="form-check-input"></th>
                            <th>MÃ NL</th>
                            <th>TÊN NGUYÊN LIỆU</th>
                            <th>ĐVT</th>
                            <th>TỔNG TỒN KHO HIỆN TẠI</th>
                            <th>ĐỊNH MỨC TỐI THIỂU</th>
                            <th class="text-center" style="width: 80px;">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody id="ingredientTableBody">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var isLow = item.quantity_in_stock < item.min_threshold;

                                <tr>
                                    <td class="ps-3"><input type="checkbox" class="form-check-input"></td>
                                    <td class="fw-bold text-lumitea">@item.ingredient_id.Trim()</td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.name</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@item.unit</span></td>
                                    <td>
                                        <div class="fw-bold @(isLow ? "text-danger" : "text-success") fs-6">
                                            @item.quantity_in_stock.ToString("N3") @item.unit
                                        </div>
                                        @if (isLow)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle small mt-1">SẮP HẾT</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle small mt-1">AN TOÀN</span>
                                        }
                                    </td>
                                    <td class="fw-semibold text-muted">@item.min_threshold.ToString("N3") @item.unit</td>

                                    <!-- THAO TÁC 3 CHẤM (DROPDOWN ĐÃ TINH CHỈNH ĐẸP) -->
                                    <td class="text-center">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light border shadow-sm px-2 py-1 rounded-2" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" title="Thao tác">
                                                <i class="bi bi-three-dots-vertical text-secondary"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2 px-2 rounded-3" style="min-width: 200px;">
                                                <li>
                                                    <a class="dropdown-item py-2 px-3 rounded-2 text-primary fw-semibold d-flex align-items-center mb-1" href="@Url.Action("Edit", new { id = item.ingredient_id.Trim() })">
                                                        <i class="bi bi-pencil-square fs-6 me-2"></i> Chỉnh sửa thông tin
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider my-1 opacity-25"></li>
                                                <li>
                                                    <a class="dropdown-item py-2 px-3 rounded-2 text-danger fw-semibold d-flex align-items-center" href="@Url.Action("Delete", new { id = item.ingredient_id.Trim() })" onclick="return confirm('Bạn có chắc muốn xóa nguyên liệu này không?');">
                                                        <i class="bi bi-trash fs-6 me-2"></i> Xóa nguyên liệu
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Chưa có dữ liệu nguyên liệu nào trong hệ thống.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- JQUERY & BOOTSTRAP 5 JS -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // 1. Tính năng tìm kiếm lọc nhanh trên bảng
        $(document).ready(function () {
            $('#searchInput').on('keyup', function () {
                const val = $(this).val().toLowerCase();
                $('#ingredientTableBody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(val) > -1);
                });
            });

            // 2. Xử lý thủ công nút 3 chấm để chắc chắn menu bung ra khi click
            $(document).on('click', '.dropdown button, [data-bs-toggle="dropdown"]', function (e) {
                e.preventDefault();
                e.stopPropagation();

                var $dropdown = $(this).closest('.dropdown');

                // Đóng tất cả các dropdown khác đang mở trên bảng
                $('.dropdown').not($dropdown).removeClass('show');
                $('.dropdown-menu').not($dropdown.find('.dropdown-menu')).removeClass('show');

                // Bật/tắt menu hiện tại
                $dropdown.toggleClass('show');
                $dropdown.find('.dropdown-menu').toggleClass('show');
            });

            // Click ra chỗ khác trên màn hình thì tự động đóng menu lại
            $(document).on('click', function () {
                $('.dropdown').removeClass('show');
                $('.dropdown-menu').removeClass('show');
            });
        });
    </script>
</body>
</html>