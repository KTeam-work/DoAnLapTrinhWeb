@model IEnumerable<DoAnLapTrinhWeb.Models.Ingredient>

@{
    ViewBag.Title = "Danh Mục Nguyên Liệu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LumiTea - Quản Lý Danh Mục Nguyên Liệu & Lô Hàng</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Css/StyleIngredient.css?v=1.0" rel="stylesheet" />
    <style>
        .row-inactive {
            background-color: #f8f9fa;
            opacity: 0.75;
        }
    </style>
</head>
<body>

    <main class="container-fluid px-4 py-4">

        <!-- BREADCRUMB & HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small text-muted">
                        <li class="breadcrumb-item">Vận hành Kho</li>
                        <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Danh mục Nguyên liệu</li>
                    </ol>
                </nav>
                <h3 class="fw-bold mb-0 text-lumitea">
                    <i class="bi bi-boxes me-2"></i>Quản Lý Danh Mục Nguyên Liệu
                </h3>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm fw-semibold bg-white">
                    <i class="bi bi-arrow-repeat me-1"></i> Đồng bộ POS
                </button>
                <button class="btn btn-outline-secondary btn-sm fw-semibold bg-white" onclick="alert('Mở màn hình Nhập')">
                    <i class="bi bi-download me-1"></i> Nhập kho
                </button>
                <a href="@Url.Action("Create","Ingredient")" class="btn btn-primary btn-sm fw-semibold px-3 text-white">
                    <i class="bi bi-plus-lg me-1"></i> Thêm nguyên liệu
                </a>
            </div>
        </div>

        <!-- STATS CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card-custom p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="small fw-bold text-muted text-uppercase mb-1">Nguyên Liệu Hoạt Động</div>
                            <div class="h3 fw-bold mb-0">
                                @(Model?.Count(x => string.IsNullOrEmpty(x.status) || x.status == "Active") ?? 0)
                                <span class="fs-6 text-muted fw-normal">/ @(Model?.Count() ?? 0) SKU</span>
                            </div>
                            <div class="small text-success mt-2"><i class="bi bi-check-circle me-1"></i>Đang áp dụng pha chế</div>
                        </div>
                        <div class="icon-box bg-light text-dark p-2 rounded-2">
                            <i class="bi bi-box-seam fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card-custom p-3 h-100 border-danger-subtle">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="small fw-bold text-danger text-uppercase mb-1">Sắp Hết Tồn / Cần Nhập</div>
                            <div class="h3 fw-bold mb-0 text-danger">
                                @(Model?.Count(x => x.quantity_in_stock < x.min_threshold && x.status == "Active") ?? 0)
                                <span class="fs-6 text-muted fw-normal">loại chạm ngưỡng</span>
                            </div>
                            <div class="small text-muted mt-2">Cần lên đơn nhập thêm</div>
                        </div>
                        <div class="icon-box bg-danger-subtle text-danger p-2 rounded-2">
                            <i class="bi bi-exclamation-triangle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card-custom p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="small fw-bold text-muted text-uppercase mb-1">Tổng Số Lượng Tồn Kho</div>
                            <div class="h3 fw-bold mb-0">
                                @((Model?.Sum(x => (double?)x.quantity_in_stock) ?? 0).ToString("N0"))
                            </div>
                            <div class="small text-muted mt-2">Tổng số lượng định lượng tồn</div>
                        </div>
                        <div class="icon-box bg-primary-subtle text-primary p-2 rounded-2">
                            <i class="bi bi-stack fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card-custom p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="small fw-bold text-muted text-uppercase mb-1">Tạm Ngừng Sử Dụng</div>
                            <div class="h3 fw-bold mb-0">
                                @(Model?.Count(x => x.status == "Inactive") ?? 0)
                                <span class="fs-6 text-muted fw-normal">loại ngừng dùng</span>
                            </div>
                            <div class="small text-muted mt-2">Nguyên liệu đã xóa mềm / lưu trữ</div>
                        </div>
                        <div class="icon-box bg-light text-muted p-2 rounded-2">
                            <i class="bi bi-slash-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- THÔNG BÁO TỪ CONTROLLER (TEMPDATA) -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- BẢNG FILTER & TÌM KIẾM -->
        <div class="card-custom p-3 mb-4">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo mã hoặc tên nguyên liệu...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="statusFilter" class="form-select form-select-sm">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Active">Đang hoạt động</option>
                        <option value="Inactive">Tạm ngừng sử dụng</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- BẢNG DANH SÁCH NGUYÊN LIỆU -->
        <div class="card-custom overflow-hidden mb-4 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40px;" class="ps-3"><input type="checkbox" class="form-check-input"></th>
                            <th>MÃ NL</th>
                            <th>TÊN NGUYÊN LIỆU</th>
                            <th>ĐVT</th>
                            <th>TỔNG TỒN KHO HIỆN TẠI</th>
                            <th>ĐỊNH MỨC TỐI THIỂU</th>
                            <th class="text-center">TRẠNG THÁI</th>
                            <th class="text-center" style="width: 120px;">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody id="ingredientTableBody">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var isLow = item.quantity_in_stock < item.min_threshold;
                                var isActive = string.IsNullOrEmpty(item.status) || item.status == "Active";

                                <tr class="@(isActive ? "" : "row-inactive")" data-status="@(isActive ? "Active" : "Inactive")">
                                    <td class="ps-3"><input type="checkbox" class="form-check-input"></td>
                                    <td class="fw-bold text-lumitea">@item.ingredient_id.Trim()</td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.name</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@item.unit</span></td>
                                    <td>
                                        <div class="fw-bold @(isLow ? "text-danger" : "text-success") fs-6">
                                            @item.quantity_in_stock.ToString("N3") @item.unit
                                        </div>
                                        @if (isLow)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle small mt-1">SẮP HẾT</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle small mt-1">AN TOÀN</span>
                                        }
                                    </td>
                                    <td class="fw-semibold text-muted">@item.min_threshold.ToString("N3") @item.unit</td>

                                    <!-- CỘT TRẠNG THÁI -->
                                    <td class="text-center">
                                        @if (isActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                                <i class="bi bi-check-circle-fill me-1"></i> Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">
                                                <i class="bi bi-slash-circle me-1"></i> Tạm ngừng
                                            </span>
                                        }
                                    </td>

                                    <!-- CỤM NÚT THAO TÁC -->
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-2">
                                            <!-- Nút Chỉnh sửa -->
                                            <a href="@Url.Action("Edit", new { id = item.ingredient_id.Trim() })"
                                               class="btn btn-sm btn-primary-subtle text-primary border border-primary-subtle rounded-2 btn-action"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               title="Chỉnh sửa thông tin">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <!-- Nút Xóa (Kích hoạt Modal) -->
                                            <button type="button"
                                                    class="btn btn-sm btn-danger-subtle text-danger border border-danger-subtle rounded-2 btn-action btn-trigger-delete"
                                                    data-id="@item.ingredient_id.Trim()"
                                                    data-name="@item.name"
                                                    data-status="@(isActive ? "Active" : "Inactive")"
                                                    data-bs-toggle="tooltip"
                                                    data-bs-placement="top"
                                                    title="@(isActive ? "Xóa / Tạm ngừng" : "Xóa nguyên liệu")">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Chưa có dữ liệu nguyên liệu nào trong hệ thống.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- MODAL XÁC NHẬN XÓA NGUYÊN LIỆU -->
        <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content border-0 shadow">
                    <div class="modal-body text-center p-4">
                        <div class="text-danger mb-3">
                            <i class="bi bi-exclamation-circle display-4"></i>
                        </div>
                        <h5 class="fw-bold mb-2" id="deleteModalLabel">Xác nhận xóa?</h5>
                        <p class="text-muted small mb-4">
                            Bạn có chắc muốn xóa nguyên liệu <br><strong id="deleteTargetName" class="text-dark"></strong> không?<br>
                            <span class="text-muted small d-block mt-2">Hệ thống sẽ xóa vĩnh viễn nếu chưa dùng, hoặc tự chuyển sang <b>Tạm ngừng</b> nếu đã có lịch sử kho/công thức.</span>
                        </p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-light border btn-sm px-3 fw-semibold" data-bs-dismiss="modal">Hủy bỏ</button>
                            <a id="btnConfirmDelete" href="#" class="btn btn-danger btn-sm px-3 fw-semibold">Đồng ý</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- JQUERY & BOOTSTRAP 5 JS -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            // 1. Bộ lọc tìm kiếm kết hợp Search text và Trạng thái
            function filterTable() {
                const searchVal = $('#searchInput').val().toLowerCase();
                const selectedStatus = $('#statusFilter').val();

                $('#ingredientTableBody tr').filter(function () {
                    const rowText = $(this).text().toLowerCase();
                    const rowStatus = $(this).data('status');

                    const matchesSearch = rowText.indexOf(searchVal) > -1;
                    const matchesStatus = !selectedStatus || rowStatus === selectedStatus;

                    $(this).toggle(matchesSearch && matchesStatus);
                });
            }

            $('#searchInput').on('keyup', filterTable);
            $('#statusFilter').on('change', filterTable);

            // 2. Khởi tạo Tooltip Bootstrap 5
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // 3. Xử lý mở Modal xác nhận xóa
            $('.btn-trigger-delete').on('click', function () {
                const ingredientId = $(this).data('id');
                const ingredientName = $(this).data('name');
                const deleteUrl = '@Url.Action("Delete", "Ingredient")/' + encodeURIComponent(ingredientId);

                $('#deleteTargetName').text(ingredientName + ' (' + ingredientId + ')');
                $('#btnConfirmDelete').attr('href', deleteUrl);

                const deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
                deleteModal.show();
            });
        });
    </script>
</body>
</html>