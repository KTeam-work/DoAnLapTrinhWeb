@model IEnumerable<DoAnLapTrinhWeb.Models.Customer>

@{
    ViewData["Title"] = "Quản lý Khách hàng";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/Css/styleCustomer_index.css" />

<div class="container-fluid px-4 py-4">

    <!-- Header -->
    <div class="mb-4">
        <div class="breadcrumb-saas mb-2">
            <a href="#">Trang chủ</a> <i class="fa-solid fa-chevron-right mx-1 text-muted" style="font-size: 0.7rem;"></i> <span class="fw-semibold text-dark">Khách hàng</span>
        </div>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark">Quản lý Khách hàng</h4>
                <p class="text-muted small mb-0">Theo dõi thông tin, phân hạng và tương tác khách hàng thông minh 360°</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-glass-primary btn-sm rounded-3 px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#addModal">
                    <i class="fa-solid fa-user-plus me-1.5"></i> Thêm khách hàng
                </button>
            </div>
        </div>
    </div>

    <!-- 4 Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">TỔNG KHÁCH HÀNG</span>
                    <div class="metric-icon-wrapper" style="background: rgba(79, 70, 229, 0.12); color: #4f46e5;">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <h3 class="fw-bold mb-0 text-dark" id="statTotal">@(ViewBag.TotalCustomers ?? 0)</h3>
                </div>
                <div class="text-muted small">Khách hàng đã đăng ký</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">THÀNH VIÊN VIP</span>
                    <div class="metric-icon-wrapper" style="background: rgba(147, 51, 234, 0.12); color: #9333ea;">
                        <i class="fa-solid fa-award"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <h3 class="fw-bold mb-0 text-dark">@(ViewBag.VipCount ?? 0)</h3>
                </div>
                <div class="text-muted small">Hội viên chi tiêu cao</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">CHI TIÊU TRUNG BÌNH</span>
                    <div class="metric-icon-wrapper" style="background: rgba(2, 132, 199, 0.12); color: #0284c7;">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <h3 class="fw-bold mb-0 text-dark">@string.Format("{0:N0}", ViewBag.AvgSpent ?? 0) <span class="fs-6 fw-normal text-muted">đ</span></h3>
                </div>
                <div class="text-muted small">Doanh số trung bình / khách</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">TÀI KHOẢN TẠM KHÓA</span>
                    <div class="metric-icon-wrapper" style="background: rgba(225, 29, 72, 0.12); color: #e11d48;">
                        <i class="fa-solid fa-user-lock"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <h3 class="fw-bold mb-0 text-dark">@(ViewBag.LockedCount ?? 0)</h3>
                </div>
                <div class="text-muted small d-flex justify-content-between align-items-center">
                    <span>Tài khoản vi phạm / khóa</span>
                    <a href="javascript:void(0)" onclick="quickFilterLocked()" class="text-primary text-decoration-none fw-semibold">Lọc ngay <i class="fa-solid fa-arrow-right" style="font-size:10px;"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Controls Panel -->
    <div class="glass-panel p-3 mb-4">
        <div class="row g-2 align-items-center mb-3">
            <div class="col-12 col-md-4">
                <div class="position-relative">
                    <i class="fa-solid fa-magnifying-glass position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" id="searchInput" class="form-control form-saas ps-5 pe-5" placeholder="Tìm theo tên, mã KH, email hoặc SĐT..." onkeyup="filterData()">
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select id="rankFilter" class="form-select form-saas" onchange="filterData()">
                    <option value="">Hạng: Tất cả</option>
                    <option value="VIP">VIP Tier</option>
                    <option value="Gold">Gold Tier</option>
                    <option value="Standard">Standard Tier</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select id="statusFilter" class="form-select form-saas" onchange="filterData()">
                    <option value="">Trạng thái: Tất cả</option>
                    <option value="Hoạt động">Hoạt động</option>
                    <option value="Đã khóa">Đã khóa</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex align-items-center justify-content-end gap-2">
                <button class="view-btn active" id="btnGrid" onclick="setMode('grid')" title="Dạng Thẻ"><i class="fa-solid fa-border-all"></i></button>
                <button class="view-btn" id="btnCompact" onclick="setMode('compact')" title="Dạng Danh sách"><i class="fa-solid fa-list"></i></button>
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-2 border-top border-secondary border-opacity-10">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button class="filter-tab active" onclick="setQuickTab('all', this)">Tất cả (@(ViewBag.TotalCustomers ?? 0))</button>
                <button class="filter-tab" onclick="setQuickTab('VIP', this)">VIP Tier (@(ViewBag.VipCount ?? 0))</button>
                <button class="filter-tab" onclick="setQuickTab('high_spent', this)">Chi tiêu cao (>10M)</button>
                <button class="filter-tab" onclick="setQuickTab('care', this)">Đã khóa (@(ViewBag.LockedCount ?? 0))</button>
            </div>
            <button class="btn btn-link text-muted p-0 text-decoration-none small fw-semibold" onclick="resetFilters()">
                <i class="fa-solid fa-rotate-right me-1"></i> Xóa bộ lọc
            </button>
        </div>
    </div>

    <!-- Customer Cards Grid (ĐỔ DỮ LIỆU THẬT) -->
    <div class="row g-3" id="customerContainer">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                var orders = item.Orders?.ToList() ?? new List<DoAnLapTrinhWeb.Models.Order>();
                decimal totalSpent = orders.Where(o => o.status == "Completed").Sum(o => (decimal?)o.total_amount) ?? 0;
                string rank = (item.loyalty_point >= 1000 || totalSpent >= 10000000) ? "VIP" : ((item.loyalty_point >= 500 || totalSpent >= 5000000) ? "Gold" : "Standard");
                string status = (item.User != null && item.User.status == "Locked") ? "Đã khóa" : "Hoạt động";

                // Lấy 2 chữ cái đầu làm avatar
                string initials = "KH";
                if (!string.IsNullOrWhiteSpace(item.full_name))
                {
                    var parts = item.full_name.Trim().Split(' ');
                    initials = parts.Length > 1 ? (parts[parts.Length - 2][0].ToString() + parts[parts.Length - 1][0].ToString()).ToUpper() : parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
                }

                <div class="col-12 col-md-6 col-xl-4 customer-card-wrapper"
                     data-name="@item.full_name"
                     data-id="@item.customer_id.Trim()"
                     data-phone="@(item.phone ?? "")"
                     data-rank="@rank"
                     data-status="@status"
                     data-spent="@totalSpent">
                    <div class="customer-card">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-circle">@initials</div>
                                <div>
                                    <div class="d-flex align-items-center gap-1.5">
                                        <h6 class="fw-bold text-dark mb-0 card-title-name">@item.full_name</h6>
                                        <i class="fa-solid fa-circle-check text-primary ms-1" style="font-size: 0.85rem;" title="Đã xác thực"></i>
                                    </div>
                                    <span class="text-muted small">#@item.customer_id.Trim() • Tham gia @item.created_at.ToString("yyyy")</span>
                                </div>
                            </div>
                        </div>

                        <div class="card-body-content">
                            <div class="d-flex gap-2 mb-3">
                                @if (status == "Đã khóa")
                                {
                                    <span class="badge-pill-saas badge-locked"><i class="fa-solid fa-lock" style="font-size: 8px;"></i> Đã khóa</span>
                                }
                                else
                                {
                                    <span class="badge-pill-saas badge-active"><i class="fa-solid fa-circle" style="font-size: 6px;"></i> Hoạt động</span>
                                }
                                <span class="badge-pill-saas @(rank == "VIP" ? "badge-vip" : (rank == "Gold" ? "badge-gold" : "bg-light text-muted border"))">
                                    <i class="fa-solid fa-trophy"></i> @rank Tier
                                </span>
                            </div>

                            <div class="contact-info-box mb-3">
                                <div class="text-muted small mb-1"><i class="fa-solid fa-phone me-2 text-muted"></i> @(item.phone ?? "Chưa có")</div>
                                <div class="text-muted small"><i class="fa-solid fa-envelope me-2 text-muted"></i> @(item.email ?? "Chưa có email")</div>
                            </div>

                            <div class="card-hide-compact">
                                <div class="d-flex justify-content-between align-items-baseline mb-2">
                                    <span class="text-muted small">Tổng chi tiêu:</span>
                                    <span class="fw-bold text-dark fs-6">@totalSpent.ToString("N0") <span class="fw-normal text-muted small">đ</span></span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center small mb-1">
                                    <span class="text-muted" style="font-size: 0.78rem;">Điểm thưởng</span>
                                    <span class="text-success fw-bold" style="font-size: 0.78rem;">@item.loyalty_point điểm</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-2 border-top border-secondary border-opacity-10 card-hide-compact">
                            <button class="btn btn-sm btn-glass-secondary rounded-3 w-50 fw-semibold"
                                    onclick="openDrawer('@item.full_name', '@item.customer_id.Trim()', '@(item.phone ?? "")', '@rank Tier', '@totalSpent.ToString("N0") đ')">
                                Xem nhanh
                            </button>
                            <a href="@Url.Action("Details", "Customer", new { id = item.customer_id.Trim() })"
                               class="btn btn-sm btn-glass-primary rounded-3 w-50 fw-semibold text-center text-decoration-none d-flex align-items-center justify-content-center gap-1">
                                Hồ sơ 360° <i class="fa-solid fa-arrow-right" style="font-size: 0.75rem;"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="fa-solid fa-users display-4 mb-3 text-secondary"></i>
                <p>Chưa có dữ liệu khách hàng nào trong hệ thống.</p>
            </div>
        }
    </div>
</div>

<!-- Drawer Quick View -->
<div class="offcanvas offcanvas-end drawer-saas" tabindex="-1" id="quickDrawer" style="width: 420px;">
    <div class="offcanvas-header border-bottom border-secondary border-opacity-10">
        <h6 class="offcanvas-title fw-bold text-dark">Chi tiết nhanh khách hàng</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-4">
        <div class="text-center pb-3 border-bottom border-secondary border-opacity-10 mb-4">
            <div class="avatar-circle mx-auto mb-2" style="width: 60px; height: 60px; font-size: 1.2rem;" id="drAvatar">KH</div>
            <h5 class="fw-bold mb-0 text-dark" id="drName">Khách Hàng</h5>
            <span class="text-muted small" id="drId">#KH-000</span>
        </div>

        <div class="d-flex flex-column gap-3">
            <div>
                <label class="text-muted small d-block mb-1">Số điện thoại</label>
                <div class="fw-semibold text-dark" id="drPhone">--</div>
            </div>
            <div>
                <label class="text-muted small d-block mb-1">Hạng thành viên</label>
                <span class="badge-pill-saas badge-vip" id="drRank">Standard Tier</span>
            </div>
            <div>
                <label class="text-muted small d-block mb-1">Tổng chi tiêu</label>
                <div class="fw-bold fs-5 text-success" id="drSpent">0 đ</div>
            </div>
        </div>

        <div class="d-grid gap-2 mt-5">
            <a href="#" id="drLinkDetails" class="btn btn-glass-primary rounded-3 py-2 fw-semibold text-center text-decoration-none">
                Xem Hồ sơ 360° đầy đủ
            </a>
        </div>
    </div>
</div>

<!-- Modal Thêm Khách Hàng -->
<div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-glass rounded-4 shadow-lg">
            <div class="modal-header border-bottom border-secondary border-opacity-10">
                <h6 class="modal-title fw-bold text-dark"><i class="fa-solid fa-user-plus text-primary me-2"></i>Thêm mới khách hàng</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                <form id="addForm" onsubmit="event.preventDefault(); handleAddCustomer();">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Họ và Tên *</label>
                        <input type="text" id="addName" class="form-control form-saas" placeholder="Nguyễn Văn A" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Số điện thoại *</label>
                        <input type="tel" id="addPhone" class="form-control form-saas" placeholder="090xxxxxxx" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Email</label>
                        <input type="email" id="addEmail" class="form-control form-saas" placeholder="khachhang@gmail.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Hạng thành viên khởi tạo</label>
                        <select id="addRank" class="form-select form-saas">
                            <option value="Standard">Standard Tier (0 điểm)</option>
                            <option value="Gold">Gold Tier (Tặng 500 điểm)</option>
                            <option value="VIP">VIP Tier (Tặng 1.000 điểm)</option>
                        </select>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-glass-secondary rounded-3 px-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-glass-primary rounded-3 px-4 fw-semibold">Lưu khách hàng</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function setMode(mode) {
        const container = document.getElementById('customerContainer');
        const btnGrid = document.getElementById('btnGrid');
        const btnCompact = document.getElementById('btnCompact');

        if (mode === 'compact') {
            container.classList.add('view-compact');
            btnCompact.classList.add('active');
            btnGrid.classList.remove('active');
        } else {
            container.classList.remove('view-compact');
            btnGrid.classList.add('active');
            btnCompact.classList.remove('active');
        }
    }

    function filterData() {
        const search = document.getElementById('searchInput').value.toLowerCase();
        const rank = document.getElementById('rankFilter').value.toLowerCase();
        const status = document.getElementById('statusFilter').value.toLowerCase();
        const items = document.querySelectorAll('.customer-card-wrapper');

        items.forEach(item => {
            const name = item.getAttribute('data-name').toLowerCase();
            const id = item.getAttribute('data-id').toLowerCase();
            const phone = item.getAttribute('data-phone').toLowerCase();
            const rRank = item.getAttribute('data-rank').toLowerCase();
            const rStatus = item.getAttribute('data-status').toLowerCase();

            const matchSearch = name.includes(search) || id.includes(search) || phone.includes(search);
            const matchRank = !rank || rRank.includes(rank);
            const matchStatus = !status || rStatus.includes(status);

            item.style.display = (matchSearch && matchRank && matchStatus) ? '' : 'none';
        });
    }

    function setQuickTab(type, element) {
        document.querySelectorAll('.filter-tab').forEach(el => el.classList.remove('active'));
        element.classList.add('active');

        const items = document.querySelectorAll('.customer-card-wrapper');
        items.forEach(item => {
            const rank = item.getAttribute('data-rank');
            const spent = parseInt(item.getAttribute('data-spent') || '0');
            const status = item.getAttribute('data-status');

            if (type === 'all') item.style.display = '';
            else if (type === 'VIP') item.style.display = rank === 'VIP' ? '' : 'none';
            else if (type === 'high_spent') item.style.display = spent >= 10000000 ? '' : 'none';
            else if (type === 'care') item.style.display = status === 'Đã khóa' ? '' : 'none';
        });
    }

    function quickFilterLocked() {
        document.getElementById('statusFilter').value = 'Đã khóa';
        filterData();
    }

    function resetFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('rankFilter').value = '';
        document.getElementById('statusFilter').value = '';
        document.querySelectorAll('.filter-tab').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.filter-tab')[0].classList.add('active');
        filterData();
    }

    function openDrawer(name, id, phone, rank, spent) {
        document.getElementById('drName').innerText = name;
        document.getElementById('drId').innerText = '#' + id;
        document.getElementById('drPhone').innerText = phone || 'Chưa có SĐT';
        document.getElementById('drRank').innerText = rank;
        document.getElementById('drSpent').innerText = spent;
        document.getElementById('drLinkDetails').href = '@Url.Action("Details", "Customer")/' + encodeURIComponent(id);

        const drawer = new bootstrap.Offcanvas(document.getElementById('quickDrawer'));
        drawer.show();
    }

    function handleAddCustomer() {
        const name = document.getElementById('addName').value.trim();
        const phone = document.getElementById('addPhone').value.trim();
        const email = document.getElementById('addEmail').value.trim();
        const rank = document.getElementById('addRank').value;

        $.ajax({
            url: '@Url.Action("AddCustomer", "Customer")',
            type: 'POST',
            data: { name: name, phone: phone, email: email, rank: rank },
            success: function (res) {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message);
                }
            },
            error: function () {
                alert("Lỗi kết nối máy chủ!");
            }
        });
    }
</script>