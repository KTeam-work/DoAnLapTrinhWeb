    </div>

    <!-- Footer Pagination -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-4 pt-3 border-top border-secondary border-opacity-10">
        <div class="d-flex align-items-center gap-3">
            <span class="text-muted small">Hiển thị <strong class="text-dark">1 - 3</strong> trong <strong id="visibleCount" class="text-dark">1,248</strong> khách hàng</span>
            <div class="d-flex align-items-center gap-1.5 small text-muted ms-2">
                <span>Số lượng/trang:</span>
                <select class="form-select form-saas py-1 px-2" style="width: auto; font-size: 0.8rem;">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
            </div>
        </div>

        <div class="d-flex align-items-center gap-1">
            <a href="#" class="page-link-saas disabled"><i class="fa-solid fa-chevron-left"></i></a>
            <a href="#" class="page-link-saas active">1</a>
            <a href="#" class="page-link-saas">2</a>
            <a href="#" class="page-link-saas">3</a>
            <span class="text-muted mx-1">...</span>
            <a href="#" class="page-link-saas">42</a>
