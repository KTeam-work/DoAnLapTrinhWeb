                            <span class="fw-bold text-dark fs-6">6,200,000 <span class="fw-normal text-muted small">đ</span></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small mb-1">
                            <span class="text-muted" style="font-size: 0.78rem;">Tiến độ VIP Tier</span>
                            <span class="text-muted fw-semibold" style="font-size: 0.78rem;">62%</span>
