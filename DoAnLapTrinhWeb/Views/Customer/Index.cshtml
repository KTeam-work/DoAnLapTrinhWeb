                        <div class="text-muted small"><i class="fa-solid fa-envelope me-2 text-muted"></i> tanky.dev@huit.edu.vn</div>
                    </div>

                    <div class="card-hide-compact">
                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                            <span class="text-muted small">Tổng tích lũy</span>
                            <span class="fw-bold text-dark fs-6">18,500,000 <span class="fw-normal text-muted small">đ</span></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small mb-1">
                            <span class="text-muted" style="font-size: 0.78rem;">Tiến độ Diamond</span>
