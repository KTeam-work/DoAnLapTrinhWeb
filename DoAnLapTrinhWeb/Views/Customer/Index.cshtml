                    </a>
                </div>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="col-12 col-md-6 col-xl-4 customer-card-wrapper" data-name="Trần Hoàng Nam" data-id="#KH-1089" data-phone="0988 765 432" data-rank="Gold" data-status="Hoạt động" data-spent="6200000">
            <div class="customer-card">
