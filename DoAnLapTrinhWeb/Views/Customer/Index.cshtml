                        <div>
                            <div class="d-flex align-items-center gap-1.5">
                                <h6 class="fw-bold text-dark mb-0 card-title-name">Trần Hoàng Nam</h6>
                            </div>
                            <span class="text-muted small">#KH-1089 • Gia nhập 2023</span>
                        </div>
                    </div>
                    <button class="btn btn-link text-muted p-0"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                </div>

                <div class="card-body-content">
                    <div class="d-flex gap-2 mb-3">
                        <span class="badge-pill-saas badge-active"><i class="fa-solid fa-circle" style="font-size: 6px;"></i> Hoạt động</span>
                        <span class="badge-pill-saas badge-gold"><i class="fa-solid fa-award"></i> Gold Tier</span>
                    </div>

                    <div class="contact-info-box mb-3">
                        <div class="text-muted small mb-1"><i class="fa-solid fa-phone me-2 text-muted"></i> 0988 765 432</div>
                        <div class="text-muted small"><i class="fa-solid fa-envelope me-2 text-muted"></i> hoangnam@gmail.com</div>
                    </div>

                    <div class="card-hide-compact">
