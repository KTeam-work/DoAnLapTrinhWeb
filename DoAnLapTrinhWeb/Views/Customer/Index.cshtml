                    <button class="btn btn-sm btn-glass-danger rounded-3 w-50 fw-semibold" onclick="triggerToast('Đã mở khóa tài khoản Phan Thị Hồng!')">
                        Mở khóa
                    </button>
                    <button class="btn btn-sm btn-glass-secondary rounded-3 w-50 fw-semibold" onclick="openDrawer('Phan Thị Hồng', '#KH-1090', '0912 333 444', 'Standard Tier', '850,000 đ')">
                        Xem nhanh
