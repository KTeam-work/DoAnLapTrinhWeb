                        <div>
                            <div class="d-flex align-items-center gap-1.5">
                                <h6 class="fw-bold text-dark mb-0 card-title-name">Nguyễn Tấn Kỳ</h6>
                                <i class="fa-solid fa-circle-check text-primary" style="font-size: 0.85rem;" title="Tài khoản đã xác minh"></i>
                            </div>
                            <span class="text-muted small">#KH-1088 • Gia nhập 2022</span>
                        </div>
                    </div>
                    <button class="btn btn-link text-muted p-0"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                </div>

                <div class="card-body-content">
                    <div class="d-flex gap-2 mb-3">
                        <span class="badge-pill-saas badge-active"><i class="fa-solid fa-circle" style="font-size: 6px;"></i> Hoạt động</span>
                        <span class="badge-pill-saas badge-vip"><i class="fa-solid fa-trophy"></i> VIP Tier</span>
                    </div>

                    <div class="contact-info-box mb-3">
