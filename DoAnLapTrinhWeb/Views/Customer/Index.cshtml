</div>

<!-- Drawer Quick View -->
<div class="offcanvas offcanvas-end drawer-saas" tabindex="-1" id="quickDrawer" style="width: 420px;">
    <div class="offcanvas-header border-bottom border-secondary border-opacity-10">
        <h6 class="offcanvas-title fw-bold text-dark">Chi tiết nhanh khách hàng</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-4">
        <div class="text-center pb-3 border-bottom border-secondary border-opacity-10 mb-4">
            <div class="avatar-circle mx-auto mb-2" style="width: 60px; height: 60px; font-size: 1.2rem;" id="drAvatar">TK</div>
            <h5 class="fw-bold mb-0 text-dark" id="drName">Nguyễn Tấn Kỳ</h5>
            <span class="text-muted small" id="drId">#KH-1088</span>
        </div>

        <div class="d-flex flex-column gap-3">
            <div>
                <label class="text-muted small d-block mb-1">Số điện thoại</label>
                <div class="fw-semibold text-dark" id="drPhone">0901 234 567</div>
            </div>
            <div>
                <label class="text-muted small d-block mb-1">Hạng thành viên</label>
                <span class="badge-pill-saas badge-vip" id="drRank">VIP Tier</span>
            </div>
            <div>
                <label class="text-muted small d-block mb-1">Tổng chi tiêu</label>
                <div class="fw-bold fs-5 text-success" id="drSpent">18,500,000 đ</div>
            </div>
        </div>

        <div class="d-grid gap-2 mt-5">
            <a href="/Customer/Details" class="btn btn-glass-primary rounded-3 py-2 fw-semibold text-center text-decoration-none">
                Xem Hồ sơ 360° đầy đủ
            </a>
            <button class="btn btn-glass-secondary rounded-3 py-2 text-dark fw-semibold" onclick="triggerToast('Đã gửi thông báo ưu đãi SMS!')">
                <i class="fa-solid fa-paper-plane me-1"></i> Gửi ưu đãi SMS
            </button>
        </div>
    </div>
</div>

<!-- Modal Thêm Khách Hàng -->
<div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-glass rounded-4 shadow-lg">
            <div class="modal-header border-bottom border-secondary border-opacity-10">
                <h6 class="modal-title fw-bold text-dark"><i class="fa-solid fa-user-plus text-primary me-2"></i>Thêm mới khách hàng</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                <form id="addForm" onsubmit="event.preventDefault(); handleAddCustomer();">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Họ và Tên</label>
                        <input type="text" id="addName" class="form-control form-saas" placeholder="Nguyễn Văn A" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Số điện thoại</label>
                        <input type="tel" id="addPhone" class="form-control form-saas" placeholder="090xxxxxxx" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Hạng ban đầu</label>
                        <select id="addRank" class="form-select form-saas">
                            <option value="Standard">Standard Tier</option>
                            <option value="Gold">Gold Tier</option>
                            <option value="VIP">VIP Tier</option>
                        </select>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-glass-secondary rounded-3 px-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-glass-primary rounded-3 px-4 fw-semibold">Lưu khách hàng</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notice -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="saasToast" class="toast align-items-center text-dark bg-white border border-secondary border-opacity-25 rounded-3 shadow-lg" role="alert">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-check text-success"></i>
                <span id="toastMsg">Thao tác thành công!</span>
            </div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script>
    function setMode(mode) {
        const container = document.getElementById('customerContainer');
        const btnGrid = document.getElementById('btnGrid');
        const btnCompact = document.getElementById('btnCompact');

        if (mode === 'compact') {
            container.classList.add('view-compact');
            btnCompact.classList.add('active');
            btnGrid.classList.remove('active');
        } else {
            container.classList.remove('view-compact');
            btnGrid.classList.add('active');
            btnCompact.classList.remove('active');
        }
    }

    function filterData() {
        const search = document.getElementById('searchInput').value.toLowerCase();
        const rank = document.getElementById('rankFilter').value.toLowerCase();
        const status = document.getElementById('statusFilter').value.toLowerCase();
        const items = document.querySelectorAll('.customer-card-wrapper');

        items.forEach(item => {
            const name = item.getAttribute('data-name').toLowerCase();
            const id = item.getAttribute('data-id').toLowerCase();
            const phone = item.getAttribute('data-phone').toLowerCase();
            const rRank = item.getAttribute('data-rank').toLowerCase();
            const rStatus = item.getAttribute('data-status').toLowerCase();

            const matchSearch = name.includes(search) || id.includes(search) || phone.includes(search);
            const matchRank = !rank || rRank.includes(rank);
            const matchStatus = !status || rStatus.includes(status);

            if (matchSearch && matchRank && matchStatus) {
                item.style.display = '';
            } else {
                item.style.display = 'none';
            }
        });
    }

    function setQuickTab(type, element) {
        document.querySelectorAll('.filter-tab').forEach(el => el.classList.remove('active'));
        element.classList.add('active');

        const items = document.querySelectorAll('.customer-card-wrapper');
        items.forEach(item => {
            const rank = item.getAttribute('data-rank');
            const spent = parseInt(item.getAttribute('data-spent') || '0');
            const status = item.getAttribute('data-status');

            if (type === 'all') {
                item.style.display = '';
            } else if (type === 'VIP') {
                item.style.display = rank === 'VIP' ? '' : 'none';
            } else if (type === 'high_spent') {
                item.style.display = spent >= 10000000 ? '' : 'none';
            } else if (type === 'care') {
                item.style.display = status === 'Đã khóa' ? '' : 'none';
            }
        });
    }

    function quickFilterLocked() {
        document.getElementById('statusFilter').value = 'Đã khóa';
        filterData();
    }

    function resetFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('rankFilter').value = '';
        document.getElementById('statusFilter').value = '';
        document.querySelectorAll('.filter-tab').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.filter-tab')[0].classList.add('active');
        filterData();
    }

    function openDrawer(name, id, phone, rank, spent) {
        document.getElementById('drName').innerText = name;
        document.getElementById('drId').innerText = id;
        document.getElementById('drPhone').innerText = phone;
        document.getElementById('drRank').innerText = rank;
        document.getElementById('drSpent').innerText = spent;
        document.getElementById('drAvatar').innerText = name.split(' ').map(n => n[0]).slice(-2).join('');

        const drawer = new bootstrap.Offcanvas(document.getElementById('quickDrawer'));
        drawer.show();
    }

    function handleAddCustomer() {
        const name = document.getElementById('addName').value;
        const phone = document.getElementById('addPhone').value;
        const rank = document.getElementById('addRank').value;

        const container = document.getElementById('customerContainer');
        const initials = name.split(' ').map(n => n[0]).slice(-2).join('');

        const newCard = `
            <div class="col-12 col-md-6 col-xl-4 customer-card-wrapper" data-name="${name}" data-id="#KH-1091" data-phone="${phone}" data-rank="${rank}" data-status="Hoạt động" data-spent="0">
                <div class="customer-card">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar-circle">${initials}</div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0 card-title-name">${name}</h6>
                                <span class="text-muted small">#KH-1091 • Gia nhập 2026</span>
                            </div>
                        </div>
                        <button class="btn btn-link text-muted p-0"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                    </div>

                    <div class="card-body-content">
                        <div class="d-flex gap-2 mb-3">
                            <span class="badge-pill-saas badge-active"><i class="fa-solid fa-circle" style="font-size: 6px;"></i> Hoạt động</span>
                            <span class="badge-pill-saas badge-gold">${rank} Tier</span>
                        </div>

                        <div class="contact-info-box mb-3">
                            <div class="text-muted small mb-1"><i class="fa-solid fa-phone me-2 text-muted"></i> ${phone}</div>
                            <div class="text-muted small"><i class="fa-solid fa-envelope me-2 text-muted"></i> newuser@gmail.com</div>
                        </div>

                        <div class="card-hide-compact">
                            <div class="d-flex justify-content-between align-items-baseline mb-2">
                                <span class="text-muted small">Tổng tích lũy</span>
                                <span class="fw-bold text-dark fs-6">0 <span class="fw-normal text-muted small">đ</span></span>
                            </div>
                            <div class="progress-saas mb-3">
                                <div class="progress-bar" style="width: 0%;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 pt-2 border-top border-secondary border-opacity-10 card-hide-compact">
                        <button class="btn btn-sm btn-glass-secondary rounded-3 w-50 fw-semibold" onclick="openDrawer('${name}', '#KH-1091', '${phone}', '${rank} Tier', '0 đ')">
                            Xem nhanh
                        </button>
                        <a href="/Customer/Details" class="btn btn-sm btn-glass-primary rounded-3 w-50 fw-semibold text-center text-decoration-none d-flex align-items-center justify-content-center gap-1">
                            Hồ sơ 360° <i class="fa-solid fa-arrow-right" style="font-size: 0.75rem;"></i>
                        </a>
                    </div>
                </div>
            </div>
        `;

        container.insertAdjacentHTML('afterbegin', newCard);
        bootstrap.Modal.getInstance(document.getElementById('addModal')).hide();
        document.getElementById('addForm').reset();
        triggerToast('Thêm khách hàng thành công!');
        filterData();
    }

    function triggerToast(msg) {
        document.getElementById('toastMsg').innerText = msg;
        const toast = new bootstrap.Toast(document.getElementById('saasToast'));
        toast.show();
    }
</script>