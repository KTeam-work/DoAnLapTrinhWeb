@{
    ViewData["Title"] = "Quản lý Khách hàng";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/Css/styleCustomer_index.css" />

<div class="container-fluid px-4 py-4">

    <!-- Header -->
    <div class="mb-4">
        <div class="breadcrumb-saas mb-2">
            <a href="#">Trang chủ</a> <i class="fa-solid fa-chevron-right mx-1 text-muted" style="font-size: 0.7rem;"></i> <span class="fw-semibold text-dark">Khách hàng</span>
        </div>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark">Quản lý Khách hàng</h4>
                <p class="text-muted small mb-0">Theo dõi thông tin, phân hạng và tương tác khách hàng thông minh 360°</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-glass-secondary btn-sm rounded-3 px-3 fw-semibold dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="fa-solid fa-download me-1.5 text-muted"></i> Xuất dữ liệu
                </button>
                <ul class="dropdown-menu shadow-sm">
                    <li><a class="dropdown-item" href="#" onclick="triggerToast('Đã xuất file Excel!')">Xuất Excel (.xlsx)</a></li>
                    <li><a class="dropdown-item" href="#" onclick="triggerToast('Đã xuất file CSV!')">Xuất CSV (.csv)</a></li>
                </ul>
                <button class="btn btn-glass-primary btn-sm rounded-3 px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#addModal">
                    <i class="fa-solid fa-user-plus me-1.5"></i>  Thêm khách hàng
                </button>
            </div>
        </div>
    </div>

    <!-- 4 Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">TỔNG KHÁCH HÀNG</span>
                    <div class="metric-icon-wrapper" style="background: rgba(79, 70, 229, 0.12); color: #4f46e5;">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <h3 class="fw-bold mb-0 text-dark" id="statTotal">1,248</h3>
                    <span class="badge-pill-saas badge-active" style="padding: 2px 8px; font-size: 0.72rem;"><i class="fa-solid fa-chart-line"></i> +12%</span>
                </div>
                <div class="text-muted small">Tăng 142 tài khoản mới 30 ngày qua</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">THÀNH VIÊN VIP</span>
                    <div class="metric-icon-wrapper" style="background: rgba(147, 51, 234, 0.12); color: #9333ea;">
                        <i class="fa-solid fa-award"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <h3 class="fw-bold mb-0 text-dark">184</h3>
                    <span class="badge-pill-saas" style="background: rgba(0,0,0,0.05); color: var(--text-muted);">~15% tổng số</span>
                </div>
                <div class="progress-saas mt-2" style="height: 4px;">
                    <div class="progress-bar" style="width: 15%; background: linear-gradient(90deg, #9333ea, #a855f7);"></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">CHI TIÊU TRUNG BÌNH</span>
                    <div class="metric-icon-wrapper" style="background: rgba(2, 132, 199, 0.12); color: #0284c7;">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <h3 class="fw-bold mb-0 text-dark">4.25M <span class="fs-6 fw-normal text-muted">đ</span></h3>
                    <span class="badge-pill-saas badge-active" style="padding: 2px 8px; font-size: 0.72rem;"><i class="fa-solid fa-arrow-up-right"></i> +5.4%</span>
                </div>
                <div class="text-muted small d-flex justify-content-between">
                    <span>Kỳ trước: 4.03M đ</span>
                    <span class="text-success fw-semibold">Đạt mục tiêu</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">TÀI KHOẢN TẠM KHÓA</span>
                    <div class="metric-icon-wrapper" style="background: rgba(225, 29, 72, 0.12); color: #e11d48;">
                        <i class="fa-solid fa-rotate-left"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <h3 class="fw-bold mb-0 text-dark">08</h3>
                    <span class="badge-pill-saas badge-locked" style="padding: 2px 8px; font-size: 0.72rem;">Cần xử lý</span>
                </div>
                <div class="text-muted small d-flex justify-content-between align-items-center">
                    <span>Yêu cầu xác minh</span>
                    <a href="javascript:void(0)" onclick="quickFilterLocked()" class="text-primary text-decoration-none fw-semibold">Lọc ngay <i class="fa-solid fa-arrow-right" style="font-size:10px;"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Controls Panel -->
    <div class="glass-panel p-3 mb-4">
        <div class="row g-2 align-items-center mb-3">
            <div class="col-12 col-md-4">
                <div class="position-relative">
                    <i class="fa-solid fa-magnifying-glass position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" id="searchInput" class="form-control form-saas ps-5 pe-5" placeholder="Tìm theo tên, mã KH, email hoặc SĐT..." onkeyup="filterData()">
                    <span class="position-absolute top-50 end-0 translate-middle-y me-3 kbd-shortcut">⌘K</span>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <select id="rankFilter" class="form-select form-saas" onchange="filterData()">
                    <option value="">Hạng: Tất cả</option>
                    <option value="VIP">VIP Tier</option>
                    <option value="Gold">Gold Tier</option>
                    <option value="Standard">Standard Tier</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select id="statusFilter" class="form-select form-saas" onchange="filterData()">
                    <option value="">Trạng thái: Tất cả</option>
                    <option value="Hoạt động">Hoạt động</option>
                    <option value="Đã khóa">Đã khóa</option>
                </select>
            </div>
            <div class="col-12 col-md-4 d-flex align-items-center justify-content-end gap-2">
                <button class="view-btn active" id="btnGrid" onclick="setMode('grid')" title="Dạng Thẻ">
                    <i class="fa-solid fa-border-all"></i>
                </button>
                <button class="view-btn" id="btnCompact" onclick="setMode('compact')" title="Dạng Danh sách">
                    <i class="fa-solid fa-list"></i>
                </button>
                <div class="vr bg-secondary opacity-25 my-1 mx-1"></div>
                <button class="btn btn-glass-secondary form-saas fw-semibold d-flex align-items-center gap-1.5" onclick="triggerToast('Đang mở bộ lọc nâng cao...')">
                    <i class="fa-solid fa-sliders text-muted"></i> Bộ lọc nâng cao
                </button>
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-2 border-top border-secondary border-opacity-10">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button class="filter-tab active" onclick="setQuickTab('all', this)">Tất cả (1,248)</button>
                <button class="filter-tab" onclick="setQuickTab('VIP', this)">VIP Tier (184)</button>
                <button class="filter-tab" onclick="setQuickTab('high_spent', this)">Chi tiêu cao (>10M)</button>
                <button class="filter-tab" onclick="setQuickTab('care', this)">Cần chăm sóc (12)</button>
            </div>
            <button class="btn btn-link text-muted p-0 text-decoration-none small fw-semibold" onclick="resetFilters()">
                <i class="fa-solid fa-rotate-right me-1"></i> Xóa bộ lọc
            </button>
        </div>
    </div>

    <!-- Customer Cards Grid -->
    <div class="row g-3" id="customerContainer">

        <!-- Card 1 -->
        <div class="col-12 col-md-6 col-xl-4 customer-card-wrapper" data-name="Nguyễn Tấn Kỳ" data-id="#KH-1088" data-phone="0901 234 567" data-rank="VIP" data-status="Hoạt động" data-spent="18500000">
            <div class="customer-card">
                <div class="d-flex align-items-start justify-content-between mb-3">
