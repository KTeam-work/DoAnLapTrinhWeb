@model DoAnLapTrinhWeb.Models.Customer

@{
    ViewBag.Title = "Hồ sơ Khách hàng - " + (Model?.full_name ?? "Chi tiết");

    var orders = Model?.Orders?.OrderByDescending(o => o.created_at).ToList() ?? new List<DoAnLapTrinhWeb.Models.Order>();
    decimal totalSpent = orders.Where(o => o.status == "Completed").Sum(o => (decimal?)o.total_amount) ?? 0;
    string rank = (Model?.loyalty_point >= 1000 || totalSpent >= 10000000) ? "VIP" : ((Model?.loyalty_point >= 500 || totalSpent >= 5000000) ? "Gold" : "Standard");
    bool isLocked = Model?.User != null && Model.User.status == "Locked";

    string initials = "KH";
    if (!string.IsNullOrWhiteSpace(Model?.full_name))
    {
        var parts = Model.full_name.Trim().Split(' ');
        initials = parts.Length > 1 ? (parts[parts.Length - 2][0].ToString() + parts[parts.Length - 1][0].ToString()).ToUpper() : parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
    }
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/Css/styleCustomer_Details.css" />

<div class="container-fluid px-4 py-4">

    <!-- Header Navigation -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <a href="@Url.Action("Index", "Customer")" class="btn btn-sm btn-white border rounded-3 px-3 text-dark fw-semibold shadow-sm">
                <i class="fa-solid fa-arrow-left me-1 text-muted"></i> Danh sách
            </a>
            <span class="text-muted">/</span>
            <span class="fw-bold text-dark">Hồ sơ khách hàng #@Model.customer_id.Trim()</span>
            @if (Model.User != null)
            {
                <i class="fa-solid fa-circle-check text-primary ms-1" title="Đã liên kết tài khoản thành viên"></i>
            }
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-primary rounded-3 px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                <i class="fa-solid fa-pen-to-square me-1"></i> Sửa thông tin
            </button>
            <button class="btn btn-sm btn-outline-warning text-dark rounded-3 px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#giftVoucherModal">
                <i class="fa-solid fa-gift me-1 text-danger"></i> Tặng Voucher
            </button>
            @if (Model.User != null)
            {
                <button class="btn btn-sm @(isLocked ? "btn-outline-success" : "btn-outline-danger") rounded-3 px-3 fw-semibold" id="btnToggleLock" onclick="toggleLockCustomer('@Model.customer_id.Trim()')">
                    <i class="fa-solid @(isLocked ? "fa-lock-open" : "fa-user-lock") me-1"></i> @(isLocked ? "Mở khóa tài khoản" : "Khóa tài khoản")
                </button>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Profile -->
        <div class="col-12 col-lg-4">
            <div class="p-4 text-center mb-4 border rounded-4 shadow-sm bg-white">
                <div class="avatar-wrapper mb-3">
                    <div class="avatar-circle mx-auto d-flex align-items-center justify-content-center rounded-circle fw-bold text-primary bg-primary-subtle"
                         style="width: 76px; height: 76px; font-size: 1.6rem;">
                        @initials
                    </div>
                </div>
                <h5 class="fw-bold text-dark mb-1">@Model.full_name</h5>
                <p class="text-muted small mb-3">Thành viên từ @Model.created_at.ToString("dd/MM/yyyy")</p>

                <span class="badge @(rank == "VIP" ? "bg-warning text-dark" : (rank == "Gold" ? "bg-info text-dark" : "bg-light text-secondary border")) px-3 py-2 rounded-pill fw-semibold small d-inline-flex align-items-center gap-1">
                    <i class="fa-solid fa-crown @(rank == "VIP" ? "text-danger" : "text-warning")"></i> @rank Tier Member
                </span>

                <hr class="my-4">

                <div class="text-start d-flex flex-column gap-3">
                    <div class="p-2 rounded-3 bg-light">
                        <label class="text-muted small d-block mb-1">Mã khách hàng</label>
                        <span class="fw-semibold text-dark font-monospace">@Model.customer_id.Trim()</span>
                    </div>
                    <div class="p-2 rounded-3 bg-light">
                        <label class="text-muted small d-block mb-1">Số điện thoại</label>
                        <span class="fw-semibold text-dark"><i class="fa-solid fa-phone text-primary me-2"></i>@(Model.phone ?? "Chưa cập nhật")</span>
                    </div>
                    <div class="p-2 rounded-3 bg-light">
                        <label class="text-muted small d-block mb-1">Email</label>
                        <span class="fw-semibold text-dark"><i class="fa-solid fa-envelope text-primary me-2"></i>@(Model.email ?? "Chưa cập nhật")</span>
                    </div>
                    <div class="p-2 rounded-3 bg-light">
                        <label class="text-muted small d-block mb-1">Ngày sinh (Ưu đãi sinh nhật)</label>
                        <span class="fw-semibold text-dark"><i class="fa-solid fa-cake-candles text-danger me-2"></i>@(Model.birthday.HasValue ? Model.birthday.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</span>
                    </div>
                </div>
            </div>

            <!-- Loyalty Points Box -->
            <div class="p-4 border rounded-4 shadow-sm bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-bold text-dark small text-uppercase">Tích điểm thưởng</span>
                    <i class="fa-solid fa-coins text-warning fs-5"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1 d-inline-block" id="pointsVal">@Model.loyalty_point.ToString("N0") điểm</h3>
                <p class="text-muted small mb-3">Tương đương ~@((Model.loyalty_point * 100).ToString("N0")) đ quy đổi</p>
                <button class="btn btn-sm btn-light border w-100 rounded-3 fw-semibold text-dark" onclick="addPointsAjax('@Model.customer_id.Trim()', 50)">
                    <i class="fa-solid fa-plus me-1 text-primary"></i> Tặng thêm 50 điểm thưởng
                </button>
            </div>
        </div>

        <!-- Main Content Area: Lịch sử đơn hàng & Ví Voucher -->
        <div class="col-12 col-lg-8">
            <!-- 3 Metric Cards -->
            <div class="row g-3 mb-4">
                <div class="col-4">
                    <div class="p-3 border rounded-4 shadow-sm bg-white text-center text-sm-start">
                        <span class="text-muted small d-block mb-1">Tổng chi tiêu</span>
                        <h4 class="fw-bold text-dark mb-0 fs-5 fs-sm-4">@totalSpent.ToString("N0") đ</h4>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-3 border rounded-4 shadow-sm bg-white text-center text-sm-start">
                        <span class="text-muted small d-block mb-1">Tổng đơn mua</span>
                        <h4 class="fw-bold text-primary mb-0 fs-5 fs-sm-4">@orders.Count đơn</h4>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-3 border rounded-4 shadow-sm bg-white text-center text-sm-start">
                        <span class="text-muted small d-block mb-1">Voucher sở hữu</span>
                        <h4 class="fw-bold text-success mb-0 fs-5 fs-sm-4">@(Model.CustomerVouchers?.Count(v => v.status == "Unused") ?? 0) mã</h4>
                    </div>
                </div>
            </div>

            <!-- Tabs: Lịch Sử Mua Hàng & Ví Voucher -->
            <div class="border rounded-4 shadow-sm bg-white p-4">
                <ul class="nav nav-tabs border-bottom mb-3" id="profileTabs">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold text-dark" data-bs-toggle="tab" data-bs-target="#tabOrders">
                            <i class="fa-solid fa-receipt me-1"></i> Lịch Sử Đơn Hàng (@orders.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold text-dark" data-bs-toggle="tab" data-bs-target="#tabVouchers">
                            <i class="fa-solid fa-ticket me-1"></i> Ví Voucher Khách Hàng (@(Model.CustomerVouchers?.Count ?? 0))
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- Tab 1: Đơn Hàng -->
                    <div class="tab-pane fade show active" id="tabOrders">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>MÃ ĐƠN</th>
                                        <th>NGÀY MUA</th>
                                        <th>KÊNH</th>
                                        <th>GIAO HÀNG</th>
                                        <th class="text-end">TỔNG TIỀN</th>
                                        <th class="text-center">TRẠNG THÁI</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (orders.Any())
                                    {
                                        foreach (var o in orders)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">#@o.order_id.Trim()</td>
                                                <td>@o.created_at.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>
                                                    <span class="badge @(o.source == "Online" ? "bg-info-subtle text-info border" : "bg-light text-dark border")">
                                                        @(o.source ?? "POS")
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="text-muted">@(o.delivery_type == "Delivery" ? "Giao hàng" : "Tại quầy")</span>
                                                </td>
                                                <td class="text-end fw-bold text-dark">@o.total_amount.ToString("N0") đ</td>
                                                <td class="text-center">
                                                    @switch (o.status)
                                                    {
                                                        case "Completed":
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Hoàn tất</span>
                                                            break;
                                                        case "Pending":
                                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Chờ duyệt</span>
                                                            break;
                                                        case "Cancelled":
                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã hủy</span>
                                                            break;
                                                        default:
                                                            <span class="badge bg-secondary-subtle text-secondary border">@o.status</span>
                                                            break;
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">Khách hàng chưa phát sinh đơn hàng nào.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tab 2: Ví Voucher -->
                    <div class="tab-pane fade" id="tabVouchers">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>MÃ CODE</th>
                                        <th>LOẠI ƯU ĐÃI</th>
                                        <th>GIÁ TRỊ</th>
                                        <th>NGÀY HẾT HẠN</th>
                                        <th class="text-center">TRẠNG THÁI</th>
                                        <th>NGÀY SỬ DỤNG</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.CustomerVouchers != null && Model.CustomerVouchers.Any())
                                    {
                                        foreach (var cv in Model.CustomerVouchers)
                                        {
                                            var v = cv.Voucher;
                                            <tr>
                                                <td class="fw-bold text-success font-monospace">@(v?.code ?? "VOUCHER")</td>
                                                <td>@(v?.type == "Percent" ? "Giảm theo %" : "Giảm tiền mặt")</td>
                                                <td class="fw-bold">
                                                    @(v?.type == "Percent" ? v.value.ToString("0.##") + "%" : (v?.value ?? 0).ToString("N0") + " đ")
                                                </td>
                                                <td>@(v != null ? v.end_date.ToString("dd/MM/yyyy") : "---")</td>
                                                <td class="text-center">
                                                    @if (cv.status == "Unused")
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Chưa dùng</span>
                                                    }
                                                    else if (cv.status == "Used")
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary border">Đã dùng</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border">Hết hạn</span>
                                                    }
                                                </td>
                                                <td>@(cv.used_at.HasValue ? cv.used_at.Value.ToString("dd/MM/yyyy HH:mm") : "---")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">Khách hàng chưa có mã ưu đãi nào trong ví.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL SỬA THÔNG TIN KHÁCH HÀNG -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark">Chỉnh sửa thông tin khách hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <form id="formEditProfile">
                    <input type="hidden" id="editCustomerId" value="@Model.customer_id.Trim()" />
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" id="editFullName" class="form-control rounded-3" value="@Model.full_name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Số điện thoại</label>
                        <input type="text" id="editPhone" class="form-control rounded-3" value="@Model.phone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Email</label>
                        <input type="email" id="editEmail" class="form-control rounded-3" value="@Model.email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ngày sinh</label>
                        <input type="date" id="editBirthday" class="form-control rounded-3" value="@(Model.birthday.HasValue ? Model.birthday.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-3 px-3" onclick="saveProfileAjax()">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL TẶNG VOUCHER -->
<div class="modal fade" id="giftVoucherModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-gift text-danger me-2"></i>Tặng Voucher Tri Ân</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Chọn mã voucher muốn tặng</label>
                    <select class="form-select rounded-3" id="selectGiftVoucherId">
                        <option value="">-- Đang nạp danh sách voucher --</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-warning rounded-3 px-3 fw-bold text-dark" onclick="sendGiftVoucherAjax('@Model.customer_id.Trim()')">
                    Xác nhận tặng
                </button>
            </div>
        </div>
    </div>
</div>

<!-- JQuery & Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        loadAvailableVouchers();
    });

    // 1. Tải danh sách Voucher còn hiệu lực để đưa vào modal tặng
    function loadAvailableVouchers() {
        $.getJSON('@Url.Action("GetActiveVouchers", "Customer")', function (res) {
            if (res.success && res.data.length > 0) {
                let html = '<option value="">-- Chọn mã voucher --</option>';
                res.data.forEach(v => {
                    html += `<option value="${v.id}">${v.code} - ${v.desc}</option>`;
                });
                $('#selectGiftVoucherId').html(html);
            } else {
                $('#selectGiftVoucherId').html('<option value="">Chưa có voucher khả dụng</option>');
            }
        });
    }

    // 2. Tặng điểm thưởng nhanh
    function addPointsAjax(customerId, points) {
        if (!confirm(`Xác nhận cộng ${points} điểm thưởng cho khách hàng này?`)) return;

        $.post('@Url.Action("AddLoyaltyPoints", "Customer")', { customerId: customerId, points: points }, function (res) {
            if (res.success) {
                alert(res.message);
                location.reload();
            } else {
                alert(res.message);
            }
        });
    }

    // 3. Khóa / Mở khóa tài khoản liên kết
    function toggleLockCustomer(customerId) {
        if (!confirm("Bạn có chắc chắn muốn thay đổi trạng thái khóa/mở khóa tài khoản khách hàng này?")) return;

        $.post('@Url.Action("ToggleLock", "Customer")', { customerId: customerId }, function (res) {
            if (res.success) {
                alert(res.message);
                location.reload();
            } else {
                alert(res.message);
            }
        });
    }

    // 4. Lưu sửa thông tin khách hàng
    function saveProfileAjax() {
        let id = $('#editCustomerId').val();
        let name = $('#editFullName').val();
        let phone = $('#editPhone').val();
        let email = $('#editEmail').val();
        let birthday = $('#editBirthday').val();

        if (!name) { alert("Vui lòng nhập họ tên!"); return; }

        $.post('@Url.Action("UpdateProfile", "Customer")', {
            customerId: id,
            fullName: name,
            phone: phone,
            email: email,
            birthday: birthday
        }, function (res) {
            if (res.success) {
                alert(res.message);
                location.reload();
            } else {
                alert(res.message);
            }
        });
    }

    // 5. Gửi tặng voucher
    function sendGiftVoucherAjax(customerId) {
        let voucherId = $('#selectGiftVoucherId').val();
        if (!voucherId) { alert("Vui lòng chọn 1 mã voucher để tặng!"); return; }

        $.post('@Url.Action("GiftVoucher", "Customer")', { customerId: customerId, voucherId: voucherId }, function (res) {
            if (res.success) {
                alert(res.message);
                location.reload();
            } else {
                alert(res.message);
            }
        });
    }
</script>