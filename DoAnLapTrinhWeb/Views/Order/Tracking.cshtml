@model List<DoAnLapTrinhWeb.Models.OrderStatusHistory>
@{
    ViewBag.Title = "Theo Dõi Đơn Hàng - LumiTea";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string orderId = ViewBag.OrderId as string;
    string currentStatus = ViewBag.Status as string;

    // Các trạng thái trong đơn
    bool isConfirmed = Model.Any(h => h.new_status == "Confirmed");
    bool isPreparing = Model.Any(h => h.new_status == "Preparing" || h.new_status == "Ready");
    bool isDelivering = Model.Any(h => h.new_status == "Delivering");
    bool isCompleted = Model.Any(h => h.new_status == "Completed");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/Css/StyleOrder_Tracking.css" />
</head>
<body>

    <div class="container py-5">
        <div class="row">
            <div class="col-12 col-md-10 col-lg-8 mx-auto">

                <div class="d-flex align-items-center mb-4 gap-3">
                    <a href="~/Order/History" class="text-decoration-none text-muted">
                        <i class="fa-solid fa-arrow-left fs-5"></i>
                    </a>
                    <h2 class="fw-extrabold m-0" style="color: var(--lumitea-primary); letter-spacing: -0.8px;">Mã đơn: #@orderId</h2>
                </div>

                <!-- TRẠNG THÁI TỔNG QUAN -->
                <div class="tracking-card bg-primary-subtle border-0 text-center py-4" style="background-color: rgba(26, 77, 62, 0.05) !important;">
                    <span class="badge bg-white text-dark border px-3 py-2 rounded-pill fs-6 shadow-sm mb-3">
                        <span class="pulse-dot text-success me-1">●</span> Đơn hàng đang ở trạng thái: @currentStatus
                    </span>
                </div>

                <!-- THANH STEPPER (TIMELINE) -->
                <div class="tracking-card py-4 px-2 px-sm-4">
                    <div class="stepper-wrapper my-3">
                        <div class="stepper-item @(isConfirmed ? "completed" : "")">
                            <div class="step-counter"><i class="fa-solid fa-check"></i></div>
                            <div class="step-name">Đã xác nhận</div>
                        </div>
                        <div class="stepper-item @(isPreparing ? "completed" : "")">
                            <div class="step-counter"><i class="fa-solid fa-blender"></i></div>
                            <div class="step-name">Pha chế</div>
                        </div>
                        <div class="stepper-item @(isDelivering ? (isCompleted ? "completed" : "active") : "")">
                            <div class="step-counter"><i class="fa-solid fa-motorcycle"></i></div>
                            <div class="step-name">Đang giao</div>
                        </div>
                        <div class="stepper-item @(isCompleted ? "completed" : "")">
                            <div class="step-counter"><i class="fa-solid fa-house"></i></div>
                            <div class="step-name">Hoàn thành</div>
                        </div>
                    </div>
                </div>

                <!-- XÁC NHẬN NHẬN HÀNG (CHỈ HIỆN KHI ĐANG GIAO) -->
                <div class="tracking-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h6 class="fw-bold mb-2" style="color: var(--lumitea-primary);">Thông tin đơn hàng</h6>
                        <a href="~/Order/Details?id=@orderId" class="btn btn-sm btn-outline-secondary fw-bold rounded-3">
                            Xem biên lai chi tiết
                        </a>
                    </div>

                    @if (currentStatus == "Delivering")
                    {
                        <hr class="text-muted opacity-25 my-4">
                        <form action="/Order/ConfirmReceived" method="POST">
                            <input type="hidden" name="OrderId" value="@orderId" />
                            <button type="submit" class="btn w-100 fw-bold d-flex justify-content-center align-items-center gap-2 shadow-sm"
                                    style="background-color: var(--lumitea-primary); color: white; border-radius: 12px; padding: 14px; font-size: 1.05rem;">
                                <i class="fa-solid fa-box-open"></i> Đã nhận được hàng
                            </button>
                        </form>
                        <p class="text-center text-muted small mt-3 mb-0">
                            <i class="fa-solid fa-circle-info me-1"></i> Vui lòng chỉ bấm xác nhận khi bạn đã nhận đủ món.
                        </p>
                    }
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>