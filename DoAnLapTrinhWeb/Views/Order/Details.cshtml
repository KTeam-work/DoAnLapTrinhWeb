@model DoAnLapTrinhWeb.Controllers.OrderController.OrderDetailViewModel
@{
    ViewBag.Title = "Chi Tiết Đơn Hàng - LumiTea";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Giả định tính phí giao hàng
    decimal shippingFee = Model.DeliveryType == "Delivery" ? 15000 : 0;
    decimal subTotal = Model.Items.Sum(i => i.TotalPrice);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/Css/StyleOrder_Details.css" />
</head>
<body>

    <div class="container py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <a href="~/Order/History" class="text-decoration-none text-muted">
                    <i class="fa-solid fa-arrow-left fs-5"></i>
                </a>
                <div>
                    <h2 class="fw-extrabold m-0" style="color: var(--lumitea-primary); letter-spacing: -0.8px;">
                        Đơn hàng #@Model.OrderId
                    </h2>
                    <span class="text-muted small">Ngày đặt: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>

            <div>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2 fs-6">
                    @Model.Status
                </span>
            </div>
        </div>

        <div class="row g-4">

            <!-- CHI TIẾT MÓN -->
            <div class="col-12 col-lg-8">
                <div class="detail-card">
                    <h5 class="section-title"><i class="fa-solid fa-mug-hot me-2"></i>Chi tiết món ăn</h5>

                    @foreach (var item in Model.Items)
                    {
                        var imgUrl = string.IsNullOrEmpty(item.ImageUrl) ? "~/Assets/default.jpg" : item.ImageUrl;
                        <div class="item-row d-flex gap-3 align-items-start">
                            <img src="@Url.Content(imgUrl)" class="item-img" alt="@item.ProductName">

                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <h6 class="fw-bold text-dark m-0">@item.ProductName</h6>
                                    <span class="fw-bold text-dark">@item.TotalPrice.ToString("N0") đ</span>
                                </div>

                                <div class="text-muted small mt-1 border-start border-2 ps-2 ms-1" style="border-color: var(--lumitea-primary) !important;">
                                    <div>Ly cơ bản: @item.UnitPrice.ToString("N0") đ</div>
                                    <div>Size @item.SizeName</div>
                                    @if (item.ToppingNames != null && item.ToppingNames.Any())
                                    {
                                        foreach (var t in item.ToppingNames)
                                        {
                                            <div>+ @t</div>
                                        }
                                    }
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="text-muted small fst-italic">Ghi chú: @item.Note</span>
                                    <span class="badge bg-light text-dark border">SL: @item.Quantity</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- TỔNG TIỀN VÀ THANH TOÁN -->
                <div class="detail-card bg-light border-0">
                    <div class="d-flex justify-content-between mb-2 text-muted">
                        <span>Tổng tiền hàng (@Model.Items.Count món)</span>
                        <span class="fw-medium text-dark">@subTotal.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-muted">
                        <span>Phí giao hàng</span>
                        <span class="fw-medium text-dark">@shippingFee.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Voucher áp dụng</span>
                        <span class="fw-medium text-success">- @Model.DiscountAmount.ToString("N0") đ</span>
                    </div>
                    <hr class="text-muted opacity-25">
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="fw-bold fs-6">TỔNG CỘNG</span>
                        <span class="fw-extrabold fs-4 text-danger" style="color: var(--lumitea-primary) !important;">
                            @Model.TotalAmount.ToString("N0") <span class="fs-5 text-decoration-underline fw-normal">đ</span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- THÔNG TIN KHÁCH & TIMELINE -->
            <div class="col-12 col-lg-4">

                <!-- THÔNG TIN GIAO HÀNG -->
                <div class="detail-card">
                    <h5 class="section-title"><i class="fa-solid fa-address-card me-2"></i>Thông tin nhận hàng</h5>
                    <div class="d-flex flex-column gap-3">
                        <div>
                            <div class="text-muted small mb-1">Khách hàng</div>
                            <div class="fw-semibold text-dark">@Model.CustomerName</div>
                        </div>
                        <div>
                            <div class="text-muted small mb-1">Số điện thoại</div>
                            <div class="fw-semibold text-dark">@Model.CustomerPhone</div>
                        </div>
                        <div>
                            <div class="text-muted small mb-1">Giao đến</div>
                            <div class="fw-semibold text-dark">@(Model.DeliveryType == "Delivery" ? "Theo địa chỉ khách" : "Nhận tại cửa hàng")</div>
                        </div>
                        <div>
                            <div class="text-muted small mb-1">Phương thức thanh toán</div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid @(Model.PaymentMethod == "Cash" ? "fa-money-bill-wave" : "fa-building-columns") text-primary"></i>
                                <span class="fw-semibold text-dark">@Model.PaymentMethod</span>
                                @if (Model.PaymentStatus == "Paid")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill ms-auto">Đã thanh toán</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill ms-auto">Chưa thanh toán</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TIMELINE -->
                <div class="detail-card">
                    <h5 class="section-title"><i class="fa-solid fa-clock-rotate-left me-2"></i>Tiến trình đơn hàng</h5>
                    <ul class="timeline m-0">
                        @if (Model.StatusHistories != null && Model.StatusHistories.Any())
                        {
                            foreach (var h in Model.StatusHistories)
                            {
                                <li class="timeline-item active">
                                    <div class="timeline-marker"></div>
                                    <div class="timeline-content">
                                        <div class="timeline-title mb-1">@h.new_status</div>
                                        <div class="text-muted small opacity-75" style="font-size: 0.75rem;">@h.changed_at.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>