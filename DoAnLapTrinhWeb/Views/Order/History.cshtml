@{
    ViewBag.Title = "Lịch Sử Đơn Hàng - LumiTea";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --lumitea-primary: #1A4D3E;
            --lumitea-accent: #F6C90E;
            --lumitea-bg: #F8FAFC;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--lumitea-bg);
        }

        .history-tabs .nav-link {
            color: #64748B;
            font-weight: 600;
            border-radius: 20px;
            padding: 8px 20px;
            margin-right: 10px;
            border: 1px solid transparent;
            transition: all 0.2s ease;
        }

            .history-tabs .nav-link:hover {
                background-color: #f1f5f9;
            }

            .history-tabs .nav-link.active {
                background-color: var(--lumitea-primary);
                color: white;
                box-shadow: 0 4px 10px rgba(26, 77, 62, 0.2);
            }

        .order-card {
            background: #fff;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            padding: 1.25rem;
            margin-bottom: 1rem;
            transition: box-shadow 0.2s ease, transform 0.2s ease;
        }

            .order-card:hover {
                box-shadow: 0 8px 20px rgba(0,0,0,0.04);
                transform: translateY(-2px);
            }

        .order-header {
            border-bottom: 1px dashed #e2e8f0;
            padding-bottom: 1rem;
            margin-bottom: 1rem;
        }

        .product-preview-img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 10px;
            background-color: #f1f5f9;
        }

        .btn-reorder {
            background-color: var(--lumitea-accent);
            color: #000;
            font-weight: 700;
            border: none;
            border-radius: 10px;
            padding: 8px 20px;
            transition: all 0.2s;
        }

            .btn-reorder:hover {
                background-color: #e5b905;
            }

        .btn-detail {
            color: var(--lumitea-primary);
            font-weight: 600;
            background: rgba(26, 77, 62, 0.05);
            border: none;
            border-radius: 10px;
            padding: 8px 20px;
            transition: background 0.2s;
        }

            .btn-detail:hover {
                background: rgba(26, 77, 62, 0.1);
            }
    </style>
</head>
<body>

    <div class="container py-4">
        <div class="d-flex align-items-center mb-4 gap-3">
            <a href="~/Menu/Index" class="text-decoration-none text-muted">
                <i class="fa-solid fa-arrow-left fs-5"></i>
            </a>
            <h2 class="fw-extrabold m-0" style="color: var(--lumitea-primary); letter-spacing: -0.8px;">Lịch sử đơn hàng</h2>
        </div>

        <!-- THANH LỌC -->
        <ul class="nav nav-pills history-tabs mb-4 pb-2 border-bottom overflow-auto flex-nowrap" style="white-space: nowrap;">
            <li class="nav-item">
                <a class="nav-link active" href="#">Tất cả</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Đang xử lý</a> 
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Đã hoàn thành</a> 
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Đã hủy</a> 
            </li>
        </ul>

        <div class="row">
            <div class="col-12 col-lg-9 mx-auto mx-lg-0">

                <!-- VÒNG LẶP foreach (var order in Model)  -->

                            <!-- 1 -->
                            <div class="order-card">
                                <div class="order-header d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="fw-bold text-dark fs-6">#ORD-1082</span>
                                        <span class="text-muted small ms-2"><i class="fa-regular fa-clock me-1"></i>21/09/2026 11:42</span>
                                    </div>
                                    
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">
                                        Đang giao hàng
                                    </span>
                                </div>

                                <div class="d-flex gap-3 align-items-center mb-3">
                                    <img src="~/Assets/o_long_sua_nuong.jpg" class="product-preview-img" alt="Thumbnail">
                                    <div class="flex-grow-1">
                                       
                                        <h6 class="fw-bold text-dark m-0 mb-1">Trà Sữa Ô Long Nướng <span class="fw-normal text-muted small">và 2 món khác</span></h6>
                                        <div class="text-muted small">Giao hàng tận nơi • Thanh toán Momo</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted small mb-1">Tổng tiền</div>
                                        <div class="fw-extrabold fs-5 text-danger" style="color: var(--lumitea-primary) !important;">153.000 đ</div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end gap-2 mt-2">
                                    <a href="~/Order/Tracking" class="btn btn-detail">
                                        <i class="fa-solid fa-location-dot me-1"></i> Theo dõi đơn
                                    </a>
                                    <a href="~/Order/Details" class="btn btn-reorder" style="background-color: var(--lumitea-primary); color: white;">
                                        Xem chi tiết
                                    </a>
                                </div>
                            </div>

                            <!-- 2 -->
                            <div class="order-card opacity-75">
                                <div class="order-header d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="fw-bold text-dark fs-6">#ORD-1005</span>
                                        <span class="text-muted small ms-2"><i class="fa-regular fa-clock me-1"></i>18/09/2026 15:20</span>
                                    </div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                        Đã hoàn thành
                                    </span>
                                </div>

                                <div class="d-flex gap-3 align-items-center mb-3">
                                    <img src="~/Assets/tra_sua_chan_chau_duong_den.jpg" class="product-preview-img" alt="Thumbnail">
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold text-dark m-0 mb-1">Sữa Tươi Trân Châu Đường Đen <span class="fw-normal text-muted small">và 1 món khác</span></h6>
                                        <div class="text-muted small">Nhận tại cửa hàng • Tiền mặt</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted small mb-1">Tổng tiền</div>
                                        <div class="fw-extrabold fs-5 text-dark">95.000 đ</div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end gap-2 mt-2">
                                    <a href="~/Order/Details" class="btn btn-detail">Xem chi tiết</a>
                                    <!-- QUAY LẠI GIỎI HÀNG MUA TIẾP -->
                                    <button type="button" class="btn btn-reorder">Mua lại đơn này</button>
                                </div>
                            </div>

                            <!-- 3 -->
                            <div class="order-card opacity-50">
                                <div class="order-header d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="fw-bold text-dark fs-6">#ORD-0988</span>
                                        <span class="text-muted small ms-2"><i class="fa-regular fa-clock me-1"></i>15/09/2026 09:10</span>
                                    </div>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                        Đã hủy
                                    </span>
                                </div>

                                <div class="d-flex gap-3 align-items-center mb-3">
                                    <img src="https://via.placeholder.com/150/E2E8F0/1A4D3E?text=Tra+Xoai" class="product-preview-img" alt="Thumbnail" style="filter: grayscale(100%);">
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold text-dark m-0 mb-1">Trà Xoài Nhài Kem Cheese</h6>
                                        <div class="text-muted small text-danger fst-italic">Lý do: Hết mứt xoài tươi</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted small mb-1">Tổng tiền</div>
                                        <div class="fw-extrabold fs-5 text-dark">45.000 đ</div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end gap-2 mt-2">
                                    <a href="~/Order/Details" class="btn btn-detail">Xem chi tiết</a>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
                </body>
                </html>
