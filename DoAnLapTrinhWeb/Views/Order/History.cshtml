@model List<DoAnLapTrinhWeb.Controllers.OrderController.OrderHistoryViewModel>
@{
    ViewBag.Title = "Lịch Sử Đơn Hàng - LumiTea";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="~/Css/StyleOrder_History.css" rel="stylesheet" />
</head>
<body>

    <div class="container py-4">
        <div class="d-flex align-items-center mb-4 gap-3">
            <a href="~/Menu/Index" class="text-decoration-none text-muted">
                <i class="fa-solid fa-arrow-left fs-5"></i>
            </a>
            <h2 class="fw-extrabold m-0" style="color: var(--lumitea-primary); letter-spacing: -0.8px;">Lịch sử đơn hàng</h2>
        </div>

        <!-- THANH LỌC (Sẽ dùng JS để lọc các card sau) -->
        <ul class="nav nav-pills history-tabs mb-4 pb-2 border-bottom overflow-auto flex-nowrap" style="white-space: nowrap;">
            <li class="nav-item"><a class="nav-link active" href="#">Tất cả</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Đang xử lý</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Đã hoàn thành</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Đã hủy</a></li>
        </ul>

        <div class="row">
            <div class="col-12 col-lg-9 mx-auto mx-lg-0">

                @if (Model == null || !Model.Any())
                {
                    <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
                        <p class="text-muted">Bạn chưa có đơn hàng nào.</p>
                        <a href="~/Menu/Index" class="btn text-white fw-bold px-4 py-2 rounded-pill" style="background-color: var(--lumitea-primary);">Đặt món ngay</a>
                    </div>
                }
                else
                {
                    foreach (var order in Model)
                    {
                        var isCompleted = order.Status == "Completed";
                        var isCancelled = order.Status == "Cancelled";
                        var opacityClass = isCancelled ? "opacity-50" : (isCompleted ? "opacity-75" : "");

                        <div class="order-card @opacityClass">
                            <div class="order-header d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold text-dark fs-6">#@order.OrderId</span>
                                    <span class="text-muted small ms-2"><i class="fa-regular fa-clock me-1"></i>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>

                                @if (isCancelled)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">Đã hủy</span>
                                }
                                else if (isCompleted)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Đã hoàn thành</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">@order.Status</span>
                                }
                            </div>

                            <div class="d-flex gap-3 align-items-center mb-3">
                                @{ var imgUrl = string.IsNullOrEmpty(order.FirstProductImageUrl) ? "~/Assets/default.jpg" : order.FirstProductImageUrl; }
                                <img src="@Url.Content(imgUrl)" class="product-preview-img" alt="Thumbnail" style="@(isCancelled ? "filter: grayscale(100%);" : "")">
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold text-dark m-0 mb-1">
                                        @order.FirstProductName
                                        @if (order.OtherProductCount > 0)
                                        {
                                            <span class="fw-normal text-muted small">và @order.OtherProductCount món khác</span>
                                        }
                                    </h6>
                                    <div class="text-muted small">
                                        @(order.DeliveryType == "Delivery" ? "Giao hàng tận nơi" : "Nhận tại cửa hàng")
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="text-muted small mb-1">Tổng tiền</div>
                                    <div class="fw-extrabold fs-5 @(isCancelled ? "text-dark" : "text-danger")" style="@(isCancelled ? "" : "color: var(--lumitea-primary) !important;")">@order.TotalAmount.ToString("N0") đ</div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-2">
                                @if (!isCancelled && !isCompleted)
                                {
                                    <a href="~/Order/Tracking?id=@order.OrderId" class="btn btn-detail">
                                        <i class="fa-solid fa-location-dot me-1"></i> Theo dõi đơn
                                    </a>
                                }
                                <a href="~/Order/Details?id=@order.OrderId" class="btn btn-reorder" style="background-color: var(--lumitea-primary); color: white;">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>