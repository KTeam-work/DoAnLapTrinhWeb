@model DoAnLapTrinhWeb.Controllers.OrderController.CheckoutViewModel
@{
    ViewBag.Title = "Thanh Toán - LumiTea";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Phí giao hàng giả định (nếu có thể thay đổi tùy logic)
    decimal shippingFee = 15000;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/Css/StyleOrder_Checkout.css" />
</head>
<body>

    <div class="container py-4">
        <div class="d-flex align-items-center mb-4 gap-3">
            <a href="~/Cart/Index" class="text-decoration-none text-muted">
                <i class="fa-solid fa-arrow-left fs-5"></i>
            </a>
            <h2 class="fw-extrabold m-0" style="color: var(--lumitea-primary); letter-spacing: -0.8px;">Tiến hành thanh toán</h2>
        </div>
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Lỗi đặt hàng!</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <form action="/Order/Create" method="POST" id="checkoutForm">
            <!-- Lưu VoucherId và DiscountAmount để gửi lên Controller ở Bước 2 -->
            <input type="hidden" name="VoucherId" id="VoucherId" value="" />
            <input type="hidden" name="DiscountAmount" id="DiscountAmount" value="0" />

            <div class="row g-4">

                <!-- NHẬP THÔNG TIN GIAO HÀNG -->
                <div class="col-12 col-lg-7">

                    <!-- HÌNH THỨC NHẬN HÀNG -->
                    <div class="checkout-section">
                        <h5 class="section-title"><i class="fa-solid fa-truck-fast"></i> Hình thức nhận hàng</h5>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="w-100 h-100 m-0">
                                    <input type="radio" name="DeliveryType" id="DeliveryTypeDelivery" class="form-check-input" value="Delivery" checked>
                                    <div class="method-card d-flex flex-column align-items-center text-center justify-content-center">
                                        <i class="fa-solid fa-motorcycle fs-3 mb-2 text-dark"></i>
                                        <span class="fw-bold text-dark">Giao hàng tận nơi</span>
                                        <i class="fa-solid fa-circle-check position-absolute top-0 end-0 m-2 check-icon fs-5"></i>
                                    </div>
                                </label>
                            </div>
                            <div class="col-6">
                                <label class="w-100 h-100 m-0">
                                    <input type="radio" name="DeliveryType" id="DeliveryTypePickup" class="form-check-input" value="Pickup">
                                    <div class="method-card d-flex flex-column align-items-center text-center justify-content-center">
                                        <i class="fa-solid fa-store fs-3 mb-2 text-dark"></i>
                                        <span class="fw-bold text-dark">Nhận tại cửa hàng</span>
                                        <i class="fa-solid fa-circle-check position-absolute top-0 end-0 m-2 check-icon fs-5"></i>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- THÔNG TIN NGƯỜI NHẬN (Hiển thị dữ liệu Mock từ ViewModel) -->
                    <div class="checkout-section">
                        <h5 class="section-title"><i class="fa-solid fa-address-card"></i> Thông tin người nhận</h5>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold small">Họ và tên *</label>
                                <input type="text" class="form-control" name="FullName" value="@Model.FullName" placeholder="Nhập họ tên" required>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold small">Số điện thoại *</label>
                                <input type="tel" class="form-control" name="Phone" value="@Model.Phone" placeholder="Nhập số điện thoại" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Email (Tùy chọn)</label>
                                <input type="email" class="form-control" name="Email" value="@Model.Email" placeholder="Để nhận hóa đơn điện tử">
                            </div>
                            <div class="col-12" id="addressContainer">
                                <label class="form-label fw-semibold small">Địa chỉ giao hàng *</label>
                                <input type="text" class="form-control" name="Address" value="@Model.Address" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Ghi chú đơn hàng</label>
                                <textarea class="form-control" name="OrderNote" rows="2" placeholder="Hướng dẫn giao hàng, thời gian nhận..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- PHƯƠNG THỨC THANH TOÁN -->
                    <div class="checkout-section">
                        <h5 class="section-title"><i class="fa-solid fa-wallet"></i> Phương thức thanh toán</h5>
                        <div class="d-flex flex-column gap-3">
                            <label class="w-100 m-0 position-relative">
                                <input type="radio" name="PaymentMethod" class="form-check-input" value="Cash" checked>
                                <div class="method-card d-flex align-items-center gap-3">
                                    <i class="fa-solid fa-money-bill-wave fs-4 text-success"></i>
                                    <div>
                                        <div class="fw-bold text-dark">Tiền mặt (COD)</div>
                                        <div class="small text-muted">Thanh toán khi nhận hàng</div>
                                    </div>
                                    <i class="fa-solid fa-circle-check position-absolute top-50 end-0 translate-middle-y me-3 check-icon fs-5"></i>
                                </div>
                            </label>

                            <label class="w-100 m-0 position-relative">
                                <input type="radio" name="PaymentMethod" class="form-check-input" value="Banking">
                                <div class="method-card d-flex align-items-center gap-3">
                                    <i class="fa-solid fa-building-columns fs-4 text-primary"></i>
                                    <div>
                                        <div class="fw-bold text-dark">Chuyển khoản ngân hàng</div>
                                        <div class="small text-muted">Quét mã QR (Napas 247)</div>
                                    </div>
                                    <i class="fa-solid fa-circle-check position-absolute top-50 end-0 translate-middle-y me-3 check-icon fs-5"></i>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- TÓM TẮT ĐƠN HÀNG & MÃ GIẢM GIÁ -->
                <div class="col-12 col-lg-5">
                    <div class="summary-box shadow-sm">
                        <h5 class="fw-bold mb-4 border-bottom pb-3" style="color: var(--lumitea-primary);">Món đã chọn</h5>

                        <!-- DANH SÁCH MÓN TỪ GIỎ HÀNG -->
                        <div class="d-flex flex-column gap-3 mb-4">
                            @foreach (var item in Model.CartItems)
                            {
                                <div class="d-flex justify-content-between align-items-start border-bottom pb-2">
                                    <div class="d-flex gap-2">
                                        <span class="fw-bold text-dark">@item.Quantity x</span>
                                        <div>
                                            <div class="fw-semibold text-dark">@item.ProductName</div>
                                            <div class="small text-muted">
                                                Size @item.SizeName
                                                @if (item.Toppings != null && item.Toppings.Any())
                                                {
                                                    @:, @string.Join(", ", item.Toppings.Select(t => t.ToppingName))
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(item.Note))
                                            {
                                                <div class="small fst-italic text-muted">(@item.Note)</div>
                                            }
                                        </div>
                                    </div>
                                    <span class="fw-medium text-dark text-nowrap">@item.TotalPrice.ToString("N0") đ</span>
                                </div>
                            }
                        </div>

                        <!-- VOUCHER SECTION -->
                        <div class="input-group mb-3">
                            <input type="text" class="form-control bg-light border-end-0" id="voucherCode" placeholder="Nhập mã ưu đãi (Ví dụ: GIAM20)">
                            <button class="btn border border-start-0 bg-light fw-bold" style="color: var(--lumitea-primary);" type="button" id="btnApplyVoucher">Áp dụng</button>
                        </div>
                        <div id="voucherMessage" class="small mb-3"></div>

                        <hr class="text-muted opacity-25">

                        <!-- TÍNH TOÁN CHI PHÍ -->
                        <input type="hidden" id="TotalAmountBase" value="@Model.TotalAmount" />

                        <div class="d-flex justify-content-between mb-2 text-muted small">
                            <span>Tổng tiền hàng</span>
                            <span class="fw-semibold text-dark">@Model.TotalAmount.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-muted small">
                            <span id="shippingLabel">Phí giao hàng (Giao tận nơi)</span>
                            <span class="fw-semibold text-dark" id="shippingFeeDisplay">@shippingFee.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-muted small">
                            <span>Giảm giá Voucher</span>
                            <span class="fw-semibold text-success" id="discountDisplay">- 0 đ</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mb-4">
                            <span class="fw-bold fs-6">Thành tiền</span>
                            <span class="fw-extrabold fs-4 text-danger" id="finalAmountDisplay" style="color: var(--lumitea-primary) !important;">
                                @((Model.TotalAmount + shippingFee).ToString("N0")) <span class="fs-5 text-decoration-underline fw-normal">đ</span>
                            </span>
                        </div>

                        <button type="submit" class="btn btn-submit-order w-100 fs-5 text-white fw-bold py-3 rounded-3" style="background-color: var(--lumitea-primary);">
                            ĐẶT HÀNG
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {

            var totalAmountBase = parseFloat($('#TotalAmountBase').val());
            var currentShippingFee = 15000;
            var currentDiscount = 0;

            function updateFinalAmount() {
                var finalTotal = totalAmountBase + currentShippingFee - currentDiscount;
                if (finalTotal < 0) finalTotal = 0;

                $('#finalAmountDisplay').html(finalTotal.toLocaleString('vi-VN') + ' <span class="fs-5 text-decoration-underline fw-normal">đ</span>');
            }

            // XỬ LÝ ẨN/HIỆN PHÍ SHIP THEO HÌNH THỨC GIAO HÀNG
            $('input[name="DeliveryType"]').change(function () {
                var deliveryType = $(this).val();
                if (deliveryType === 'Pickup') {
                    $('#addressContainer').hide();
                    $('#addressContainer input').removeAttr('required');

                    currentShippingFee = 0;
                    $('#shippingLabel').text('Phí giao hàng (Nhận tại cửa hàng)');
                    $('#shippingFeeDisplay').text('0 đ');
                } else {
                    $('#addressContainer').show();
                    $('#addressContainer input').attr('required', 'required');

                    currentShippingFee = 15000;
                    $('#shippingLabel').text('Phí giao hàng (Giao tận nơi)');
                    $('#shippingFeeDisplay').text('15.000 đ');
                }
                updateFinalAmount();
            });

            // XỬ LÝ AJAX APPLY VOUCHER
            $('#btnApplyVoucher').click(function () {
                var code = $('#voucherCode').val().trim();
                if (code === '') {
                    $('#voucherMessage').html('<span class="text-danger">Vui lòng nhập mã giảm giá!</span>');
                    return;
                }

                $.ajax({
                    url: '/Order/CheckVoucher',
                    type: 'POST',
                    data: { code: code, totalAmount: totalAmountBase },
                    success: function (res) {
                        if (res.success) {
                            $('#voucherMessage').html('<span class="text-success"><i class="fa-solid fa-check-circle me-1"></i>' + res.message + '</span>');

                            currentDiscount = res.discountAmount;
                            $('#discountDisplay').text('- ' + currentDiscount.toLocaleString('vi-VN') + ' đ');

                            // Lưu vào input ẩn để đẩy lên Controller khi submit
                            $('#VoucherId').val(res.voucherId);
                            $('#DiscountAmount').val(currentDiscount);

                            updateFinalAmount();
                        } else {
                            $('#voucherMessage').html('<span class="text-danger"><i class="fa-solid fa-circle-xmark me-1"></i>' + res.message + '</span>');

                            // Reset voucher nếu nhập sai mã mới
                            currentDiscount = 0;
                            $('#discountDisplay').text('- 0 đ');
                            $('#VoucherId').val('');
                            $('#DiscountAmount').val('0');

                            updateFinalAmount();
                        }
                    },
                    error: function () {
                        $('#voucherMessage').html('<span class="text-danger">Lỗi kết nối máy chủ!</span>');
                    }
                });
            });
        });
    </script>
</body>
</html>