@{
    ViewBag.Title = "Thanh Toán - LumiTea";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --lumitea-primary: #1A4D3E;
            --lumitea-accent: #F6C90E;
            --lumitea-bg: #F8FAFC;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--lumitea-bg);
        }

        .checkout-section {
            background: #fff;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .section-title {
            color: var(--lumitea-primary);
            font-weight: 800;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        
        .method-card {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            height: 100%;
        }

            .method-card:hover {
                border-color: #cbd5e1;
                background-color: #f8fafc;
            }

        .form-check-input[type="radio"] {
            display: none;
        }

            .form-check-input[type="radio"]:checked + .method-card {
                border-color: var(--lumitea-primary);
                background-color: rgba(26, 77, 62, 0.05);
                box-shadow: 0 4px 12px rgba(26, 77, 62, 0.1);
            }

                .form-check-input[type="radio"]:checked + .method-card .check-icon {
                    color: var(--lumitea-primary);
                    opacity: 1;
                }

        .check-icon {
            opacity: 0;
            transition: opacity 0.2s;
        }

        .summary-box {
            background: #fff;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            padding: 1.5rem;
            position: sticky;
            top: 20px;
        }

        .btn-submit-order {
            background-color: var(--lumitea-accent);
            color: #000;
            font-weight: 700;
            border: none;
            border-radius: 12px;
            padding: 14px;
            transition: all 0.2s;
        }

            .btn-submit-order:hover {
                background-color: #e5b905;
                transform: translateY(-2px);
            }
    </style>
</head>
<body>

    <div class="container py-4">
        <div class="d-flex align-items-center mb-4 gap-3">
            <a href="~/Cart/Index" class="text-decoration-none text-muted">
                <i class="fa-solid fa-arrow-left fs-5"></i>
            </a>
            <h2 class="fw-extrabold m-0" style="color: var(--lumitea-primary); letter-spacing: -0.8px;">Tiến hành thanh toán</h2>
        </div>

        <!--  -->
        <form action="/Order/Create" method="POST">
            <div class="row g-4">

                <!-- NHẬP THÔNG TIN -->
                <div class="col-12 col-lg-7">

                    <!-- HÌNH THỨC  NHẬN -->
                    <div class="checkout-section">
                        <h5 class="section-title"><i class="fa-solid fa-truck-fast"></i> Hình thức nhận hàng</h5>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="w-100 h-100 m-0">
                                    <input type="radio" name="DeliveryType" class="form-check-input" value="Delivery" checked>
                                    <div class="method-card d-flex flex-column align-items-center text-center justify-content-center">
                                        <i class="fa-solid fa-motorcycle fs-3 mb-2 text-dark"></i>
                                        <span class="fw-bold text-dark">Giao hàng tận nơi</span>
                                        <i class="fa-solid fa-circle-check position-absolute top-0 end-0 m-2 check-icon fs-5"></i>
                                    </div>
                                </label>
                            </div>
                            <div class="col-6">
                                <label class="w-100 h-100 m-0">
                                    <input type="radio" name="DeliveryType" class="form-check-input" value="Pickup">
                                    <div class="method-card d-flex flex-column align-items-center text-center justify-content-center">
                                        <i class="fa-solid fa-store fs-3 mb-2 text-dark"></i>
                                        <span class="fw-bold text-dark">Nhận tại cửa hàng</span>
                                        <i class="fa-solid fa-circle-check position-absolute top-0 end-0 m-2 check-icon fs-5"></i>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- THÔNG TIN KHÁCH -->
                    <div class="checkout-section">
                        <h5 class="section-title"><i class="fa-solid fa-address-card"></i> Thông tin người nhận</h5>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold small">Họ và tên *</label>
                                <input type="text" class="form-control" name="FullName" placeholder="Nhập họ tên" required>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold small">Số điện thoại *</label>
                                <input type="tel" class="form-control" name="Phone" placeholder="Nhập số điện thoại" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Email (Tùy chọn)</label>
                                <input type="email" class="form-control" name="Email" placeholder="Để nhận hóa đơn điện tử">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Địa chỉ giao hàng *</label>
                                <input type="text" class="form-control" name="Address" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Ghi chú đơn hàng (Orders.note)</label>
                                <textarea class="form-control" name="OrderNote" rows="2" placeholder="Hướng dẫn giao hàng, thời gian nhận..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- PHƯƠNG THỨC -->
                    <div class="checkout-section">
                        <h5 class="section-title"><i class="fa-solid fa-wallet"></i> Phương thức thanh toán</h5>
                        <div class="d-flex flex-column gap-3">

                            <label class="w-100 m-0 position-relative">
                                <input type="radio" name="PaymentMethod" class="form-check-input" value="Cash" checked>
                                <div class="method-card d-flex align-items-center gap-3">
                                    <i class="fa-solid fa-money-bill-wave fs-4 text-success"></i>
                                    <div>
                                        <div class="fw-bold text-dark">Tiền mặt (COD)</div>
                                        <div class="small text-muted">Thanh toán khi nhận hàng</div>
                                    </div>
                                    <i class="fa-solid fa-circle-check position-absolute top-50 end-0 translate-middle-y me-3 check-icon fs-5"></i>
                                </div>
                            </label>

                            <label class="w-100 m-0 position-relative">
                                <input type="radio" name="PaymentMethod" class="form-check-input" value="Banking">
                                <div class="method-card d-flex align-items-center gap-3">
                                    <i class="fa-solid fa-building-columns fs-4 text-primary"></i>
                                    <div>
                                        <div class="fw-bold text-dark">Chuyển khoản ngân hàng</div>
                                        <div class="small text-muted">Quét mã QR (Napas 247)</div>
                                    </div>
                                    <i class="fa-solid fa-circle-check position-absolute top-50 end-0 translate-middle-y me-3 check-icon fs-5"></i>
                                </div>
                            </label>

                            <label class="w-100 m-0 position-relative">
                                <input type="radio" name="PaymentMethod" class="form-check-input" value="EWallet">
                                <div class="method-card d-flex align-items-center gap-3">
                                    <i class="fa-solid fa-qrcode fs-4" style="color: #A50064;"></i>
                                    <div>
                                        <div class="fw-bold text-dark">Ví điện tử MoMo / ZaloPay</div>
                                        <div class="small text-muted">Mở ứng dụng để thanh toán</div>
                                    </div>
                                    <i class="fa-solid fa-circle-check position-absolute top-50 end-0 translate-middle-y me-3 check-icon fs-5"></i>
                                </div>
                            </label>

                        </div>
                    </div>

                </div>

                <!-- TÓM TẮT ĐƠN HÀNG -->
                <div class="col-12 col-lg-5">
                    <div class="summary-box shadow-sm">
                        <h5 class="fw-bold mb-4 border-bottom pb-3" style="color: var(--lumitea-primary);">Món đã chọn</h5>

                        <!--  -->
                        <div class="d-flex flex-column gap-3 mb-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="d-flex gap-2">
                                    <span class="fw-bold text-dark">1x</span>
                                    <div>
                                        <div class="fw-semibold text-dark">Trà Sữa Ô Long Nướng</div>
                                        <div class="small text-muted">Size M, Trân châu đen, Kem Cheese</div>
                                    </div>
                                </div>
                                <span class="fw-medium text-dark text-nowrap">58.000 đ</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-start">
                                <div class="d-flex gap-2">
                                    <span class="fw-bold text-dark">2x</span>
                                    <div>
                                        <div class="fw-semibold text-dark">Sữa Tươi Trân Châu Đường Đen</div>
                                        <div class="small text-muted">Size S</div>
                                    </div>
                                </div>
                                <span class="fw-medium text-dark text-nowrap">80.000 đ</span>
                            </div>
                        </div>

                        <hr class="text-muted opacity-25">

                        <!-- GIÁ -->
                        <div class="d-flex justify-content-between mb-2 text-muted small">
                            <span>Tổng tiền hàng</span>
                            <span class="fw-semibold text-dark">138.000 đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-muted small">
                            <span>Phí giao hàng (Giao tận nơi)</span>
                            <span class="fw-semibold text-dark">15.000 đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-muted small">
                            <span>Giảm giá</span>
                            <span class="fw-semibold text-success">- 0 đ</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mb-4">
                            <span class="fw-bold fs-6">Thành tiền</span>
                            <span class="fw-extrabold fs-4 text-danger" style="color: var(--lumitea-primary) !important;">
                                153.000 <span class="fs-5 text-decoration-underline fw-normal">đ</span>
                            </span>
                        </div>

                        <button type="submit" class="btn btn-submit-order w-100 fs-5">
                            Đặt Hàng
                        </button>

                        <p class="text-center text-muted small mt-3 mb-0">
                            Bằng việc đặt hàng, bạn đồng ý với Điều khoản của LumiTea
                        </p>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    // CHUYỂN QUA LẠI GIỜ 2 PHƯƠNG THỨC GIAO 
    document.addEventListener("DOMContentLoaded", function () {
        const deliveryRadios = document.querySelectorAll('input[name="DeliveryType"]');
        const addressInput = document.querySelector('input[name="Address"]').closest('.col-12');

        deliveryRadios.forEach(radio => {
            radio.addEventListener('change', function() {
                if (this.value === 'Pickup') {
                    addressInput.style.display = 'none';
                    addressInput.querySelector('input').removeAttribute('required');
                } else {
                    addressInput.style.display = 'block';
                    addressInput.querySelector('input').setAttribute('required', 'required');
                }
            });
        });
    });
    </script>
</body>
</html>