@model IEnumerable<DoAnLapTrinhWeb.Models.Voucher>

@{
    ViewBag.Title = "Quản Lý Mã Giảm Giá";
    var now = DateTime.Now;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LumiTea - Quản Lý Mã Giảm Giá</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <!-- Google Font: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/Css/styleVoucher.css" rel="stylesheet" />
</head>
<body>

    <div class="container-fluid px-4 py-4">

        <!-- 1. HEADER SECTION -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h3 class="fw-bold mb-1" style="color: var(--lumitea-primary);">
                    <i class="fa-solid fa-ticket me-2" style="color: var(--lumitea-accent);"></i>Quản Lý Voucher & Khuyến Mãi
                </h3>
                <p class="text-muted small mb-0">Tạo, thiết lập điều kiện và theo dõi hiệu suất các chương trình ưu đãi LumiTea</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-lumitea-primary" data-bs-toggle="modal" data-bs-target="#createVoucherModal">
                    <i class="fa-solid fa-plus me-1"></i> Tạo Voucher Mới
                </button>
            </div>
        </div>

        <!-- 2. KPI METRICS CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="kpi-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-title">Tổng Chương Trình</div>
                            <div class="kpi-value" id="countTotal">@(ViewBag.TotalCount ?? 0)</div>
                        </div>
                        <div class="kpi-icon-wrap"><i class="fa-solid fa-tags"></i></div>
                    </div>
                    <div class="mt-3 fs-7 text-muted">Đã khởi tạo trong hệ thống</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="kpi-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-title">Đang Hoạt Động</div>
                            <div class="kpi-value text-success" id="countActive">@(ViewBag.ActiveCount ?? 0)</div>
                        </div>
                        <div class="kpi-icon-wrap" style="background: rgba(16, 185, 129, 0.1); color: #10B981;"><i class="fa-solid fa-circle-play"></i></div>
                    </div>
                    <div class="mt-3 fs-7 text-muted"><span class="pulse-dot me-1"></span> Khách hàng đang áp dụng</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="kpi-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-title">Tổng Lượt Đã Dùng</div>
                            <div class="kpi-value text-primary">@string.Format("{0:N0}", ViewBag.UsedCount ?? 0)</div>
                        </div>
                        <div class="kpi-icon-wrap" style="background: rgba(59, 130, 246, 0.1); color: #2563EB;"><i class="fa-solid fa-users-check"></i></div>
                    </div>
                    <div class="mt-3 fs-7 text-muted">Lượt áp dụng đơn thành công</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="kpi-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-title">Sắp Diễn Ra</div>
                            <div class="kpi-value text-info">@(ViewBag.UpcomingCount ?? 0)</div>
                        </div>
                        <div class="kpi-icon-wrap" style="background: rgba(2, 132, 199, 0.1); color: #0284C7;"><i class="fa-solid fa-clock"></i></div>
                    </div>
                    <div class="mt-3 fs-7 text-muted">Đã lên lịch chờ kích hoạt</div>
                </div>
            </div>
        </div>

        <!-- 3. FILTER & SEARCH BAR -->
        <div class="kpi-card mb-4" style="padding: 16px 20px;">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-3 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" id="searchInput" class="form-control border-start-0 rounded-end-3" placeholder="Tìm theo mã voucher (VD: GIAMGIA10)..." style="box-shadow: none;">
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select id="filterStatus" class="form-select rounded-3">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="active">Đang chạy (Active)</option>
                        <option value="upcoming">Sắp diễn ra</option>
                        <option value="paused">Tạm dừng</option>
                        <option value="expired">Đã hết hạn</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select id="filterType" class="form-select rounded-3">
                        <option value="">-- Loại ưu đãi --</option>
                        <option value="percent">Giảm theo %</option>
                        <option value="fixed">Giảm tiền cố định</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 text-end">
                    <button class="btn btn-action-outline w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate-right me-1"></i> Đặt Lại</button>
                </div>
            </div>
        </div>

        <!-- 4. VOUCHER CARDS GRID (ĐỔ DỮ LIỆU THẬT) -->
        <div class="row g-3" id="voucherContainer">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    var isPercent = item.type == "Percent";
                    var isExpired = item.end_date < now;
                    var isUpcoming = item.start_date > now;
                    var isPaused = item.status != "Active";
                    var isActive = !isPaused && !isExpired && !isUpcoming;

                    string statusKey = isPaused ? "paused" : (isExpired ? "expired" : (isUpcoming ? "upcoming" : "active"));
                    string typeKey = isPercent ? "percent" : "fixed";

                    <div class="col-12 col-md-6 col-xl-4 voucher-item @(isPaused ? "opacity-75" : "")"
                         data-code="@item.code.ToLower()"
                         data-status="@statusKey"
                         data-type="@typeKey">
                        <div class="voucher-ticket-card">
                            <!-- Bên trái thẻ -->
                            <div class="voucher-left @(isPercent ? "bg-emerald" : "bg-blue")">
                                <div class="discount-badge">
                                    @(isPercent ? item.value.ToString("0.##") + "%" : (item.value >= 1000 ? (item.value / 1000).ToString("0.##") + "K" : item.value.ToString("N0") + "đ"))
                                </div>
                                <div class="discount-type">
                                    @(isPercent ? "Giảm %" : "Giảm thẳng")
                                </div>
                            </div>

                            <!-- Bên phải thẻ -->
                            <div class="voucher-right">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    @if (isPaused)
                                    {
                                        <span class="status-pill status-paused"><span class="dot"></span> Tạm dừng</span>
                                    }
                                    else if (isUpcoming)
                                    {
                                        <span class="status-pill status-upcoming"><span class="dot"></span> Sắp diễn ra</span>
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="status-pill status-paused"><span class="dot"></span> Đã hết hạn</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-active"><span class="dot"></span> Đang chạy</span>
                                    }

                                    <div class="dropdown">
                                        <button class="btn btn-sm text-muted p-0 border-0" data-bs-toggle="dropdown"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm fs-7">
                                            <li>
                                                <a class="dropdown-item" href="javascript:void(0)" onclick="toggleStatus('@item.voucher_id.Trim()')">
                                                    <i class="fa-solid @(item.status == "Active" ? "fa-pause" : "fa-play") me-2"></i>@(item.status == "Active" ? "Tạm dừng" : "Tiếp tục chạy")
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item text-danger" href="javascript:void(0)" onclick="deleteVoucher('@item.voucher_id.Trim()')">
                                                    <i class="fa-solid fa-trash me-2"></i>Xóa
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <h6 class="voucher-title text-truncate" title="@item.code">Mã ưu đãi: @item.code</h6>
                                <p class="voucher-desc">Đơn tối thiểu: <strong>@item.min_order_amount.ToString("N0")đ</strong></p>

                                <div class="code-box-wrap mb-2">
                                    <span class="code-text">@item.code</span>
                                    <button class="btn-copy" onclick="copyToClipboard('@item.code')"><i class="fa-regular fa-copy"></i></button>
                                </div>

                                <div class="voucher-footer text-muted d-flex justify-content-between">
                                    <span><i class="fa-regular fa-calendar-check me-1"></i>Từ: @item.start_date.ToString("dd/MM/yy")</span>
                                    <span><i class="fa-regular fa-clock me-1"></i>Đến: @item.end_date.ToString("dd/MM/yy")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-5">
                    <i class="fa-solid fa-ticket-simple display-4 mb-3 text-secondary"></i>
                    <p>Chưa có mã voucher nào. Bấm <b>"Tạo Voucher Mới"</b> để tạo mã đầu tiên!</p>
                </div>
            }
        </div>
    </div>

    <!-- MODAL TẠO VOUCHER MỚI -->
    <div class="modal fade" id="createVoucherModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold" style="color: var(--lumitea-primary);">
                        <i class="fa-solid fa-ticket me-2" style="color: var(--lumitea-accent);"></i>Tạo Mã Khuyến Mãi Mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-4">
                    <form id="formCreateVoucher">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold fs-7">Mã Voucher (Code) <span class="text-danger">*</span></label>
                                <input type="text" id="voucherCode" class="form-control rounded-3 text-uppercase fw-bold" placeholder="VD: GIAMGIA20K" required style="letter-spacing: 1px;">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold fs-7">Loại Giảm Giá</label>
                                <select class="form-select rounded-3" id="modalDiscountType">
                                    <option value="Fixed">Giảm tiền cố định (VNĐ)</option>
                                    <option value="Percent">Giảm theo phần trăm (%)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold fs-7" id="lblDiscountValue">Giá Trị Giảm (VNĐ) <span class="text-danger">*</span></label>
                                <input type="number" id="voucherValue" class="form-control rounded-3" placeholder="VD: 20000" min="1" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold fs-7">Đơn Hàng Tối Thiểu (VNĐ)</label>
                                <input type="number" id="voucherMinOrder" class="form-control rounded-3" placeholder="VD: 50000" min="0" value="0">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold fs-7">Ngày Bắt Đầu <span class="text-danger">*</span></label>
                                <input type="datetime-local" id="voucherStartDate" class="form-control rounded-3" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold fs-7">Ngày Kết Thúc <span class="text-danger">*</span></label>
                                <input type="datetime-local" id="voucherEndDate" class="form-control rounded-3" required>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-action-outline px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-lumitea-primary px-4" onclick="saveVoucher()">Lưu & Kích Hoạt</button>
                </div>
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        <div id="liveToast" class="toast align-items-center text-white bg-dark border-0 rounded-3 shadow" role="alert">
            <div class="d-flex">
                <div class="toast-body" id="toastMessage">Đã thực hiện thao tác!</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <!-- JQuery & Bootstrap 5 Bundle -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // 1. Tự động đổi label gợi ý khi đổi loại giảm giá
        document.getElementById("modalDiscountType").addEventListener("change", function () {
            const lblValue = document.getElementById("lblDiscountValue");
            const valInput = document.getElementById("voucherValue");

            if (this.value === "Percent") {
                lblValue.innerHTML = 'Giá Trị Giảm (%) <span class="text-danger">*</span>';
                valInput.placeholder = "VD: 20 (cho 20%)";
                valInput.max = "100";
            } else {
                lblValue.innerHTML = 'Giá Trị Giảm (VNĐ) <span class="text-danger">*</span>';
                valInput.placeholder = "VD: 20000";
                valInput.removeAttribute("max");
            }
        });

        // 2. Tìm kiếm và Lọc trên thẻ Voucher
        function filterVouchers() {
            const query = $('#searchInput').val().toLowerCase().trim();
            const statusVal = $('#filterStatus').val();
            const typeVal = $('#filterType').val();

            $('.voucher-item').each(function () {
                const code = $(this).data('code') || '';
                const status = $(this).data('status');
                const type = $(this).data('type');

                const matchSearch = code.indexOf(query) > -1;
                const matchStatus = !statusVal || status === statusVal;
                const matchType = !typeVal || type === typeVal;

                $(this).toggle(matchSearch && matchStatus && matchType);
            });
        }

        $('#searchInput').on('input', filterVouchers);
        $('#filterStatus').on('change', filterVouchers);
        $('#filterType').on('change', filterVouchers);

        function resetFilters() {
            $('#searchInput').val('');
            $('#filterStatus').val('');
            $('#filterType').val('');
            filterVouchers();
        }

        // 3. Sao chép mã
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                showToast(`Đã sao chép mã: ${text}`);
            });
        }

        function showToast(msg) {
            document.getElementById('toastMessage').innerText = msg;
            new bootstrap.Toast(document.getElementById('liveToast')).show();
        }

        // 4. Lưu Voucher mới qua AJAX
        function saveVoucher() {
            let code = $('#voucherCode').val().trim();
            let type = $('#modalDiscountType').val();
            let value = parseFloat($('#voucherValue').val()) || 0;
            let minOrder = parseFloat($('#voucherMinOrder').val()) || 0;
            let startDate = $('#voucherStartDate').val();
            let endDate = $('#voucherEndDate').val();

            if (!code) { alert("Vui lòng nhập mã Voucher!"); return; }
            if (value <= 0) { alert("Vui lòng nhập giá trị giảm giá hợp lệ!"); return; }
            if (type === 'Percent' && value > 100) { alert("Giảm giá theo phần trăm không được vượt quá 100%!"); return; }
            if (!startDate || !endDate) { alert("Vui lòng chọn ngày bắt đầu và kết thúc!"); return; }
            if (new Date(endDate) <= new Date(startDate)) { alert("Ngày kết thúc phải lớn hơn ngày bắt đầu!"); return; }

            $.ajax({
                url: '@Url.Action("Create", "Voucher")',
                type: 'POST',
                data: {
                    code: code,
                    type: type,
                    value: value,
                    min_order_amount: minOrder,
                    start_date: startDate,
                    end_date: endDate
                },
                success: function (res) {
                    if (res.success) {
                        alert(res.message);
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert("Lỗi kết nối máy chủ khi lưu voucher.");
                }
            });
        }

        // 5. Tạm dừng / Tiếp tục chạy mã
        function toggleStatus(id) {
            $.post('@Url.Action("ToggleStatus", "Voucher")', { id: id }, function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        }

        // 6. Xóa mã
        function deleteVoucher(id) {
            if (!confirm("Bạn có chắc chắn muốn xóa mã voucher này?")) return;
            $.post('@Url.Action("Delete", "Voucher")', { id: id }, function (res) {
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        }
    </script>
</body>
</html>