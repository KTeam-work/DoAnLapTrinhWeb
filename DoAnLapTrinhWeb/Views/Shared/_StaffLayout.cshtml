<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LumiTea Nhân Viên</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- CSS riêng cho thanh Navbar -->
    <link rel="stylesheet" href="~/Css/styleNavbar.css" />
    <style>
        /* Đảm bảo thanh navbar không cắt cụt menu thả xuống */
        .admin-navbar, .navbar-inner, .navbar-right {
            overflow: visible !important;
        }

        /* Định vị cho khối account */
        .account.dropdown {
            position: relative;
        }

            /* TẠO CẦU NỐI VÔ HÌNH: Tránh mất chuột khi rê từ nút xuống menu */
            .account.dropdown::after {
                content: "";
                position: absolute;
                top: 100%;
                left: 0;
                width: 100%;
                height: 12px; /* Lấp đầy khoảng trống giữa nút và menu */
                display: block;
            }

            /* Menu thả xuống cố định vị trí sát mép */
            .account.dropdown .dropdown-menu {
                margin-top: 0 !important;
                top: 100% !important;
                right: 0 !important;
                left: auto !important;
                z-index: 99999 !important;
                min-width: 210px;
            }

                /* Hỗ trợ cả 2 cơ chế: Bấm click (.show) HOẶC Rê chuột (:hover) đều giữ chặt menu */
                .account.dropdown:hover .dropdown-menu,
                .account.dropdown .dropdown-menu.show {
                    display: block !important;
                    opacity: 1 !important;
                    visibility: visible !important;
                    transform: none !important;
                    pointer-events: auto !important;
                }

            /* Đảm bảo các item bên trong nhận sự kiện click chuột */
            .account.dropdown .dropdown-item {
                cursor: pointer;
                pointer-events: auto !important;
            }

        #staffDropdownMenu {
            cursor: pointer;
            z-index: 10;
        }
    </style>
</head>

<body>

    <!-- =====================================================
         NAVBAR VẬN HÀNH CA TRỰC (DÀNH CHO NHÂN VIÊN)
    ====================================================== -->
    <nav class="admin-navbar">
        <div class="navbar-inner">

            <!-- ==================== MENU BÊN TRÁI ==================== -->
            <div class="menu-side left">
                <div class="main-menu">

                    <!-- VỀ TRANG BÁN HÀNG NGOÀI MENU -->
                    <div class="menu-item">
                        <a href="@Url.Action("Index", "Home")" class="menu-link">
                            <i class="bi bi-house-door"></i>
                            <span>Trang chủ</span>
                        </a>
                    </div>

                    <!-- TIẾP NHẬN & DUYỆT ĐƠN HÀNG (TRỌNG TÂM CỦA NHÂN VIÊN) -->
                    <div class="menu-item">
                        <a href="#" class="menu-link">
                            <i class="bi bi-receipt"></i>
                            <span>Đơn hàng</span>
                            <i class="bi bi-chevron-down arrow"></i>
                        </a>
                        <div class="dropdown-menu-custom">
                            <div class="dropdown-title">Xử lý đơn</div>
                            <a href="@Url.Action("Index", "Order")" class="dropdown-link">
                                <i class="bi bi-clock-history"></i> Lịch sử đơn hàng
                            </a>
                        </div>
                    </div>

                    <!-- TRA CỨU KHÁCH TÍCH ĐIỂM TẠI QUẦY -->
                    <div class="menu-item">
                        <a href="@Url.Action("Index", "Customer")" class="menu-link">
                            <i class="bi bi-people"></i>
                            <span>Khách hàng</span>
                        </a>
                    </div>

                </div>
            </div>

            <!-- ==================== LOGO GIỮA ==================== -->
            <a href="@Url.Action("Index", "Order")" class="brand">
                <div class="brand-icon">
                    <i class="bi bi-cup-hot-fill"></i>
                </div>
                <div class="brand-text">
                    <span class="brand-name">LumiTea</span>
                    <span class="brand-sub">Nhân Viên</span>
                </div>
            </a>

            <!-- ==================== MENU BÊN PHẢI ==================== -->
            <div class="menu-side right">
                <div class="main-menu">

                    <!-- KIỂM KÊ KHO CA TRỰC -->
                    <div class="menu-item">
                        <!-- Đổi từ "Inventory" sang "Ingredient" -->
                        <a href="@Url.Action("Index", "Ingredient")" class="menu-link">
                            <i class="bi bi-box-seam"></i>
                            <span>Tồn kho nguyên liệu</span>
                        </a>
                    </div>

                    <!-- LỊCH CA LÀM VIỆC CỦA BẢN THÂN -->
                    <div class="menu-item">
                        <a href="@Url.Action("Index", "Shift")" class="menu-link">
                            <i class="bi bi-calendar-week"></i>
                            <span>Lịch làm việc</span>
                        </a>
                    </div>

                    <!-- GÓC TÀI KHOẢN NHÂN VIÊN -->
                    <div class="navbar-right">
                        <div class="notification">
                            <i class="bi bi-bell"></i>
                            <span class="notification-badge">3</span>
                        </div>

                        <div class="account dropdown">
                            <button class="btn border-0 p-0 d-flex align-items-center bg-transparent shadow-none"
                                    type="button"
                                    id="staffDropdownMenu"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <div class="avatar" style="background-color: #2e7d32; color: #fff; font-weight: 700; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                    NV
                                </div>
                                <div class="account-info ms-2 text-start">
                                    <div class="account-name text-white fw-semibold small">
                                        @(Session["FullName"] ?? Session["Username"] ?? "Nhân viên")
                                    </div>
                                    <div class="account-role text-white-50" style="font-size: 0.75rem;">Nhân viên quầy</div>
                                </div>
                                <i class="bi bi-chevron-down account-arrow ms-2 text-white small"></i>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="staffDropdownMenu">
                                <li>
                                    <a class="dropdown-item py-2" href="@Url.Action("Index", "Profile")">
                                        <i class="bi bi-person me-2"></i> Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" href="@Url.Action("ChangePassword", "Profile")">
                                        <i class="bi bi-key me-2"></i> Đổi mật khẩu
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger" href="@Url.Action("Logout", "Account")">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </nav>

    <!-- =====================================================
         NỘI DUNG CHÍNH CỦA CÁC TRANG CON
    ====================================================== -->
    <main class="p-0">
        @RenderBody()
    </main>
    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>