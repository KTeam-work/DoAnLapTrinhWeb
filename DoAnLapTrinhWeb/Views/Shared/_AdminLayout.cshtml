@using DoAnLapTrinhWeb.Models
@{
    // Lấy Role và Tên hiển thị từ Session
    string userRole = (Session["UserRole"]?.ToString() ?? "").Trim();
    bool isAdmin = (userRole == "R01" || userRole.Equals("Admin", StringComparison.OrdinalIgnoreCase));
    string displayName = Session["FullName"]?.ToString() ?? (Session["Username"]?.ToString() ?? "Quản trị viên");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LumiTea Quản Trị</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- CSS GỐC CHO NAVBAR XANH RÊU + LOGO TRÒN TRẮNG Ở GIỮA -->
    <link rel="stylesheet" href="~/Css/styleNavbar.css" />
</head>

<body>

    <!-- =====================================================
         NAVBAR QUẢN TRỊ XANH RÊU - LOGO TRẮNG Ở GIỮA
    ====================================================== -->
    <nav class="admin-navbar">
        <div class="navbar-inner">

            <!-- ==================== MENU BÊN TRÁI ==================== -->
            <div class="menu-side left">
                <div class="main-menu">

                    <!-- DASHBOARD -->
                    <div class="menu-item">
                        <a href="@Url.Action("Index", "Dashboard")" class="menu-link">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </div>

                    <!-- SẢN PHẨM & MENU (DÀNH CHO ADMIN) -->
                    <div class="menu-item">
                        <a href="#" class="menu-link">
                            <i class="bi bi-cup-hot"></i>
                            <span>Sản phẩm</span>
                            <i class="bi bi-chevron-down arrow"></i>
                        </a>
                        <div class="dropdown-menu-custom">
                            <div class="dropdown-title">Sản phẩm & Đồ uống</div>
                            <a href="@Url.Action("Index", "Product")" class="dropdown-link">
                                <i class="bi bi-grid"></i> Danh sách món
                            </a>
                            <a href="@Url.Action("Index", "Category")" class="dropdown-link">
                                <i class="bi bi-tags"></i> Danh mục
                            </a>
                            <a href="@Url.Action("Index", "Size")" class="dropdown-link">
                                <i class="bi bi-arrows-angle-expand"></i> Size sản phẩm
                            </a>
                            <a href="@Url.Action("Index", "Topping")" class="dropdown-link">
                                <i class="bi bi-plus-circle"></i> Topping
                            </a>
                        </div>
                    </div>

                    <!-- ĐƠN HÀNG -->
                    <div class="menu-item">
                        <a href="#" class="menu-link">
                            <i class="bi bi-receipt"></i>
                            <span>Đơn hàng</span>
                            <i class="bi bi-chevron-down arrow"></i>
                        </a>
                        <div class="dropdown-menu-custom">
                            <div class="dropdown-title">Đơn hàng</div>
                            <a href="@Url.Action("POS", "Order")" class="dropdown-link fw-bold text-success">
                                <i class="bi bi-pc-display-horizontal"></i> Bán hàng tại quầy
                            </a>
                            <a href="@Url.Action("Index", "Order")" class="dropdown-link">
                                <i class="bi bi-receipt"></i> Tất cả đơn hàng
                            </a>
                            <a href="@Url.Action("Index", "Order", new { status = "Pending" })" class="dropdown-link">
                                <i class="bi bi-hourglass-split"></i> Đơn cần xử lý
                            </a>
                        </div>
                    </div>

                    <!-- KHÁCH HÀNG -->
                    <div class="menu-item">
                        <a href="#" class="menu-link">
                            <i class="bi bi-people"></i>
                            <span>Khách hàng</span>
                            <i class="bi bi-chevron-down arrow"></i>
                        </a>
                        <div class="dropdown-menu-custom">
                            <div class="dropdown-title">Khách hàng</div>
                            <a href="@Url.Action("Index", "Customer")" class="dropdown-link">
                                <i class="bi bi-person-lines-fill"></i> Danh sách khách hàng
                            </a>
                            <a href="@Url.Action("Index", "Review")" class="dropdown-link">
                                <i class="bi bi-star"></i> Đánh giá sản phẩm
                            </a>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ==================== KHỐI LOGO TRẮNG Ở CHÍNH GIỮA ==================== -->
            <a href="@Url.Action("Index", "Dashboard")" class="brand">
                <div class="brand-icon">
                    <i class="bi bi-cup-hot-fill"></i>
                </div>
                <div class="brand-text">
                    <span class="brand-name">LumiTea</span>
                    <span class="brand-sub">Quản Trị</span>
                </div>
            </a>

            <!-- ==================== MENU BÊN PHẢI ==================== -->
            <div class="menu-side right">
                <div class="main-menu">

                    <!-- KHO NGUYÊN LIỆU -->
                    <div class="menu-item">
                        <a href="#" class="menu-link">
                            <i class="bi bi-box-seam"></i>
                            <span>Kho</span>
                            <i class="bi bi-chevron-down arrow"></i>
                        </a>
                        <div class="dropdown-menu-custom">
                            <div class="dropdown-title">Quản lý kho</div>
                            <a href="@Url.Action("Index", "Inventory")" class="dropdown-link">
                                <i class="bi bi-arrow-left-right"></i> Nhập / Xuất kho
                            </a>
                            <a href="@Url.Action("Index", "Ingredient")" class="dropdown-link">
                                <i class="bi bi-box"></i> Nguyên liệu
                            </a>
                            <a href="@Url.Action("Index", "Recipe")" class="dropdown-link">
                                <i class="bi bi-journal-text"></i> Công thức pha chế
                            </a>
                        </div>
                    </div>

                    <!-- KHUYẾN MÃI -->
                    <div class="menu-item">
                        <a href="#" class="menu-link">
                            <i class="bi bi-ticket-perforated"></i>
                            <span>Khuyến mãi</span>
                            <i class="bi bi-chevron-down arrow"></i>
                        </a>
                        <div class="dropdown-menu-custom">
                            <div class="dropdown-title">Khuyến mãi</div>
                            <a href="@Url.Action("Index", "Voucher")" class="dropdown-link">
                                <i class="bi bi-ticket"></i> Quản lý Voucher
                            </a>
                        </div>
                    </div>

                    <!-- HỆ THỐNG / VẬN HÀNH -->
                    <div class="menu-item">
                        <a href="#" class="menu-link">
                            <i class="bi bi-gear"></i>
                            <span>Hệ thống</span>
                            <i class="bi bi-chevron-down arrow"></i>
                        </a>
                        <div class="dropdown-menu-custom">
                            <div class="dropdown-title">Vận hành</div>
                            <a href="@Url.Action("Index", "Shift")" class="dropdown-link">
                                <i class="bi bi-calendar2-check"></i> Ca làm việc
                            </a>
                            <a href="@Url.Action("Index", "Employee")" class="dropdown-link">
                                <i class="bi bi-person-badge"></i> Quản lý Nhân sự
                            </a>
                            <a href="@Url.Action("Index", "Statistics")" class="dropdown-link">
                                <i class="bi bi-bar-chart-line"></i> Báo cáo thống kê
                            </a>
                        </div>
                    </div>

                    <!-- KHU VỰC TÀI KHOẢN ADMIN (AVATAR VÀNG HOẶC ĐỎ) -->
                    <div class="navbar-right">
                        <div class="notification">
                            <i class="bi bi-bell"></i>
                            <span class="notification-badge">3</span>
                        </div>

                        <div class="account dropdown">
                            <div class="d-flex align-items-center" data-bs-toggle="dropdown" style="cursor: pointer;">
                                <div class="avatar" style="background-color: #f1b44c; color: #1e1e2d; font-weight: 700;">
                                    AD
                                </div>
                                <div class="account-info ms-2">
                                    <div class="account-name">@displayName</div>
                                    <div class="account-role">Quản trị viên</div>
                                </div>
                                <i class="bi bi-chevron-down account-arrow ms-2"></i>
                            </div>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li>
                                    <a class="dropdown-item py-2" href="@Url.Action("Index", "Profile")">
                                        <i class="bi bi-person me-2"></i> Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" href="@Url.Action("ChangePassword", "Profile")">
                                        <i class="bi bi-key me-2"></i> Đổi mật khẩu
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger" href="@Url.Action("Logout", "Account")">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </nav>

    <!-- =====================================================
         NỘI DUNG CHÍNH CÁC VIEW CON
    ====================================================== -->
    <main class="p-0">
        @RenderBody()
    </main>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>