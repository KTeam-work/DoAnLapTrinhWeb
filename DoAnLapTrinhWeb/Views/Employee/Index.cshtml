@model IEnumerable<DoAnLapTrinhWeb.Models.User>

@{
    ViewBag.Title = "Quản lý Nhân viên";
    var roles = ViewBag.Roles as List<DoAnLapTrinhWeb.Models.Role> ?? new List<DoAnLapTrinhWeb.Models.Role>();
}

<!-- Fonts & FontAwesome -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/Css/StyleEmployee.css" />

<div class="container-fluid px-4 py-4">

    <!-- Thông báo nếu có -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 1. Header & Breadcrumb -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h1 class="page-title mb-1">Danh sách Nhân viên</h1>
            <div class="breadcrumb-custom">
                <i class="fa-solid fa-house"></i>
                <span>/</span>
                <span>Nhân sự</span>
                <span>/</span>
                <span class="text-dark fw-semibold">Quản lý nhân viên</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Shift")" class="btn-action-outline text-decoration-none">
                <i class="fa-solid fa-calendar-days text-success me-1"></i> Lịch Phân Ca
            </a>
            <button class="btn-add-glow" data-bs-toggle="modal" data-bs-target="#createEmployeeModal">
                <i class="fa-solid fa-plus"></i> Thêm Nhân Viên
            </button>
        </div>
    </div>

    <!-- 2. Hero Banner & Search Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-4 p-md-5 hero-banner position-relative overflow-hidden">
                <div class="position-absolute hero-orb-1"></div>
                <div class="position-absolute hero-orb-2"></div>

                <div class="row align-items-center position-relative z-1 g-4">
                    <div class="col-lg-7">
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-25 backdrop-blur mb-3 text-white fs-7 border border-white border-opacity-25 shadow-sm">
                            <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #34d399;"></span>
                            Hệ thống Quản trị Nhân sự & Ca làm LumiTea
                        </div>
                        <h3 class="fw-bold text-white mb-2">Quản Lý Đội Ngũ Nhân Viên</h3>
                        <p class="text-white mb-0 fs-6" style="opacity: 0.85;">Tìm kiếm, phân quyền tài khoản và theo dõi trạng thái hoạt động của nhân viên toàn hệ thống.</p>
                    </div>

                    <div class="col-lg-5">
                        <div class="d-flex flex-column gap-2">
                            <div class="input-group shadow-lg rounded-3 overflow-hidden bg-white p-1">
                                <span class="input-group-text bg-transparent border-0 text-muted ps-3">
                                    <i class="fa-solid fa-magnifying-glass fs-6"></i>
                                </span>
                                <input type="text" id="tableSearchInput" onkeyup="filterTable()" class="form-control border-0 shadow-none ps-2 fs-6" placeholder="Tìm tên, username, email, SĐT..." aria-label="Search">
                                <button class="btn btn-primary px-4 fw-semibold rounded-2" type="button" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none;">
                                    Tìm kiếm
                                </button>
                            </div>

                            <div class="d-flex align-items-center justify-content-between px-2 text-white small mt-1" style="opacity: 0.85;">
                                <span><i class="fa-solid fa-bolt text-warning me-1"></i> Số lượng nhân sự</span>
                                <span><i class="fa-solid fa-users me-1"></i> @(Model?.Count() ?? 0) Nhân viên</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- 3. Main Data Table Card -->
    <div class="app-card">

        <!-- Filter Controls Bar -->
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small fw-bold text-uppercase"><i class="fa-solid fa-filter text-success me-1"></i> BỘ LỌC:</span>
            </div>

            <div class="d-flex align-items-center gap-3 flex-wrap">
                <!-- Dropdown Vị Trí -->
                <select id="roleFilter" onchange="filterTable()" class="form-select border-0 bg-light text-muted fw-semibold shadow-sm" style="border-radius: 10px; font-size: 0.90rem; min-width: 180px; padding: 10px 16px;">
                    <option value="">Tất cả vị trí</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r.role_name">@r.role_name</option>
                    }
                </select>

                <!-- Dropdown Trạng Thái -->
                <select id="statusFilter" onchange="filterTable()" class="form-select border-0 bg-light text-muted fw-semibold shadow-sm" style="border-radius: 10px; font-size: 0.90rem; min-width: 180px; padding: 10px 16px;">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active">Đang hoạt động</option>
                    <option value="locked">Tạm khóa</option>
                </select>
            </div>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>NHÂN VIÊN</th>
                        <th>CHỨC VỤ</th>
                        <th>TÀI KHOẢN</th>
                        <th>EMAIL</th>
                        <th>SỐ ĐIỆN THOẠI</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody id="employeeTableBody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var roleName = item.Role != null ? item.Role.role_name : "N/A";
                            var roleClass = "default";
                            if (roleName.Contains("Admin") || roleName.Contains("Quản lý")) { roleClass = "manager"; }
                            else if (roleName.Contains("Pha chế") || roleName.Contains("Staff")) { roleClass = "barista"; }
                            else if (roleName.Contains("Thu ngân")) { roleClass = "cashier"; }

                            var isActive = item.status == "Active";

                            string initials = "NV";
                            if (!string.IsNullOrWhiteSpace(item.full_name))
                            {
                                var parts = item.full_name.Trim().Split(' ');
                                initials = parts.Length > 1
                                    ? (parts[parts.Length - 2][0].ToString() + parts[parts.Length - 1][0].ToString()).ToUpper()
                                    : parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
                            }

                            <tr class="employee-row" data-role="@roleName" data-status="@(isActive ? "active" : "locked")">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle fw-bold d-flex align-items-center justify-content-center" style="width:38px; height:38px; background: #d1fae5; color: #047857; font-size: 0.85rem;">
                                            @initials
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.full_name</div>
                                            <div class="text-muted font-monospace" style="font-size: 0.75rem;">ID: #@item.user_id.Trim()</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="role-badge @roleClass">@roleName</span></td>
                                <td><span class="fw-semibold text-secondary font-monospace small">@item.username</span></td>
                                <td><a href="mailto:@item.email" class="text-success text-decoration-none fw-medium">@(item.email ?? "---")</a></td>
                                <td class="text-muted fw-medium">@(string.IsNullOrEmpty(item.phone) ? "---" : item.phone)</td>
                                <td>
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input status-switch" type="checkbox" @(isActive ? "checked" : "") onchange="toggleStatus('@item.user_id.Trim()')">
                                    </div>
                                </td>
                                <td class="text-end">
                                    <button class="action-btn-pill delete" onclick="deleteEmployee('@item.user_id.Trim()')" title="Xóa nhân viên">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Chưa có dữ liệu nhân sự. Bấm "Thêm Nhân Viên" để tạo mới!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        <div class="pagination-wrapper mt-3">
            <span class="text-muted small">Hiển thị <strong>1 - @(Model?.Count() ?? 0)</strong> trong số <strong>@(Model?.Count() ?? 0)</strong> nhân viên</span>
        </div>

    </div>
</div>

<!-- =========================================================================
     MODAL THÊM NHÂN VIÊN MỚI
========================================================================= -->
<div class="modal fade" id="createEmployeeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);">
            <form action="@Url.Action("Create", "Employee")" method="post">
                <div class="modal-header px-4 pt-4 border-0">
                    <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-user-plus text-success me-2"></i>Thêm Nhân Viên Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 py-3">

                    <!-- 1. Họ và tên -->
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">HỌ VÀ TÊN <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" class="form-control bg-light" style="border-radius: 10px; padding: 10px; border: 1px solid #e2e8f0;" placeholder="Nhập họ và tên..." required />
                    </div>

                    <!-- 2. Chức vụ / Vai trò -->
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">CHỨC VỤ / VAI TRÒ <span class="text-danger">*</span></label>
                        <select name="RoleId" class="form-select bg-light text-dark fw-medium" style="border-radius: 10px; padding: 10px; border: 1px solid #e2e8f0;" required>
                            <option value="" disabled selected>-- Chọn vị trí công việc --</option>
                            @if (roles.Any())
                            {
                                foreach (var role in roles)
                                {
                                    <option value="@role.role_id.Trim()">@role.role_name (@role.description)</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- 3. Số điện thoại -->
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">SỐ ĐIỆN THOẠI</label>
                        <input type="text" name="Phone" class="form-control bg-light" style="border-radius: 10px; padding: 10px; border: 1px solid #e2e8f0;" placeholder="Ví dụ: 0901234567" />
                    </div>

                    <!-- 4. Email Tài Khoản -->
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">EMAIL TÀI KHOẢN</label>
                        <input type="email" name="Email" class="form-control bg-light" style="border-radius: 10px; padding: 10px; border: 1px solid #e2e8f0;" placeholder="nhanvien@lumitea.com" />
                    </div>

                    <div class="p-2 rounded bg-light border text-muted small">
                        <i class="fa-solid fa-info-circle me-1 text-primary"></i> <b>Lưu ý:</b> Tài khoản đăng nhập sẽ tự động lấy theo tên email, mật khẩu khởi tạo mặc định là <b>123456</b>.
                    </div>

                </div>
                <div class="modal-footer px-4 pb-4 border-0">
                    <button type="button" class="btn btn-light fw-semibold" data-bs-dismiss="modal" style="border-radius: 10px;">Hủy</button>
                    <button type="submit" class="btn-add-glow">Lưu Thông Tin</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    // 1. Tìm kiếm và lọc
    function filterTable() {
        let searchInput = document.getElementById('tableSearchInput').value.toLowerCase().trim();
        let roleFilter = document.getElementById('roleFilter').value.toLowerCase();
        let statusFilter = document.getElementById('statusFilter').value.toLowerCase();
        let rows = document.querySelectorAll('.employee-row');

        rows.forEach(row => {
            let text = row.innerText.toLowerCase();
            let role = row.getAttribute('data-role')?.toLowerCase() || '';
            let status = row.getAttribute('data-status')?.toLowerCase() || '';

            let matchesSearch = text.includes(searchInput);
            let matchesRole = roleFilter === '' || role.includes(roleFilter);
            let matchesStatus = statusFilter === '' || status === statusFilter;

            row.style.display = (matchesSearch && matchesRole && matchesStatus) ? '' : 'none';
        });
    }

    // 2. Bật / Tắt trạng thái hoạt động của nhân viên
    function toggleStatus(userId) {
        $.post('@Url.Action("ToggleStatus", "Employee")', { id: userId }, function (res) {
            if (res.success) {
                // Cập nhật lại thuộc tính để lọc
                let row = $(`tr:has(input[onchange*="${userId}"])`);
                row.attr('data-status', res.is_active ? 'active' : 'locked');
            } else {
                alert(res.message);
                location.reload();
            }
        });
    }

    // 3. Xóa nhân viên
    function deleteEmployee(userId) {
        if (!confirm("Bạn có chắc chắn muốn xóa tài khoản nhân viên này?")) return;

        $.post('@Url.Action("Delete", "Employee")', { id: userId }, function (res) {
            if (res.success) {
                alert(res.message);
                location.reload();
            } else {
                alert(res.message);
            }
        });
    }

    document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            document.getElementById('tableSearchInput').focus();
        }
    });
</script>