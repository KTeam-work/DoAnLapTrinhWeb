@{
    ViewBag.Title = "Trang chủ";
    ViewBag.Active = "home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .hero {
        background: linear-gradient(160deg,var(--tea) 0%,var(--tea-dark) 100%);
        color: var(--cream);
        padding: 70px 32px;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        align-items: center;
        gap: 32px;
        position: relative;
        overflow: hidden;
    }

        .hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.06) 2px, transparent 2px);
            background-size: 22px 22px;
        }

    .hero-copy {
        position: relative;
        z-index: 1;
        max-width: 480px;
    }

        .hero-copy h1 {
            font-family: 'Fraunces',serif;
            font-size: 40px;
            line-height: 1.25;
            margin: 0 0 16px;
            font-weight: 600;
        }

            .hero-copy h1 span {
                color: var(--blush);
            }

        .hero-copy p {
            font-size: 15px;
            opacity: .85;
            margin: 0 0 26px;
            line-height: 1.6;
        }

    .hero-actions {
        display: flex;
        gap: 14px;
    }

    .btn-cta {
        padding: 13px 24px;
        border-radius: 14px;
        background: var(--blush);
        color: var(--pearl);
        font-weight: 700;
        font-size: 14.5px;
        text-decoration: none;
    }

        .btn-cta.outline {
            background: transparent;
            border: 1.5px solid rgba(251,243,231,.5);
            color: var(--cream);
        }

    .hero-cup {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: center;
    }

        .hero-cup svg {
            width: 210px;
            filter: drop-shadow(0 20px 24px rgba(0,0,0,.3));
        }

    .section {
        max-width: 1100px;
        margin: 0 auto;
        padding: 64px 32px;
    }

        .section h2 {
            font-family: 'Fraunces',serif;
            font-size: 28px;
            font-weight: 600;
            color: var(--tea-dark);
            margin: 0 0 8px;
        }

        .section p.lead {
            color: #8a7263;
            margin: 0 0 34px;
            font-size: 14.5px;
            max-width: 520px;
        }

    .menu-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 20px;
    }

    .menu-card {
        background: #fff;
        border: 2px solid var(--milk);
        border-radius: 18px;
        padding: 22px 18px;
        text-align: center;
        transition: border-color .15s ease, transform .15s ease;
    }

        .menu-card:hover {
            border-color: var(--caramel);
            transform: translateY(-3px);
        }

        .menu-card .dot {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            margin: 0 auto 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .menu-card h3 {
            font-size: 15.5px;
            margin: 0 0 6px;
            color: var(--tea-dark);
        }

        .menu-card p {
            font-size: 12.5px;
            color: #8a7263;
            margin: 0 0 10px;
        }

        .menu-card .price {
            font-weight: 700;
            color: var(--tea);
            font-size: 14px;
        }

    .band {
        background: var(--milk);
    }

        .band .section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
        }

        .band .cup-side {
            display: flex;
            justify-content: center;
        }

            .band .cup-side svg {
                width: 170px;
            }

        .band .stat-row {
            display: flex;
            gap: 30px;
            margin-top: 24px;
        }

        .band .stat b {
            display: block;
            font-family: 'Fraunces',serif;
            font-size: 26px;
            color: var(--tea-dark);
        }

        .band .stat span {
            font-size: 12.5px;
            color: #8a7263;
        }

    @@media (max-width:820px) {
        .hero {
            grid-template-columns: 1fr;
            text-align: center;
            padding: 48px 22px;
        }

        .hero-copy {
            margin: 0 auto;
        }

        .hero-actions {
            justify-content: center;
        }

        .menu-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .band .section {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="hero">
    <div class="hero-copy">
        <h1>Mỗi ngụm là một <span>khoảnh khắc ngọt ngào</span></h1>
        <p>Trà sữa pha thủ công mỗi ngày từ lá trà tuyển chọn, trân châu dẻo dai nấu mới liên tục trong ngày.</p>
        <div class="hero-actions">
            <a class="btn-cta" href="#menu">Xem thực đơn</a>
            <a class="btn-cta outline" href="@Url.Action("Register", "Account")">Tạo tài khoản</a>
        </div>
    </div>
    <div class="hero-cup">
        <svg viewBox="0 0 200 260" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="teaGradientHero" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#E98B6E" />
                    <stop offset="100%" stop-color="#4A2C20" />
                </linearGradient>
            </defs>
            <rect x="115" y="0" width="14" height="66" rx="4" fill="#2B1B12" transform="rotate(10 122 33)" />
            <ellipse cx="100" cy="55" rx="58" ry="13" fill="#FBF3E7" stroke="#2B1B12" stroke-width="3" />
            <rect x="46" y="49" width="108" height="12" rx="6" fill="#FBF3E7" stroke="#2B1B12" stroke-width="3" />
            <path d="M50 61 L58 228 Q100 242 142 228 L150 61 Z" fill="url(#teaGradientHero)" stroke="#2B1B12" stroke-width="3" />
            <circle cx="80" cy="203" r="7" fill="#2B1B12" />
            <circle cx="100" cy="213" r="7" fill="#2B1B12" />
            <circle cx="120" cy="201" r="7" fill="#2B1B12" />
            <circle cx="92" cy="192" r="7" fill="#2B1B12" />
            <circle cx="110" cy="189" r="7" fill="#2B1B12" />
        </svg>
    </div>
</section>

<section class="section" id="menu">
    <h2>Thực đơn nổi bật</h2>
    <p class="lead">Bốn hương vị được gọi nhiều nhất tuần này.</p>
    <div class="menu-grid">
        <div class="menu-card">
            <div class="dot" style="background:#F1E1CB;">🧋</div>
            <h3>Trà Sữa Truyền Thống</h3>
            <p>Trân châu đen, sữa tươi</p>
            <div class="price">29.000đ</div>
        </div>
        <div class="menu-card">
            <div class="dot" style="background:#F6D6C8;">🍑</div>
            <h3>Trà Đào Cam Sả</h3>
            <p>Đào miếng, cam tươi</p>
            <div class="price">35.000đ</div>
        </div>
        <div class="menu-card">
            <div class="dot" style="background:#E9D2B0;">🍮</div>
            <h3>Trà Sữa Caramel</h3>
            <p>Kem caramel béo nhẹ</p>
            <div class="price">32.000đ</div>
        </div>
        <div class="menu-card">
            <div class="dot" style="background:#F0C8C0;">🍓</div>
            <h3>Hồng Trà Dâu Tây</h3>
            <p>Dâu tươi nghiền tay</p>
            <div class="price">36.000đ</div>
        </div>
    </div>
</section>

<section class="band">
    <div class="section">
        <div>
            <h2>Pha mỗi ly bằng cả sự chăm chút</h2>
            <p class="lead">Trân châu được nấu theo mẻ nhỏ mỗi 2 giờ, trà được ủ đúng nhiệt độ để giữ trọn hương.</p>
            <div class="stat-row">
                <div class="stat"><b>12+</b><span>hương vị mỗi ngày</span></div>
                <div class="stat"><b>2h</b><span>nấu trân châu mới</span></div>
                <div class="stat"><b>4.9★</b><span>đánh giá khách hàng</span></div>
            </div>
        </div>
        <div class="cup-side">
            <svg viewBox="0 0 200 260" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="teaGradientBand" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#C98F5E" />
                        <stop offset="100%" stop-color="#4A2C20" />
                    </linearGradient>
                </defs>
                <rect x="115" y="0" width="14" height="66" rx="4" fill="#2B1B12" transform="rotate(10 122 33)" />
                <ellipse cx="100" cy="55" rx="58" ry="13" fill="#FBF3E7" stroke="#2B1B12" stroke-width="3" />
                <rect x="46" y="49" width="108" height="12" rx="6" fill="#FBF3E7" stroke="#2B1B12" stroke-width="3" />
                <path d="M50 61 L58 228 Q100 242 142 228 L150 61 Z" fill="url(#teaGradientBand)" stroke="#2B1B12" stroke-width="3" />
                <circle cx="80" cy="203" r="7" fill="#2B1B12" />
                <circle cx="100" cy="213" r="7" fill="#2B1B12" />
                <circle cx="120" cy="201" r="7" fill="#2B1B12" />
            </svg>
        </div>
    </div>
</section>
