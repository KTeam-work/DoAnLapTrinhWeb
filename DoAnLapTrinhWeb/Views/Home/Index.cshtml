<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
   
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/Scripts/ScriptHomeIndex.js"></script>
    <link href="~/Css/StyleHomeIndex.css" rel="stylesheet" />
</head>
<body>

    <!-- KHỐI 1: CAROUSEL ĐỘNG -->
    <div class="carousel-container" id="mainCarousel">
        <div class="list">

            <!-- Slide 1 (Dành cho banner5.jpg - Trà trái cây) -->
            <div class="item">
                <img src="~/Assets/banner5.jpg" alt="Trà Trái Cây Giải Nhiệt">
                <div class="content">
                    <div class="author">LUMI TEA VN</div>
                    <div class="title">GIẢI NHIỆT MÙA HÈ</div>
                    <div class="topic">MUA 2 TẶNG 1</div>
                    <div class="des">Đánh thức vị giác cùng loạt trà trái cây thanh mát: Xoài chanh dây, Vải hoa hồng và Trà cam sả. Tận hưởng ngay ưu đãi Mua 2 Tặng 1 hoặc nhận kèm bánh ngọt cực hấp dẫn.</div>
                    <div class="buttons">
                        <button onclick="window.location.href='/Account/Login'">Đăng Nhập</button>
                        <button onclick="window.location.href='/Account/Register'">Đăng ký</button>
                    </div>
                </div>
            </div>

            <!-- Slide 2 (Dành cho banner4.jpg - Hello Summer) -->
            <div class="item">
                <img src="~/Assets/banner4.jpg" alt="Bộ sưu tập Hello Summer">
                <div class="content">
                    <div class="author">LUMI TEA VN</div>
                    <div class="title">HELLO SUMMER!</div>
                    <div class="topic">TRÀ SỮA ĐẬM VỊ</div>
                    <div class="des">Chào đón mùa hè rực rỡ với bộ tứ thức uống giải nhiệt đỉnh cao: Trà sữa truyền thống, Matcha thơm mát và Trà sữa dâu ngọt ngào. Sự lựa chọn hoàn hảo cho những ngày oi ả.</div>
                    <div class="buttons">
                        <button onclick="window.location.href='/Account/Login'">Đăng Nhập</button>
                        <button onclick="window.location.href='/Account/Register'">Đăng ký</button>
                    </div>
                </div>
            </div>

            <!-- Slide 3 (Dành cho banner2.jpg - Sinh tố bơ) -->
            <div class="item">
                <img src="~/Assets/banner2.jpg" alt="Sinh tố bơ Delicious Avocado">
                <div class="content">
                    <div class="author">LUMI TEA VN</div>
                    <div class="title">DELICIOUS AVOCADO</div>
                    <div class="topic">ƯU ĐÃI ĐẾN 30%</div>
                    <div class="des">Thưởng thức ngay ly thức uống từ bơ tươi thơm béo, đậm đà hương vị tự nhiên kết hợp cùng lớp kem mịn màng phía trên. Đặt hàng ngay hôm nay để nhận ưu đãi giảm giá 30%.</div>
                    <div class="buttons">
                        <button onclick="window.location.href='/Account/Login'">Đăng Nhập</button>
                        <button onclick="window.location.href='/Account/Register'">Đăng ký</button>
                    </div>
                </div>
            </div>

            <!-- Slide 4 (Dành cho banner1.jpg - Healthy Menu) -->
            <div class="item">
                <img src="~/Assets/banner1.jpg" alt="Healthy Menu">
                <div class="content">
                    <div class="author">LUMI TEA VN</div>
                    <div class="title">HEALTHY MENU</div>
                    <div class="topic">THANH LỌC CƠ THỂ</div>
                    <div class="des">Khám phá ngay bộ sưu tập thức uống dinh dưỡng với các hương vị trái cây tự nhiên như xoài, bơ và kiwi. Nạp đầy năng lượng cho ngày dài sảng khoái với mức giá siêu mềm chỉ từ 15k.</div>
                    <div class="buttons">
                        <button onclick="window.location.href='/Account/Login'">Đăng Nhập</button>
                        <button onclick="window.location.href='/Account/Register'">Đăng ký</button>
                    </div>
                </div>
            </div>

        </div>

        <!-- Hình thu nhỏ bên dưới -->
        <div class="thumbnail">
            <div class="item">
                <img src="~/Assets/banner5.jpg" alt="Trái Cây">
                <div class="content"><div class="title">Trà Trái Cây</div></div>
            </div>
            <div class="item">
                <img src="~/Assets/banner4.jpg" alt="Hello Summer">
                <div class="content"><div class="title">Mùa Hè</div></div>
            </div>
            <div class="item">
                <img src="~/Assets/banner2.jpg" alt="Bơ">
                <div class="content"><div class="title">Bơ 30% OFF</div></div>
            </div>
            <div class="item">
                <img src="~/Assets/banner1.jpg" alt="Healthy">
                <div class="content"><div class="title">Healthy Drink</div></div>
            </div>
        </div>

        <!-- Nút điều hướng -->
        <div class="arrows">
            <button id="prev"><i class="fa-solid fa-chevron-left"></i></button>
            <button id="next"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
    </div>

    <!-- KHỐI 2: GIỚI THIỆU -->
    <section class="py-5" style="background-color: var(--lumitea-bg-warm);">
        <div class="container-xl py-4">
            <div class="row align-items-center g-5">
                <div class="col-12 col-lg-6">
                    <h2 class="display-6 section-title mb-4">GIỚI THIỆU</h2>
                    <p class="text-dark fs-6" style="line-height: 1.8;">
                        Với hình ảnh đại diện là một ly trà sữa được pha chế tận tâm, mang lại nụ cười rạng rỡ. Giống như hình ảnh của con người Việt Nam dù vất vả lo toan nhưng vẫn luôn yêu đời và biết cách thưởng thụ cuộc sống.
                    </p>
                    <p class="text-dark fs-6 mb-4" style="line-height: 1.8;">
                        Trà Sữa LumiTea mong muốn đại diện cho chính sự vui tươi, niềm hạnh phúc, tinh thần lạc quan vào tương lai và ngày càng phát triển. LumiTea hi vọng hương vị trong mỗi cốc trà sữa sẽ giúp mọi người xua tan đi mọi mệt mỏi khó khăn trong cuộc sống, giúp mọi người vui vẻ và hạnh phúc hơn.
                    </p>
                    <a href="#" class="btn btn-lumi rounded-pill px-4 py-2 mt-2">
                        Tìm hiểu thêm <i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>
                </div>
                <div class="col-12 col-lg-6 d-none d-lg-block">
                    <img src="~/Assets/gioithieu.jpg" class="img-fluid rounded-4 shadow-sm" alt="Giới thiệu LumiTea">
                    
                </div>
            </div>
        </div>
    </section>

    <!-- KHỐI 3: SẢN PHẨM NỔI BẬT -->
    <section class="py-5" style="background-color: var(--lumitea-bg-warm);">
        <div class="container-xl pb-4">
            <div class="text-center mb-5">
                <h2 class="display-6 section-title">Sản phẩm</h2>
            </div>

            <div class="row row-cols-2 row-cols-lg-4 g-4 text-center">

                <!-- SP 1 -->
                <div class="col">
                    <div class="product-card h-100">
                        <div class="product-img-box">
                            <img src="~/Assets/o_long_sua_nuong.jpg" alt="Trà Ô Long">
                        </div>
                        <h6 class="fw-bold text-dark">Trà Sữa Ô Long Nướng</h6>
                        <div class="d-flex justify-content-center gap-3 mt-2 fw-bold" style="color: var(--lumitea-primary);">
                            <span>M: 35.000đ</span>
                            <span>L: 45.000đ</span>
                        </div>
                    </div>
                </div>

                <!-- SP 2 -->
                <div class="col">
                    <div class="product-card h-100">
                        <div class="product-img-box">
                            <img src="~/Assets/tra_sua_chan_chau_duong_den.jpg" alt="Sữa Tươi">
                        </div>
                        <h6 class="fw-bold text-dark">Sữa Tươi Trân Châu ĐĐ</h6>
                        <div class="d-flex justify-content-center gap-3 mt-2 fw-bold" style="color: var(--lumitea-primary);">
                            <span>M: 40.000đ</span>
                            <span>L: 50.000đ</span>
                        </div>
                    </div>
                </div>

                <!-- SP 3 -->
                <div class="col">
                    <div class="product-card h-100">
                        <div class="product-img-box">
                            <img src="~/Assets/tra_xoai_kim_chese.jpg" alt="Trà Xoài">
                        </div>
                        <h6 class="fw-bold text-dark">Trà Xoài Nhài Kem Cheese</h6>
                        <div class="d-flex justify-content-center gap-3 mt-2 fw-bold" style="color: var(--lumitea-primary);">
                            <span>M: 45.000đ</span>
                            <span>L: 55.000đ</span>
                        </div>
                    </div>
                </div>

                <!-- SP 4 -->
                <div class="col">
                    <div class="product-card h-100">
                        <div class="product-img-box">
                            <img src="~/Assets/banner3.jpg" alt="Matcha">
                           
                        </div>
                        <h6 class="fw-bold text-dark">Matcha Đậu Đỏ</h6>
                        <div class="d-flex justify-content-center gap-3 mt-2 fw-bold" style="color: var(--lumitea-primary);">
                            <span>M: 38.000đ</span>
                            <span>L: 48.000đ</span>
                        </div>
                    </div>
                </div>

            </div>

            <div class="text-center mt-5">
                <a href="~/Menu/Index" class="btn btn-lumi rounded-pill px-5 py-2">
                    Xem tất cả <i class="fa-solid fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- KHỐI 4: DẢI BĂNG THỐNG KÊ -->
