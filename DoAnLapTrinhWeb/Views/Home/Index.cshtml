        <div class="container-xl position-relative z-1">
            <div class="row align-items-center text-center g-4">
                <div class="col-6 col-md-3">
                    <h2 class="stats-number">5+</h2>
                    <p class="fw-bold fs-5 mb-1">Năm hoạt động</p>
                    <small class="opacity-75">Trên hành trình phục vụ</small>
                </div>
                <div class="col-6 col-md-3">
                    <h2 class="stats-number">16</h2>
                    <p class="fw-bold fs-5 mb-1">Tỉnh thành</p>
                    <small class="opacity-75">Có hệ thống cửa hàng</small>
                </div>

                <img src="~/Assets/tra_sua_chan_chau_duong_den.jpg" class="stats-center-cup d-none d-lg-block rounded-4" style="object-fit: cover; width: 150px;" alt="Cup">

                <div class="col-6 col-md-3">
                    <h2 class="stats-number">60+</h2>
                    <p class="fw-bold fs-5 mb-1">Cửa hàng</p>
                    <small class="opacity-75">Trên toàn quốc</small>
                </div>
                <div class="col-6 col-md-3">
                    <h2 class="stats-number">1M+</h2>
                    <p class="fw-bold fs-5 mb-1">Ly trà sữa</p>
                    <small class="opacity-75">Đã trao đến tay khách hàng</small>
                </div>
            </div>
        </div>
    </section>

