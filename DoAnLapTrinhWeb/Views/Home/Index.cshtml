    <style>

   

        /* NÚT CHAT TRÒN */
        .chat-toggle {
            position: fixed;
            right: 25px;
            bottom: 25px;
            width: 60px;
            height: 60px;
            border: none;
            border-radius: 50%;
            background: #5c3d2e;
            color: white;
            font-size: 25px;
            cursor: pointer;
            z-index: 9999;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
            transition: all 0.3s ease;
        }

        .chat-menu-link {
            color: #8b5e3c;
            font-weight: bold;
            text-decoration: underline;
            cursor: pointer;
        }

        .chat-toggle:hover {
            transform: scale(1.1);
            background: #79513d;
        }

        .chat-menu-link {
            color: #8b5e3c;
            font-weight: bold;
            text-decoration: underline;
            margin: 0 3px;
            cursor: pointer;
        }

        .chat-menu-link:hover {
           color: #5c3d2e;
        }
        .chat-notify {
            position: absolute;
            width: 12px;
            height: 12px;
            background: #28a745;
            border: 2px solid white;
            border-radius: 50%;
            top: 5px;
            right: 5px;
        }

        /* KHUNG CHAT */
        .chat-widget {
            position: fixed;
            right: 25px;
            bottom: 100px;
            width: 360px;
            height: 490px;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 5px 30px rgba(0, 0, 0, 0.2);
            z-index: 9998;
            display: none;
            flex-direction: column;
            overflow: hidden;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .chat-widget.active {
            display: flex;
            animation: chatAppear 0.25s ease;
        }

        @@keyframes chatAppear {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* HEADER */
        .chat-widget-header {
            background: #5c3d2e;
            color: white;
            padding: 13px 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
        }

        .chat-widget-header small {
            font-size: 11px;
            color: #eee;
        }

        .chat-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: white;
            color: #5c3d2e;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 19px;
        }

        .chat-close {
            border: none;
            background: transparent;
            color: white;
            font-size: 22px;
            cursor: pointer;
        }

        .chat-close:hover {
            color: #ffd8b5;
        }

        /* NỘI DUNG CHAT */
        .chat-widget-body {
            flex: 1;
            padding: 15px;
            overflow-y: auto;
            background: #fdfaf6;
            display: flex;
            flex-direction: column;
        }

        .chat-widget-body::-webkit-scrollbar {
            width: 5px;
        }

        .chat-widget-body::-webkit-scrollbar-thumb {
            background: #d8c5b9;
            border-radius: 10px;
        }

        /* TIN NHẮN */
        .msg-user {
            display: flex;
            justify-content: flex-end;
            margin: 8px 0;
        }

        .msg-bot {
            display: flex;
            justify-content: flex-start;
            margin: 8px 0;
        }

        .bubble {
            display: inline-block;
            padding: 10px 13px;
            border-radius: 15px;
            max-width: 85%;
            font-size: 13px;
            line-height: 1.6;
            overflow-wrap: anywhere;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .bubble-user {
            background: #5c3d2e;
            color: white;
            border-bottom-right-radius: 4px;
        }

        .bubble-bot {
            display: inline-block;
            max-width: 85%;
            padding: 10px 13px;
            border-radius: 5px 15px 15px 15px;
            background-color: #f3e5dc;
            color: #4b362c;
            font-size: 13px;
            line-height: 1.5;
            white-space: normal;
            overflow-wrap: break-word;
        }

        /* AVATAR NHỎ CỦA AI */
        .bot-message-content {
            display: flex;
            align-items: flex-end;
            gap: 7px;
            max-width: 90%;
        }

        .bot-small-avatar {
            width: 25px;
            height: 25px;
            min-width: 25px;
            border-radius: 50%;
            background: #5c3d2e;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 12px;
        }

        /* TIN NHẮN CHÀO */
        .welcome-message {
            display: flex;
            justify-content: flex-start;
            margin: 8px 0;
        }

        .welcome-message .bubble {
            max-width: 100%;
        }

        /* HIỆU ỨNG 3 DẤU CHẤM */
        .typing-bubble {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 13px 15px;
            min-width: 55px;
            height: 38px;
            background: #f0e5dc;
            border-radius: 15px;
            border-bottom-left-radius: 4px;
        }

        .typing-dot {
            width: 7px;
            height: 7px;
            background: #8b6b59;
            border-radius: 50%;
            animation: typingAnimation 1.2s infinite ease-in-out;
        }

        .typing-dot:nth-child(2) {
            animation-delay: 0.2s;
        }

        .typing-dot:nth-child(3) {
            animation-delay: 0.4s;
        }

        @@keyframes typingAnimation {
            0%, 60%, 100% {
                transform: translateY(0);
                opacity: 0.4;
            }

            30% {
                transform: translateY(-6px);
                opacity: 1;
            }
        }

        /* KHUNG NHẬP */
        .chat-widget-footer {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px;
            border-top: 1px solid #eee;
            background: white;
            flex-shrink: 0;
        }

        .chat-widget-footer input {
            border-radius: 20px;
            font-size: 13px;
            height: 40px;
            padding-left: 15px;
        }

        .chat-widget-footer input:focus {
            border-color: #a77c64;
            box-shadow: 0 0 0 0.15rem rgba(92, 61, 46, 0.15);
        }

        .chat-send {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border: none;
            border-radius: 50%;
            background: #5c3d2e;
            color: white;
            cursor: pointer;
            transition: 0.2s;
        }

        .chat-send:hover {
            background: #79513d;
        }

        .chat-send:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* MOBILE */
        @@media (max-width: 480px) {
            .chat-widget {
                right: 10px;
                bottom: 85px;
                width: calc(100% - 20px);
                height: 450px;
            }

            .chat-toggle {
                right: 15px;
                bottom: 15px;
            }
        }

    </style>


