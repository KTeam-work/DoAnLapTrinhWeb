    </section>

    <!-- KHỐI 6: ĐỊA CHỈ & MAP -->
    <section class="events py-5" style="background-color: var(--lumitea-bg-warm);">
        <div class="container-xl pb-4 border-top pt-5" style="border-color: #e2e8f0 !important;">
            <div class="row justify-content-between align-items-start g-5">

                <!-- Bản đồ -->
                <div class="col-12 col-md-6 d-flex flex-column align-items-center">
                    <h4 class="mb-4 fw-bold text-dark text-uppercase">Hệ Thống Cửa Hàng</h4>
                    <div class="location w-100 shadow-sm rounded-4 overflow-hidden border border-light">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.062476696633!2d106.62628141097706!3d10.806526989299586!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752be2853ce7cd%3A0x4111b3b3c2aca14a!2zMTQwIMSQLiBMw6ogVHLhu41uZyBU4bqlbiwgVMOieSBUaOG6oW5oLCBUw6JuIFBow7osIFRow6BuaCBwaOG7kSBI4buTIENow60gTWluaCwgVmnhu4d0IE5hbQ!5e0!3m2!1svi!2s!4v1712755905274!5m2!1svi!2s"
                                class="w-100" height="350" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                    </div>
                </div>

                <!-- Banner nhỏ -->
                <div class="col-12 col-md-6 d-flex flex-column align-items-center">
                    <h4 class="mb-4 fw-bold text-dark text-uppercase">Khám Phá Menu</h4>
                    <div class="w-100 shadow-sm rounded-4 overflow-hidden position-relative">
                        <img src="~/Assets/banner5.jpg" alt="Menu Preview" class="w-100" style="height: 350px; object-fit: cover;">
                        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: rgba(26, 77, 62, 0.5);">
                            <h2 class="text-white fw-bold text-uppercase mb-3" style="letter-spacing: 2px;">LumiTea Menu</h2>
                            <a href="~/Menu/Index" class="btn btn-lumi px-4 py-2 rounded-pill shadow-sm">Khám Phá Ngay</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    @if (userRole == "R03")
    {
        <!-- NÚT CHATBOT -->
        <button type="button" id="chatToggle" class="chat-toggle">
            <i class="fa-solid fa-comments"></i>
            <span class="chat-notify"></span>
        </button>

        <!-- KHUNG CHAT -->
        <div id="chatWidget" class="chat-widget">

            <!-- HEADER -->
            <div class="chat-widget-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="chat-avatar">
                        <i class="fa-solid fa-mug-hot"></i>
                    </div>

                    <div>
                        <div class="fw-bold">LumiTea AI</div>
                        <small>
                            <i class="fa-solid fa-circle text-success me-1"></i>
                            Đang hoạt động
                        </small>
                    </div>
                </div>

                <button type="button" id="chatClose" class="chat-close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- KHUNG HIỂN THỊ TIN NHẮN -->
            <div class="chat-widget-body" id="chatBox">

                <!-- TIN NHẮN CHÀO -->
                <div class="welcome-message">
                    <div class="bot-message-content">
                        <div class="bot-small-avatar">
                            <i class="fa-solid fa-mug-hot"></i>
                        </div>

                        <div class="bubble bubble-bot">
                            Xin chào! Em là trợ lý ảo LumiTea. Em có thể giúp bạn tìm món theo khẩu vị, tra cứu giá và tình trạng món, kiểm tra tình trạng đơn hàng. Bạn cần em hỗ trợ gì nào?
                        </div>
                    </div>
                </div>

            </div>

            <!-- Ô NHẬP TIN NHẮN -->
            <div class="chat-widget-footer">
                <input type="text"
                       id="userMessage"
                       class="form-control"
                       placeholder="Nhập câu hỏi của bạn..." />

                <button type="button" id="sendBtn" class="chat-send">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </div>

        </div>
    }


    @if (userRole == "R03")
    {
        <script>
        document.addEventListener("DOMContentLoaded", function () {

            const chatToggle = document.getElementById("chatToggle");
            const chatWidget = document.getElementById("chatWidget");
            const chatClose = document.getElementById("chatClose");
            const chatBox = document.getElementById("chatBox");
            const userMessage = document.getElementById("userMessage");
            const sendBtn = document.getElementById("sendBtn");

            // MỞ KHUNG CHAT
            chatToggle.addEventListener("click", function () {
                chatWidget.classList.toggle("active");

                if (chatWidget.classList.contains("active")) {
                    userMessage.focus();
                }
            });

            // ĐÓNG KHUNG CHAT
            chatClose.addEventListener("click", function () {
                chatWidget.classList.remove("active");
            });

            // CUỘN XUỐNG TIN NHẮN CUỐI
            function scrollBottom() {
                chatBox.scrollTop = chatBox.scrollHeight;
            }


            function renderBotText(bubble, message) {
                const lines = message.split(/\r?\n/);

                lines.forEach((line, index) => {
                    if (index > 0) {
                        bubble.appendChild(document.createElement("br"));
                    }

                    const linkMatch = line.match(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/);

                    if (linkMatch) {
                        const before = line.substring(0, linkMatch.index);
                        const after = line.substring(linkMatch.index + linkMatch[0].length);

                        bubble.appendChild(document.createTextNode(before));

                        const link = document.createElement("a");
                        link.href = linkMatch[2];
                        link.textContent = linkMatch[1];
                        link.className = "chat-menu-link";

                        bubble.appendChild(link);
                        bubble.appendChild(document.createTextNode(after));
                    } else {
                        bubble.appendChild(document.createTextNode(line));
                    }
                });
            }

            function addMessage(message, isUser) {

                const messageDiv = document.createElement("div");
                messageDiv.className = isUser ? "msg-user" : "msg-bot";

                if (isUser) {

                    const bubble = document.createElement("div");
                    bubble.className = "bubble bubble-bot";

                    renderBotText(bubble, message);

                    messageDiv.appendChild(bubble);

                } else {

                    const content = document.createElement("div");
                    content.className = "bot-message-content";

                    const avatar = document.createElement("div");
                    avatar.className = "bot-small-avatar";
                    avatar.innerHTML = '<i class="fa-solid fa-mug-hot"></i>';

                    const bubble = document.createElement("div");
                    bubble.className = "bubble bubble-bot";

                    // Tách đường dẫn và tạo liên kết có thể nhấn
                    const parts = message.split("/Menu/Index");

                    parts.forEach((part, index) => {

                        bubble.appendChild(document.createTextNode(part));

                        if (index < parts.length - 1) {

                            const link = document.createElement("a");
                            link.href = '@Url.Action("Index", "Menu")';
                            link.textContent = "Xem thực đơn";
                            link.className = "chat-menu-link";

                            bubble.appendChild(link);
                        }
                    });

                    content.appendChild(avatar);
                    content.appendChild(bubble);

                    messageDiv.appendChild(content);
                }

                chatBox.appendChild(messageDiv);
                scrollBottom();
            }

            // HIỂN THỊ 3 DẤU CHẤM ĐANG NHẬP
            function showTyping() {

                const typingDiv = document.createElement("div");
                typingDiv.className = "msg-bot";
                typingDiv.id = "typingIndicator";

                typingDiv.innerHTML = `
                    <div class="bot-message-content">
                        <div class="bot-small-avatar">
                            <i class="fa-solid fa-mug-hot"></i>
                        </div>

                        <div class="typing-bubble">
                            <span class="typing-dot"></span>
                            <span class="typing-dot"></span>
                            <span class="typing-dot"></span>
                        </div>
                    </div>
                `;

                chatBox.appendChild(typingDiv);
                scrollBottom();
            }

            // ẨN 3 DẤU CHẤM
            function hideTyping() {
                const typing = document.getElementById("typingIndicator");

                if (typing) {
                    typing.remove();
                }
            }

            // GỬI TIN NHẮN
            async function sendMsg() {

                const msg = userMessage.value.trim();

                if (!msg || sendBtn.disabled) {
                    return;
                }

                // Hiển thị tin nhắn khách hàng
                addMessage(msg, true);

                userMessage.value = "";
                sendBtn.disabled = true;

                // Hiện 3 dấu chấm
                showTyping();

                try {

                    const formData = new URLSearchParams();
                    formData.append("userMessage", msg);

                    const response = await fetch('@Url.Action("Ask", "ChatBot")', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded"
                        },
                        body: formData
                    });

                    if (!response.ok) {
                        throw new Error("HTTP Error: " + response.status);
                    }

                    const res = await response.json();

                    // Ẩn dấu chấm khi AI trả lời xong
                    hideTyping();

                    addMessage(
                        res.reply || "Em chưa thể xử lý câu hỏi này.",
                        false
                    );

                }
                catch (error) {

                    console.error("Chatbot error:", error);

                    hideTyping();

                    addMessage(
                        "Xin lỗi! Hiện tại em chưa thể kết nối đến hệ thống. Bạn thử lại sau nhé!",
                        false
                    );

                }
                finally {

                    sendBtn.disabled = false;
                    userMessage.focus();

                }
            }

            // CLICK NÚT GỬI
            sendBtn.addEventListener("click", sendMsg);

            // NHẤN ENTER ĐỂ GỬI
            userMessage.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    sendMsg();
                }
            });

        });
        </script>
    }

</body>
</html>


