@{
    ViewBag.Title = "Công thức & Định lượng";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cấu Trúc Định Lượng & Công Thức - LumiTea</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/Css/styleRecipe.css" rel="stylesheet" />
</head>
<body>

    <div class="container-fluid py-3 px-4">

        <!-- HEADER -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2">
            <div>
                <div class="text-muted small mb-1">
                    <span>BẾP, VẬN HÀNH & KHO</span> / <span class="text-success fw-bold">v3.1 Production</span>
                </div>
                <h3 class="page-title mb-0">Cấu Trúc Định Lượng & Công Thức</h3>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small me-2" id="lastUpdated"><i class="fa-regular fa-clock me-1"></i> Hôm nay</span>
                <button class="btn btn-outline-secondary btn-sm" onclick="printSOP()"><i class="fa-solid fa-print me-1"></i> In SOP</button>
                <a href="@Url.Action("Index", "Ingredient")" class="btn btn-lumitea-dark btn-sm"><i class="fa-solid fa-boxes-stacked me-1"></i> Quản lý kho NL</a>
            </div>
        </div>

        <!-- MAIN LAYOUT -->
        <div class="row g-3">

            <!-- CỘT TRÁI: DANH SÁCH MÓN -->
            <div class="col-12 col-lg-4 col-xl-3">
                <div class="kem-card p-3">
                    <div class="input-group mb-2">
                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: var(--border-color);">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" id="searchDrinkInput" class="form-control border-start-0" style="border-color: var(--border-color);" placeholder="Lọc đồ uống, mã SP...">
                    </div>

                    <div class="d-flex gap-2 mb-3 overflow-auto small py-1" id="categoryFilterContainer">
                        <span class="badge bg-secondary category-badge active" data-cat="all">Tất cả</span>
                    </div>

                    <div class="recipe-list" id="drinkListContainer" style="max-height: 650px; overflow-y: auto;">
                        <div class="text-center py-4 text-muted small">
                            <i class="fa-solid fa-spinner fa-spin me-1"></i> Đang tải danh sách món...
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: CHI TIẾT CÔNG THỨC -->
            <div class="col-12 col-lg-8 col-xl-9">
                <div class="kem-card p-3 p-md-4">

                    <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge-status-sale" id="detailStatus">ĐANG PHỤC VỤ</span>
                                <span class="text-muted small" id="detailCode">MÃ SP: ---</span>
                            </div>
                            <h4 class="fw-bold mb-1" id="detailName" style="color: var(--lumitea-green);">Chọn một món đồ uống</h4>
                            <div class="text-muted small" id="detailDesc">Mô tả công thức & định lượng chuẩn của món.</div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-lumitea-primary btn-sm" onclick="openIngredientModal()"><i class="fa-solid fa-plus me-1"></i> Thêm NL vào công thức</button>
                        </div>
                    </div>

                    <!-- Stat Boxes -->
                    <div class="row g-2 mb-4">
                        <div class="col-6 col-md-4">
                            <div class="stat-box">
                                <div class="text-muted small">GIÁ BÁN CƠ BẢN</div>
                                <div class="fs-5 fw-bold text-dark mt-1" id="statPrice">0 đ</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="stat-box">
                                <div class="text-muted small">SỐ NGUYÊN LIỆU CẤU THÀNH</div>
                                <div class="fs-5 fw-bold text-success mt-1" id="statIngCount">0 loại</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="stat-box">
                                <div class="text-muted small">KHẢ NĂNG PHA CHẾ TỒN KHO</div>
                                <div class="fs-5 fw-bold text-primary mt-1" id="statCapacity">0 ly</div>
                            </div>
                        </div>
                    </div>

                    <!-- Size Tabs -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex gap-2 overflow-auto" id="sizeTabsContainer">
                            <div class="size-tab active" data-sizeid="">Mặc định (Tất cả size)</div>
                        </div>
                    </div>

                    <!-- Ingredient Table -->
                    <div class="table-responsive mb-4">
                        <table class="table table-ingredient">
                            <thead>
                                <tr>
                                    <th>MÃ NL</th>
                                    <th>TÊN NGUYÊN LIỆU</th>
                                    <th class="text-center">ĐỊNH LƯỢNG / LY</th>
                                    <th class="text-center">ÁP DỤNG SIZE</th>
                                    <th class="text-end">TỒN KHO HIỆN TẠI</th>
                                    <th class="text-center" style="width: 100px;">THAO TÁC</th>
                                </tr>
                            </thead>
                            <tbody id="ingredientTableBody">
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">Vui lòng chọn một thức uống ở danh sách bên trái.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <!-- MODAL THÊM NGUYÊN LIỆU VÀO CÔNG THỨC -->
    <div class="modal fade" id="addIngModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content kem-card border-0 p-3 shadow">
                <div class="modal-header border-bottom-0 pb-1">
                    <div>
                        <h5 class="modal-title fw-bold" id="modalIngTitle" style="color: var(--lumitea-green);">
                            <i class="fa-solid fa-mortar-pestle me-2"></i>Thêm Nguyên Liệu Thành Phần
                        </h5>
                        <p class="text-muted small mb-0">Cấu hình định lượng cho món đang chọn</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <form id="ingForm">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Chọn Nguyên Liệu Trong Kho <span class="text-danger">*</span></label>
                            <select class="form-select" id="selectIngredientId" required>
                                <option value="">-- Đang nạp danh sách nguyên liệu... --</option>
                            </select>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <label class="form-label small fw-bold">Định lượng / ly <span class="text-danger">*</span></label>
                                <input type="number" step="1" min="1" class="form-control" id="ingAmount" placeholder="VD: 50 hoặc 0.05" required>
                            </div>
                            <div class="col-5">
                                <label class="form-label small fw-bold">Đơn vị (ĐVT)</label>
                                <input type="text" class="form-control bg-light" id="ingUnitDisplay" readonly placeholder="g / ml...">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Áp dụng cho Size</label>
                            <select class="form-select" id="selectSizeId">
                                <option value="">-- Dùng chung mọi Size --</option>
                            </select>
                        </div>
                        <div class="p-2 rounded bg-light border d-flex align-items-center justify-content-between mb-2">
                            <span class="small text-muted"><i class="fa-solid fa-boxes-stacked me-1"></i> Tồn kho thực tế:</span>
                            <span id="ingStockDisplay" class="fw-bold text-dark small">0</span>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light border btn-sm px-3 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-lumitea-primary btn-sm px-3 fw-semibold" id="btnSaveIngredient" onclick="saveIngredientItem()">
                        <i class="fa-solid fa-check me-1"></i> Lưu vào công thức
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- JS CDN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let currentDrinkId = "";
        let currentSizeId = null; // null: Xem tất cả
        let availableIngredients = [];
        let currentRecipeList = [];
        let currentSizes = [];

        $(document).ready(function () {
            loadIngredientDropdown();
            loadDrinkList();

            // Lọc nhanh theo từ khóa
            $('#searchDrinkInput').on('keyup', function () {
                let keyword = $(this).val().toLowerCase();$('#drinkListContainer .recipe-item').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(keyword) > -1);
                });
            });

            // Tự động điền đơn vị và tồn kho khi chọn nguyên liệu ở Modal
            $('#selectIngredientId').on('change', function () {
                let id = $(this).val();
                let ing = availableIngredients.find(x => x.id === id);
                if (ing) {
                    $('#ingUnitDisplay').val(ing.unit);
                    $('#ingStockDisplay').text(ing.stock.toLocaleString('vi-VN') + ' ' + ing.unit);
                } else {
                    $('#ingUnitDisplay').val('');
                    $('#ingStockDisplay').text('0');
                }
            });
        });

        // 1. Tải danh sách nguyên liệu từ kho
        function loadIngredientDropdown() {
            $.getJSON('@Url.Action("GetAvailableIngredients", "Recipe")', function (res) {
                if (res.success) {
                    availableIngredients = res.data;
                    let html = '<option value="">-- Chọn nguyên liệu từ kho --</option>';
                    res.data.forEach(item => {
                        html += `<option value="${item.id}">${item.id} - ${item.name} (${item.unit})</option>`;
                    });
                    $('#selectIngredientId').html(html);
                }
            });
        }

        // 2. Tải danh sách đồ uống ở cột trái
        function loadDrinkList() {
            $.getJSON('@Url.Action("GetDrinkList", "Recipe")', function (res) {
                if (!res.success) return;
                let container = $('#drinkListContainer');
                container.empty();

                if (res.data.length === 0) {
                    container.html('<div class="text-muted small text-center py-4">Chưa có sản phẩm nào.</div>');
                    return;
                }

                // Render badges danh mục
                let categories = ['all', ...new Set(res.data.map(d => d.category))];
                let catContainer = $('#categoryFilterContainer');
                catContainer.empty();
                categories.forEach(cat => {
                    let catName = cat === 'all' ? `Tất cả (${res.data.length})` : cat;
                    let active = cat === 'all' ? 'active bg-secondary' : 'bg-light text-dark';
                    catContainer.append(`<span class="badge ${active} category-badge cursor-pointer" data-cat="${cat}">${catName}</span>`);
                });

                $('.category-badge').on('click', function () {
                    $('.category-badge').removeClass('active bg-secondary').addClass('bg-light text-dark');$(this).removeClass('bg-light text-dark').addClass('active bg-secondary');
                    let selectedCat = $(this).data('cat');

                    $('#drinkListContainer .recipe-item').filter(function () {
                        let itemCat = $(this).data('cat');$(this).toggle(selectedCat === 'all' || itemCat === selectedCat);
                    });
                });

                res.data.forEach((drink, index) => {
                    let html = `
                        <div class="recipe-item ${index === 0 ? 'active' : ''}" data-id="${drink.id}" data-cat="${drink.category}" onclick="selectDrink('${drink.id}')">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <span class="badge-status-sale">${drink.status}</span>
                                <span class="text-muted small">${drink.code}</span>
                            </div>
                            <div class="fw-bold drink-title">${drink.name}</div>
                            <div class="d-flex justify-content-between text-muted small mt-2">
                                <span><i class="fa-solid fa-layer-group me-1"></i>${drink.category}</span>
                                <span class="fw-semibold text-dark">${(drink.base_price || 0).toLocaleString('vi-VN')} đ</span>
                            </div>
                        </div>
                    `;
                    container.append(html);
                });

                if (res.data.length > 0) {
                    selectDrink(res.data[0].id);
                }
            });
        }

        // 3. Chọn 1 món đồ uống
        function selectDrink(id) {
            currentDrinkId = id;
            $('#drinkListContainer .recipe-item').removeClass('active');
            $(`#drinkListContainer .recipe-item[data-id="${id}"]`).addClass('active');

            $.getJSON('@Url.Action("GetRecipeDetail", "Recipe")', { productId: id }, function (res) {
                if (!res.success) {
                    alert(res.message);
                    return;
                }

                $('#detailName').text(res.product.name);
                $('#detailCode').text(`MÃ SP: ${res.product.id}`);
                $('#detailDesc').text(res.product.desc || 'Chưa có mô tả định lượng.');
                $('#statPrice').html(`${(res.product.base_price || 0).toLocaleString('vi-VN')} <small class="fs-6">đ</small>`);

                currentSizes = res.sizes || [];

                // Render Size Tabs
                let tabsContainer = $('#sizeTabsContainer');
                tabsContainer.empty();
                tabsContainer.append(`<div class="size-tab active" data-sizeid="">Tất cả Size</div>`);
                currentSizeId = null;

                // Nạp options vào Modal chọn Size
                let modalSizeSelect = $('#selectSizeId');
                modalSizeSelect.html('<option value="">-- Dùng chung mọi Size --</option>');

                if (currentSizes.length > 0) {
                    currentSizes.forEach(s => {
                        let addPrice = (s.price_add > 0) ? ` (+${s.price_add.toLocaleString('vi-VN')}đ)` : '';
                        tabsContainer.append(`<div class="size-tab" data-sizeid="${s.size_id}">${s.size_name}${addPrice}</div>`);
                        modalSizeSelect.append(`<option value="${s.size_id}">${s.size_name}${addPrice}</option>`);
                    });
                }

                $('.size-tab').on('click', function () {
                    $('.size-tab').removeClass('active');$(this).addClass('active');
                    let val = $(this).data('sizeid');
                    currentSizeId = val !== "" ? val : null;
                    renderRecipeTable();
                });

                currentRecipeList = res.recipes || [];
                renderRecipeTable();
            });
        }

        // 4. Render bảng nguyên liệu
        function renderRecipeTable() {
            let tbody = $('#ingredientTableBody');
            tbody.empty();

            let filtered = currentRecipeList.filter(r => currentSizeId === null || r.size_id === currentSizeId || r.size_id === null);

            $('#statIngCount').text(`${currentRecipeList.length} loại`);

            if (filtered.length === 0) {
                tbody.html('<tr><td colspan="6" class="text-center text-muted py-4">Chưa có nguyên liệu nào cho cấu hình size này. Bấm <b>"Thêm NL vào công thức"</b> để thiết lập.</td></tr>');
                $('#statCapacity').html(`0 <small class="fs-6">ly</small>`);
                return;
            }

            let minCapacity = Infinity;

            filtered.forEach(r => {
                let possibleCups = r.quantity > 0 ? Math.floor(r.stock / r.quantity) : 0;
                if (possibleCups < minCapacity) minCapacity = possibleCups;

                let stockClass = r.stock <= 0 ? 'text-danger fw-bold' : (r.stock < 100 ? 'text-warning fw-bold' : 'text-success');

                // Tên size áp dụng
                let sizeDisplay = '<span class="badge bg-light text-dark border">Chung</span>';
                if (r.size_id) {
                    let s = currentSizes.find(x => x.size_id === r.size_id);
                    sizeDisplay = `<span class="badge bg-primary-subtle text-primary border border-primary-subtle">${s ? s.size_name : r.size_id}</span>`;
                }

                let row = `
                    <tr>
                        <td class="text-muted fw-bold">${r.ingredient_id}</td>
                        <td class="fw-bold text-dark">${r.ingredient_name}</td>
                        <td class="text-center fw-bold text-success">${Number(r.quantity).toLocaleString('vi-VN')} <small class="text-muted">${r.unit}</small></td>
                        <td class="text-center">${sizeDisplay}</td>
                        <td class="text-end ${stockClass}">${Number(r.stock).toLocaleString('vi-VN')} ${r.unit}</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-light border text-danger" title="Xóa khỏi công thức" onclick="deleteRecipe('${r.recipe_id}')">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });

            $('#statCapacity').html(`${minCapacity === Infinity ? 0 : minCapacity} <small class="fs-6">ly</small>`);
        }

        // 5. Mở Modal thêm nguyên liệu
        function openIngredientModal() {
            if (!currentDrinkId) {
                alert("Vui lòng chọn 1 sản phẩm trước!");
                return;
            }
            $('#ingForm')[0].reset();
            $('#selectIngredientId').val('').trigger('change');
            if (currentSizeId) {
                $('#selectSizeId').val(currentSizeId);
            }
            new bootstrap.Modal(document.getElementById('addIngModal')).show();
        }

        // 6. Lưu nguyên liệu vào Database
        function saveIngredientItem() {
            let ingId = $('#selectIngredientId').val();
            let qty = parseFloat($('#ingAmount').val());
            let unit = $('#ingUnitDisplay').val();
            let sizeId = $('#selectSizeId').val();

            if (!ingId) {
                alert("Vui lòng chọn nguyên liệu!");
                return;
            }

            if (isNaN(qty) || qty <= 0) {
                alert("Vui lòng nhập định lượng lớn hơn 0!");
                return;
            }

            let $btn =$('#btnSaveIngredient');
            $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang lưu...');

            $.ajax({
                url: '@Url.Action("SaveRecipeItem", "Recipe")',
                type: 'POST',
                data: {
                    productId: currentDrinkId,
                    ingredientId: ingId,
                    quantity: qty,
                    unit: unit,
                    sizeId: sizeId
                },
                success: function (res) {
                    if (res.success) {
                        bootstrap.Modal.getInstance(document.getElementById('addIngModal')).hide();
                        selectDrink(currentDrinkId);
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert("Lỗi khi kết nối đến máy chủ.");
                },
                complete: function () {
                    $btn.prop('disabled', false).html('<i class="fa-solid fa-check me-1"></i> Lưu vào công thức');
                }
            });
        }

        // 7. Xóa nguyên liệu khỏi công thức
        function deleteRecipe(recipeId) {
            if (!confirm("Xác nhận xóa nguyên liệu này khỏi công thức?")) return;

            $.ajax({
                url: '@Url.Action("DeleteRecipeItem", "Recipe")',
                type: 'POST',
                data: { recipeId: recipeId },
                success: function (res) {
                    if (res.success) {
                        selectDrink(currentDrinkId);
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert("Lỗi khi kết nối đến máy chủ.");
                }
            });
        }

        function printSOP() {
            window.print();
        }
    </script>
</body>
</html>