@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model IEnumerable<DoAnLapTrinhWeb.Models.Category>
<link rel="stylesheet" href="~/Css/styleProduct_index.css" />

<style>
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes rowIn {
        from {
            opacity: 0;
            transform: translateX(-12px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes pulseDot {
        0% {
            box-shadow: 0 0 0 0 rgba(35, 117, 70, 0.5);
        }

        100% {
            box-shadow: 0 0 0 8px rgba(35, 117, 70, 0);
        }
    }

    @@keyframes ripple {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }

    /* Nền trang kem ấm theo style gốc */
    .category-clean-page {
        background-color: #f8f5eb;
        min-height: calc(100vh - 60px);
        padding: 28px 32px 50px;
    }

    .category-container {
        max-width: 1400px;
        margin: 0 auto;
        animation: fadeUp 0.5s ease both;
    }

    /* Header tối giản giống ảnh mẫu */
    .clean-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 16px;
    }

    .clean-title-group {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .clean-title {
        font-size: 22px;
        font-weight: 800;
        color: #17463e;
        margin: 0;
    }

    .clean-subtitle {
        font-size: 13px;
        color: #78837e;
        margin: 2px 0 0;
    }

    /* Nút thêm danh mục */
    .btn-tea-add {
        position: relative;
        overflow: hidden;
        background-color: #20584f;
        border: 1px solid #20584f;
        color: #ffffff;
        padding: 10px 18px;
        border-radius: 10px;
        font-size: 13.5px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        box-shadow: 0 6px 16px rgba(32, 88, 79, 0.16);
        transition: all 0.2s ease;
    }

        .btn-tea-add:hover {
            background-color: #17463e;
            color: #ffffff;
            transform: translateY(-2px);
        }

    /* Khung Card chính bọc cả Search, Filter, Table và Footer */
    .main-unified-card {
        background: #fffdf8;
        border: 1px solid #e6dcc2;
        border-radius: 16px;
        box-shadow: 0 8px 26px rgba(47, 67, 62, 0.06);
        overflow: hidden;
    }

    /* Thanh Toolbar bên trong Card (Search bên trái - Filter bên phải giống ảnh mẫu) */
    .card-toolbar {
        padding: 18px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        border-bottom: 1px solid #eee8da;
        background: #ffffff;
    }

    .search-box-wrapper {
        position: relative;
        width: 320px;
        max-width: 100%;
    }

        .search-box-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #78837e;
            font-size: 14px;
        }

    .search-box-input {
        width: 100%;
        height: 40px;
        padding: 8px 14px 8px 38px;
        border: 1px solid #ddd7c9;
        border-radius: 10px;
        font-size: 13px;
        color: #213430;
        background-color: #fbfaf6;
        transition: all 0.2s;
    }

        .search-box-input:focus {
            outline: none;
            background-color: #ffffff;
            border-color: #20584f;
            box-shadow: 0 0 0 3px rgba(32, 88, 79, 0.09);
        }

    /* Cụm nút lọc bên phải giống ảnh mẫu */
    .filter-actions-group {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .filter-select-clean {
        height: 40px;
        min-width: 185px;
        padding: 0 14px;
        border: 1px solid #ddd7c9;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        color: #213430;
        background-color: #ffffff;
        cursor: pointer;
    }

        .filter-select-clean:focus {
            outline: none;
            border-color: #20584f;
        }

    .btn-icon-square {
        width: 40px;
        height: 40px;
        border: 1px solid #ddd7c9;
        border-radius: 10px;
        background: #ffffff;
        color: #20584f;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-icon-square:hover {
            background: #eaf3ef;
            border-color: #20584f;
        }

        .btn-icon-square i {
            transition: transform 0.4s;
        }

    #btnReset:hover i {
        transform: rotate(-180deg);
    }

    /* Bảng dữ liệu tối giản */
    .clean-table {
        width: 100%;
        margin-bottom: 0;
        border-collapse: collapse;
    }

        .clean-table thead th {
            padding: 14px 22px;
            background-color: #f8f5eb;
            color: #61706a;
            font-size: 11.5px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #e6dcc2;
            white-space: nowrap;
        }

        .clean-table tbody tr {
            background-color: #ffffff;
            border-bottom: 1px solid #f2ede0;
            animation: rowIn 0.4s ease both;
            transition: background-color 0.2s;
        }

            .clean-table tbody tr:hover {
                background-color: #faf7ef;
            }

        .clean-table tbody td {
            padding: 14px 22px;
            font-size: 13.5px;
            color: #213430;
            vertical-align: middle;
        }

    /* Icon & Tên danh mục */
    .cat-thumb {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #eaf3ef;
        color: #20584f;
        font-size: 17px;
        margin-right: 12px;
        flex-shrink: 0;
        transition: transform 0.25s;
    }

    .clean-table tbody tr:hover .cat-thumb {
        transform: scale(1.08);
    }

    .cat-name-text {
        font-weight: 700;
        color: #17463e;
    }

    .cat-code-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 7px;
        background: #eaf3ef;
        color: #20584f;
        font-family: Consolas, monospace;
        font-size: 12px;
        font-weight: 700;
    }

    .cat-desc-text {
        color: #78837e;
        font-size: 13px;
        max-width: 360px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Badge trạng thái */
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 700;
    }

        .status-pill.active {
            background: #e7f5ec;
            color: #237546;
        }

            .status-pill.active i {
                animation: pulseDot 1.6s infinite;
                border-radius: 50%;
            }

        .status-pill.inactive {
            background: #fbe9e6;
            color: #a94435;
        }

    /* Nút thao tác Edit giống ảnh mẫu */
    .btn-action-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1px solid #ddd7c9;
        background: #ffffff;
        color: #20584f;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-action-icon:hover {
            background: #20584f;
            border-color: #20584f;
            color: #ffffff;
            transform: translateY(-2px);
        }

    /* Footer phân trang bên dưới bảng giống ảnh mẫu */
    .card-bottom-bar {
        padding: 14px 22px;
        background: #ffffff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        border-top: 1px solid #eee8da;
    }

    .entries-info {
        font-size: 12.5px;
        color: #78837e;
        font-weight: 600;
    }

    .clean-pagination {
        display: flex;
        align-items: center;
        gap: 6px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .clean-pagination .page-btn {
            min-width: 32px;
            height: 32px;
            padding: 0 10px;
            border-radius: 8px;
            border: 1px solid #ddd7c9;
            background: #ffffff;
            color: #213430;
            font-size: 12.5px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            cursor: pointer;
        }

            .clean-pagination .page-btn.active {
                background: #20584f;
                border-color: #20584f;
                color: #ffffff;
            }

            .clean-pagination .page-btn.disabled {
                opacity: 0.45;
                pointer-events: none;
            }

    .btn .ripple, .btn-tea-add .ripple {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.45);
        transform: scale(0);
        animation: ripple 0.6s linear;
        pointer-events: none;
    }
</style>

<div class="category-clean-page">
    <div class="category-container">

        <!-- 1. HEADER TỐI GIẢN GIỐNG ẢNH MẪU -->
        <div class="clean-header">
            <div class="clean-title-group">
                <div style="width: 44px; height: 44px; border-radius: 12px; background: #20584f; color: #f5c84b; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                </div>
                <div>
                    <h1 class="clean-title">Danh mục sản phẩm</h1>
                    <p class="clean-subtitle">Quản lý danh sách phân loại đồ uống của cửa hàng</p>
                </div>
            </div>

            <a href="@Url.Action("Create", "Category")" class="btn-tea-add">
                <i class="bi bi-plus-lg"></i>
                <span>Thêm danh mục</span>
            </a>
        </div>

        <!-- 2. KHUNG CARD CHÍNH (SEARCH + FILTER + TABLE + PAGINATION) -->
        <div class="main-unified-card">

            <!-- Toolbar trên cùng của bảng -->
            <div class="card-toolbar">
                <!-- Ô tìm kiếm bên trái -->
                <div class="search-box-wrapper">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           id="searchCategory"
                           class="search-box-input"
                           placeholder="Tìm kiếm mã hoặc tên danh mục..." />
                </div>

                <!-- Bộ lọc trạng thái & nút Reset bên phải -->
                <div class="filter-actions-group">
                    <div class="d-flex align-items-center gap-2">
                        <span style="font-size: 12px; font-weight: 700; color: #78837e;" class="d-none d-sm-inline">
                            <i class="bi bi-funnel me-1" style="color: #20584f;"></i>Lọc:
                        </span>
                        <select id="statusFilter" class="filter-select-clean">
                            <option value="all">Tất cả trạng thái</option>
                            <option value="active">Đang hoạt động</option>
                            <option value="inactive">Ngừng hoạt động</option>
                        </select>
                    </div>

                    <button type="button" id="btnReset" class="btn-icon-square" title="Đặt lại bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>
            </div>

            <!-- Bảng dữ liệu -->
            <div class="table-responsive">
                <table class="clean-table">
                    <thead>
                        <tr>
                            <th style="width: 280px;">Tên danh mục</th>
                            <th style="width: 160px;">Mã danh mục</th>
                            <th>Mô tả</th>
                            <th style="width: 180px;">Trạng thái</th>
                            <th style="width: 110px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="categoryTableBody">
                        @foreach (var item in Model)
                        {
                            string cId = item.category_id != null ? item.category_id.Trim() : "";
                            <tr>
                                <!-- Cột 1: Tên danh mục kèm icon giống ảnh mẫu -->
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="cat-thumb">
                                            <i class="bi bi-cup-hot"></i>
                                        </span>
                                        <span class="cat-name-text product-name">@item.category_name</span>
                                    </div>
                                </td>

                                <!-- Cột 2: Mã danh mục -->
                                <td>
                                    <span class="cat-code-badge product-code">@cId</span>
                                </td>

                                <!-- Cột 3: Mô tả -->
                                <td>
                                    <div class="cat-desc-text description" title="@item.description">
                                        @(string.IsNullOrEmpty(item.description) ? "Chưa có mô tả" : item.description)
                                    </div>
                                </td>

                                <!-- Cột 4: Trạng thái -->
                                <td>
                                    @if (item.status == "Active")
                                    {
                                        <span class="status-pill status-badge available">
                                            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-badge unavailable">
                                            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> Ngừng hoạt động
                                        </span>
                                    }
                                </td>

                                <!-- Cột 5: Thao tác -->
                                <td class="text-center">
                                    <a href="@Url.Action("Edit", "Category", new { id = cId })"
                                       class="btn-action-icon" title="Chỉnh sửa danh mục">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Trạng thái trống khi tìm không thấy -->
            <div id="emptyState" class="text-center py-5 d-none" style="background: #ffffff;">
                <div class="mb-2">
                    <i class="bi bi-inbox" style="font-size: 40px; color: #b7c5bf;"></i>
                </div>
                <h6 class="fw-bold mb-1" style="color:#17463e;">Không tìm thấy danh mục</h6>
                <p class="mb-0" style="color:#78837e; font-size:13px;">
                    Hãy thử thay đổi từ khóa tìm kiếm hoặc bộ lọc trạng thái.
                </p>
            </div>

            <!-- Footer thống kê số dòng & phân trang giống ảnh mẫu -->
            <div class="card-bottom-bar">
                <span class="entries-info" id="resultText">Hiển thị 0 danh mục</span>

                <ul class="clean-pagination">
                    <li><span class="page-btn disabled"><i class="bi bi-chevron-left"></i></span></li>
                    <li><span class="page-btn active">1</span></li>
                    <li><span class="page-btn disabled"><i class="bi bi-chevron-right"></i></span></li>
                </ul>
            </div>

        </div>
    </div>
</div>

<script>
    /* =========================================================
       1. ĐỌC DỮ LIỆU TỪ BẢNG HTML
       ========================================================= */
    function getCategoriesFromTable() {
        const rows = document.querySelectorAll("#categoryTableBody tr");
        let categories = [];

        rows.forEach(row => {
            const idEl = row.querySelector(".product-code");
            const nameEl = row.querySelector(".product-name");
            const descEl = row.querySelector(".description");
            const statusBadge = row.querySelector(".status-badge");

            if (idEl && nameEl) {
                const id = idEl.textContent.trim();
                const name = nameEl.textContent.trim();
                const description = descEl ? descEl.textContent.trim() : "";

                let status = "Active";
                if (statusBadge && statusBadge.classList.contains("unavailable")) {
                    status = "Inactive";
                }

                categories.push({
                    id: id,
                    name: name,
                    description: description,
                    status: status,
                    element: row
                });
            }
        });

        return categories;
    }

    /* =========================================================
       2. TÌM KIẾM & LỌC TRỰC TIẾP TRÊN BẢNG
       ========================================================= */
    function filterCategories() {
        const categories = getCategoriesFromTable();
        const rawKeyword = document.getElementById("searchCategory").value.trim().toLowerCase();
        const statusFilter = document.getElementById("statusFilter").value;

        let visibleCount = 0;

        categories.forEach(item => {
            const matchKeyword = !rawKeyword ||
                item.id.toLowerCase().includes(rawKeyword) ||
                item.name.toLowerCase().includes(rawKeyword) ||
                item.description.toLowerCase().includes(rawKeyword);

            const matchStatus = statusFilter === "all" ||
                (statusFilter === "active" && item.status === "Active") ||
                (statusFilter === "inactive" && item.status === "Inactive");

            if (matchKeyword && matchStatus) {
                item.element.style.display = "";
                visibleCount++;
            } else {
                item.element.style.display = "none";
            }
        });

        const emptyState = document.getElementById("emptyState");
        if (visibleCount === 0) {
            emptyState.classList.remove("d-none");
        } else {
            emptyState.classList.add("d-none");
        }

        document.getElementById("resultText").textContent =
            `Hiển thị 1 - ${visibleCount} trên tổng số ${categories.length} danh mục`;
    }

    /* =========================================================
       3. HIỆU ỨNG RIPPLE & SỰ KIỆN
       ========================================================= */
    document.querySelectorAll(".btn-tea-add").forEach(btn => {
        btn.addEventListener("click", function (e) {
            const rect = this.getBoundingClientRect();
            const size = Math.max(rect.width, rect.height);
            const r = document.createElement("span");
            r.className = "ripple";
            r.style.width = r.style.height = size + "px";
            r.style.left = (e.clientX - rect.left - size / 2) + "px";
            r.style.top = (e.clientY - rect.top - size / 2) + "px";
            this.appendChild(r);
            setTimeout(() => r.remove(), 600);
        });
    });

    document.getElementById("searchCategory").addEventListener("input", filterCategories);
    document.getElementById("statusFilter").addEventListener("change", filterCategories);

    document.getElementById("btnReset").addEventListener("click", function () {
        document.getElementById("searchCategory").value = "";
        document.getElementById("statusFilter").value = "all";
        filterCategories();
    });

    window.addEventListener("DOMContentLoaded", () => {
        filterCategories();
    });
</script>