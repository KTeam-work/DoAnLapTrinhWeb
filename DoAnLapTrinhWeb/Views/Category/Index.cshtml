@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model IEnumerable<DoAnLapTrinhWeb.Models.Category>
<link rel="stylesheet" href="~/Css/styleProduct_index.css" />

<style>
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes floaty {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-6px);
        }
    }

    @@keyframes rowIn {
        from {
            opacity: 0;
            transform: translateX(-18px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes pulseDot {
        0% {
            box-shadow: 0 0 0 0 rgba(25,135,84,.5);
        }

        100% {
            box-shadow: 0 0 0 10px rgba(25,135,84,0);
        }
    }

    @@keyframes shimmer {
        0% {
            background-position: -200% 0;
        }

        100% {
            background-position: 200% 0;
        }
    }

    @@keyframes ripple {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }

    /* ===== Vào trang ===== */
    .product-heading {
        animation: fadeUp .6s ease both;
    }

    .summary-grid .summary-card {
        animation: fadeUp .6s ease both;
    }

        .summary-grid .summary-card:nth-child(1) {
            animation-delay: .08s;
        }

        .summary-grid .summary-card:nth-child(2) {
            animation-delay: .16s;
        }

        .summary-grid .summary-card:nth-child(3) {
            animation-delay: .24s;
        }

        .summary-grid .summary-card:nth-child(4) {
            animation-delay: .32s;
        }

    .filter-card {
        animation: fadeUp .6s ease .38s both;
    }

    .product-table-card {
        animation: fadeUp .6s ease .46s both;
    }

    .heading-icon {
        animation: floaty 3s ease-in-out infinite;
    }

    /* ===== Thẻ thống kê ===== */
    .summary-card {
        transition: transform .3s, box-shadow .3s;
        cursor: default;
    }

        .summary-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 32px rgba(0,0,0,.12);
        }

        .summary-card .summary-icon {
            transition: transform .4s;
        }

        .summary-card:hover .summary-icon {
            transform: rotate(-12deg) scale(1.2);
        }

    /* ===== Nút ===== */
    .btn-tea, .btn-filter {
        position: relative;
        overflow: hidden;
        transition: transform .2s, box-shadow .2s;
    }

        .btn-tea:hover, .btn-filter:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 22px rgba(0,0,0,.15);
        }

        .btn-tea:active, .btn-filter:active {
            transform: scale(.96);
        }

    .btn .ripple {
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,.5);
        transform: scale(0);
        animation: ripple .6s linear;
        pointer-events: none;
    }

    #btnReset:hover i {
        transform: rotate(-180deg);
    }

    #btnReset i {
        display: inline-block;
        transition: transform .5s;
    }

    /* ===== Ô tìm kiếm ===== */
    .form-control, .form-select {
        transition: box-shadow .25s, transform .25s, border-color .25s;
    }

        .form-control:focus, .form-select:focus {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,.08);
        }

    /* ===== Bảng ===== */
    #categoryTableBody tr {
        animation: rowIn .45s ease both;
        transition: background .25s, transform .25s, box-shadow .25s;
    }

        #categoryTableBody tr:hover {
            background: #f6fbf8;
            transform: scale(1.012);
            box-shadow: 0 6px 18px rgba(0,0,0,.07);
            position: relative;
            z-index: 1;
        }

    .cat-icon {
        display: inline-grid;
        place-items: center;
        width: 38px;
        height: 38px;
        margin-right: 10px;
        border-radius: 12px;
        background: #fff1f4;
        font-size: 20px;
        vertical-align: middle;
        transition: transform .3s;
    }

    tr:hover .cat-icon {
        transform: rotate(-10deg) scale(1.2);
    }

    .cat-icon.off {
        background: #eef0f2;
        filter: grayscale(1);
        opacity: .75;
    }

    mark.hl {
        background: #ffe8a3;
        padding: 0 2px;
        border-radius: 4px;
    }

    .status-badge.available i {
        animation: pulseDot 1.6s infinite;
        border-radius: 50%;
    }

    .action-btn {
        transition: transform .25s, box-shadow .25s;
    }

        .action-btn:hover {
            transform: translateY(-3px) rotate(-8deg) scale(1.12);
            box-shadow: 0 8px 16px rgba(0,0,0,.18);
        }

    /* ===== Skeleton khi tải ===== */
    .skeleton-row td {
        padding: 18px 12px;
    }

    .skeleton-bar {
        height: 14px;
        border-radius: 8px;
        background: linear-gradient(90deg, #eee 25%, #f8f8f8 50%, #eee 75%);
        background-size: 200% 100%;
        animation: shimmer 1.2s infinite;
    }

    #emptyState {
        animation: fadeUp .4s ease both;
    }

        #emptyState i {
            display: inline-block;
            animation: floaty 2.4s ease-in-out infinite;
        }

    @@media (prefers-reduced-motion: reduce) {
        * {
            animation: none !important;
            transition: none !important;
        }
    }
</style>

<div class="product-page">

    <!-- HEADER -->
    <div class="product-heading">

        <div class="heading-left">
            <div class="heading-icon">
                <i class="bi bi-grid-3x3-gap-fill"></i>
            </div>
            <div>
                <h1 class="page-title">Quản lý danh mục</h1>
                <p class="page-subtitle">Quản lý các danh mục sản phẩm của cửa hàng</p>
            </div>
        </div>

        <a href="@Url.Action("Create", "Category")" class="btn btn-tea">
            <i class="bi bi-plus-lg me-2"></i>
            Thêm danh mục
        </a>

    </div>


    <!-- SUMMARY -->
    <div class="summary-grid">

        <div class="summary-card">
            <span class="summary-label">Tổng danh mục</span>
            <strong class="summary-number" id="totalCategories">0</strong>
            <div class="summary-icon"><i class="bi bi-grid"></i></div>
        </div>

        <div class="summary-card">
            <span class="summary-label">Đang hoạt động</span>
            <strong class="summary-number" id="activeCategories">0</strong>
            <div class="summary-icon"><i class="bi bi-check-circle"></i></div>
        </div>

        <div class="summary-card">
            <span class="summary-label">Ngừng hoạt động</span>
            <strong class="summary-number" id="inactiveCategories">0</strong>
            <div class="summary-icon"><i class="bi bi-pause-circle"></i></div>
        </div>

        <div class="summary-card">
            <span class="summary-label">Kết quả hiển thị</span>
            <strong class="summary-number" id="displayCategories">0</strong>
            <div class="summary-icon"><i class="bi bi-list-check"></i></div>
        </div>

    </div>


    <!-- FILTER -->
    <div class="filter-card">

        <div class="filter-head">
            <i class="bi bi-funnel-fill"></i>
            <span>Tìm kiếm & lọc danh mục</span>
        </div>

        <div class="filter-body">
            <div class="row g-4 align-items-end">

                <div class="col-lg-7">
                    <label class="form-label">Từ khóa</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text"
                               id="searchCategory"
                               class="form-control"
                               placeholder="Nhập mã hoặc tên danh mục..." />
                    </div>
                </div>

                <div class="col-lg-3">
                    <label class="form-label">Trạng thái</label>
                    <select id="statusFilter" class="form-select">
                        <option value="all">Tất cả trạng thái</option>
                        <option value="active">Đang hoạt động</option>
                        <option value="inactive">Ngừng hoạt động</option>
                    </select>
                </div>

                <div class="col-lg-2">
                    <button type="button" id="btnReset" class="btn btn-filter w-100">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Đặt lại
                    </button>
                </div>

            </div>
        </div>

    </div>


    <!-- TABLE -->
    <div class="product-table-card">

        <div class="table-top">
            <div>
                <h2 class="table-title">Danh sách danh mục</h2>
                <span class="table-note">Các danh mục sản phẩm đang được quản lý</span>
            </div>
            <span class="table-note" id="resultText">0 danh mục</span>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="width: 160px;">Mã danh mục</th>
                        <th style="width: 260px;">Tên danh mục</th>
                        <th>Mô tả</th>
                        <th style="width: 170px;">Trạng thái</th>
                        <th style="width: 150px;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="categoryTableBody">
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <span class="product-code">@item.category_id.Trim()</span>
            </td>
            <td>
                <span class="cat-icon">📁</span>
                <span class="product-name">@item.category_name</span>
            </td>
            <td>
                <div class="description">
                    @(string.IsNullOrEmpty(item.description) ? "Chưa có mô tả" : item.description)
                </div>
            </td>
            <td>
                @if (item.status == "Active")
                {
                    <span class="status-badge available">
                        <i class="bi bi-check-circle-fill"></i> Đang hoạt động
                    </span>
                }
                else
                {
                    <span class="status-badge unavailable">
                        <i class="bi bi-pause-circle-fill"></i> Ngừng hoạt động
                    </span>
                }
            </td>
            <td class="text-center">
                <a href="@Url.Action("Edit", "Category", new { id = item.category_id.Trim() })"
                   class="action-btn edit-btn" title="Chỉnh sửa">
                    <i class="bi bi-pencil-square"></i>
                </a>
            </td>
        </tr>
    }
</tbody>
            </table>
        </div>

        <!-- EMPTY -->
        <div id="emptyState" class="text-center py-5 d-none">
            <div class="mb-3">
                <i class="bi bi-inbox" style="font-size: 42px; color: #78837e;"></i>
            </div>
            <h6 class="fw-bold mb-2" style="color:#17463e;">Không tìm thấy danh mục</h6>
            <p class="mb-0" style="color:#78837e; font-size:13px;">
                Hãy thử thay đổi từ khóa hoặc bộ lọc.
            </p>
        </div>

        <!-- FOOTER -->
        <div class="table-footer">
            <span class="table-note">Hiển thị danh mục sản phẩm</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item disabled"><span class="page-link">Trước</span></li>
                    <li class="page-item active"><span class="page-link">1</span></li>
                    <li class="page-item disabled"><span class="page-link">Sau</span></li>
                </ul>
            </nav>
        </div>

    </div>

</div>


<script>
    /* =========================================================
       1. ĐỌC DỮ LIỆU THẬT TỪ BẢNG HTML (DO C# & SQL SERVER RENDER)
       ========================================================= */
    function getCategoriesFromTable() {
        const rows = document.querySelectorAll("#categoryTableBody tr");
        let categories = [];

        rows.forEach(row => {
            // Đọc các giá trị đã render từ C# Razor vào
            const idEl = row.querySelector(".product-code");
            const nameEl = row.querySelector(".product-name");
            const descEl = row.querySelector(".description");
            const statusBadge = row.querySelector(".status-badge");

            if (idEl && nameEl) {
                const id = idEl.textContent.trim();
                const name = nameEl.textContent.trim();
                const description = descEl ? descEl.textContent.trim() : "";
                
                // Kiểm tra xem trạng thái là Active hay Inactive dựa vào class của badge
                let status = "Active";
                if (statusBadge && statusBadge.classList.contains("unavailable")) {
                    status = "Inactive";
                }

                categories.push({
                    id: id,
                    name: name,
                    description: description,
                    status: status,
                    element: row // Lưu lại tham chiếu đến dòng HTML để ẩn/hiện khi lọc
                });
            }
        });

        return categories;
    }

    /* =========================================================
       2. CÁC HÀM HIỆU ỨNG VÀ HỖ TRỢ GIAO DIỆN
       ========================================================= */
    function escapeHtml(value) {
        return String(value)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    /* Số đếm chạy từ giá trị cũ lên giá trị mới */
    function animateNumber(el, to) {
        const from = parseInt(el.textContent, 10) || 0;
        if (from === to) { el.textContent = to; return; }

        const duration = 600;
        const start = performance.now();

        function step(now) {
            const t = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - t, 3);
            el.textContent = Math.round(from + (to - from) * eased);
            if (t < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
    }

    /* =========================================================
       3. HÀM TÌM KIẾM VÀ LỌC TRỰC TIẾP TRÊN BẢNG HTML
       ========================================================= */
    function filterCategories() {
        const categories = getCategoriesFromTable();
        const rawKeyword = document.getElementById("searchCategory").value.trim().toLowerCase();
        const statusFilter = document.getElementById("statusFilter").value;

        let visibleCount = 0;

        categories.forEach(item => {
            const matchKeyword = !rawKeyword ||
                item.id.toLowerCase().includes(rawKeyword) ||
                item.name.toLowerCase().includes(rawKeyword) ||
                item.description.toLowerCase().includes(rawKeyword);

            const matchStatus = statusFilter === "all" ||
                (statusFilter === "active" && item.status === "Active") ||
                (statusFilter === "inactive" && item.status === "Inactive");

            if (matchKeyword && matchStatus) {
                item.element.style.display = ""; // Hiển thị dòng
                visibleCount++;
            } else {
                item.element.style.display = "none"; // Ẩn dòng không khớp
            }
        });

        const emptyState = document.getElementById("emptyState");
        if (visibleCount === 0) {
            emptyState.classList.remove("d-none");
        } else {
            emptyState.classList.add("d-none");
        }

        // Cập nhật lại số liệu thống kê tổng quan
        updateSummary(categories.length, visibleCount);
    }

    function updateSummary(total, displayed) {
        const categories = getCategoriesFromTable();
        const active = categories.filter(item => item.status === "Active").length;
        const inactive = categories.filter(item => item.status === "Inactive").length;

        animateNumber(document.getElementById("totalCategories"), total);
        animateNumber(document.getElementById("activeCategories"), active);
        animateNumber(document.getElementById("inactiveCategories"), inactive);
        animateNumber(document.getElementById("displayCategories"), displayed);

        document.getElementById("resultText").textContent = `${displayed} danh mục`;
    }

    /* =========================================================
       4. HIỆU ỨNG RIPPLE CHO NÚT BẤM & SỰ KIỆN TƯƠNG TÁC
       ========================================================= */
    document.querySelectorAll(".btn-tea, .btn-filter").forEach(btn => {
        btn.addEventListener("click", function (e) {
            const rect = this.getBoundingClientRect();
            const size = Math.max(rect.width, rect.height);
            const r = document.createElement("span");
            r.className = "ripple";
            r.style.width = r.style.height = size + "px";
            r.style.left = (e.clientX - rect.left - size / 2) + "px";
            r.style.top = (e.clientY - rect.top - size / 2) + "px";
            this.appendChild(r);
            setTimeout(() => r.remove(), 600);
        });
    });

    document.getElementById("searchCategory").addEventListener("input", filterCategories);
    document.getElementById("statusFilter").addEventListener("change", filterCategories);

    document.getElementById("btnReset").addEventListener("click", function () {
        document.getElementById("searchCategory").value = "";
        document.getElementById("statusFilter").value = "all";
        filterCategories();
    });

    // Khởi chạy thống kê lần đầu khi vừa load trang xong
    window.addEventListener("DOMContentLoaded", () => {
        const categories = getCategoriesFromTable();
        updateSummary(categories.length, categories.length);
    });
</script>
