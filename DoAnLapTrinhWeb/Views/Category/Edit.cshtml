@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model DoAnLapTrinhWeb.Models.Category
<link rel="stylesheet" href="~/Css/styleProduct_index.css" />

<div class="product-page">

    <!-- =========================
         HEADER
         ========================= -->
    <div class="product-heading">

        <div class="heading-left">

            <div class="heading-icon">
                <i class="bi bi-pencil-square"></i>
            </div>

            <div>

                <h1 class="page-title">
                    Chỉnh sửa danh mục
                </h1>

                <p class="page-subtitle">
                    Cập nhật thông tin danh mục sản phẩm
                </p>

            </div>

        </div>


        <a href="@Url.Action("Index", "Category")"
           class="btn btn-filter">

            <i class="bi bi-arrow-left me-2"></i>
            Quay lại danh sách

        </a>

    </div>


    <!-- =========================
         FORM
         ========================= -->
    <div class="product-table-card">

        <div class="table-top">

            <div>

                <h2 class="table-title">
                    Thông tin danh mục
                </h2>

                <span class="table-note">
                    Bạn có thể cập nhật tên, mô tả và trạng thái.
                </span>

            </div>

        </div>


        <div class="p-4 p-lg-5">

            <form id="editCategoryForm"
                  novalidate>

                <div class="row g-4">


                    <!-- MÃ -->
                    <div class="col-lg-6">

                        <label class="form-label">
                            Mã danh mục
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-upc-scan"></i>
                            </span>

                            <input type="text"
                                   id="categoryId"
                                   class="form-control"
                                   readonly />

                        </div>

                        <div class="mt-2">

                            <span class="table-note">

                                <i class="bi bi-lock-fill me-1"></i>

                                Mã danh mục không thể thay đổi.

                            </span>

                        </div>

                    </div>


                    <!-- TÊN -->
                    <div class="col-lg-6">

                        <label class="form-label">
                            Tên danh mục
                            <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               id="categoryName"
                               class="form-control"
                               maxlength="100"
                               placeholder="Nhập tên danh mục..." />

                        <div id="nameError"
                             class="text-danger mt-2 d-none"
                             style="font-size:12px;">
                        </div>

                    </div>


                    <!-- MÔ TẢ -->
                    <div class="col-12">

                        <label class="form-label">
                            Mô tả
                        </label>

                        <textarea id="categoryDescription"
                                  class="form-control"
                                  rows="5"
                                  maxlength="500"
                                  placeholder="Nhập mô tả cho danh mục..."></textarea>

                    </div>


                    <!-- TRẠNG THÁI -->
                    <div class="col-lg-6">

                        <label class="form-label">
                            Trạng thái
                        </label>

                        <select id="categoryStatus"
                                class="form-select">

                            <option value="Active">
                                Đang hoạt động
                            </option>

                            <option value="Inactive">
                                Ngừng hoạt động
                            </option>

                        </select>

                    </div>


                </div>


                <!-- =========================
                     ACTION
                     ========================= -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-5 pt-4 border-top">


                    <!-- DELETE -->

                    <button type="button"
                            id="btnDelete"
                            class="btn btn-outline-danger px-4">

                        <i class="bi bi-trash3 me-1"></i>
                        Xóa danh mục

                    </button>


                    <!-- RIGHT -->

                    <div class="d-flex gap-2">

                        <a href="@Url.Action("Index", "Category")"
                           class="btn btn-filter px-4">

                            Hủy

                        </a>


                        <button type="submit"
                                class="btn btn-save px-4">

                            <i class="bi bi-check-lg me-1"></i>
                            Lưu thay đổi

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


<script>
    /* =====================================================
       1. ĐỔ DỮ LIỆU CŨ VÀO FORM (DÙNG JSON.SERIALIZE ĐỂ TRÁNH LỖI KÝ TỰ)
       ===================================================== */
    document.addEventListener("DOMContentLoaded", function () {
        // Dùng Html.Raw + Json.Encode để C# tự động escape ký tự đặc biệt, dấu nháy, khoảng trắng
        const categoryId = @Html.Raw(Json.Encode(Model.category_id != null ? Model.category_id.Trim() : ""));
        const categoryName = @Html.Raw(Json.Encode(Model.category_name ?? ""));
        const categoryDesc = @Html.Raw(Json.Encode(Model.description ?? ""));
        const categoryStatus = @Html.Raw(Json.Encode(Model.status ?? "Active"));

        document.getElementById("categoryId").value = categoryId;
        document.getElementById("categoryName").value = categoryName;
        document.getElementById("categoryDescription").value = categoryDesc;
        document.getElementById("categoryStatus").value = categoryStatus;
    });

    /* =====================================================
       2. LƯU THAY ĐỔI (GỬI POST REQUEST VỀ CONTROLLER)
       ===================================================== */
    document.getElementById("editCategoryForm").addEventListener("submit", async function (event) {
        event.preventDefault();

        const categoryId = document.getElementById("categoryId").value.trim();
        const name = document.getElementById("categoryName").value.trim();
        const description = document.getElementById("categoryDescription").value.trim();
        const status = document.getElementById("categoryStatus").value;
        const error = document.getElementById("nameError");

        error.classList.add("d-none");

        if (!name) {
            error.textContent = "Vui lòng nhập tên danh mục.";
            error.classList.remove("d-none");
            document.getElementById("categoryName").focus();
            return;
        }

        const formData = new URLSearchParams();
        formData.append("category_id", categoryId);
        formData.append("category_name", name);
        formData.append("description", description);
        formData.append("status", status);

        try {
            let response = await fetch('@Url.Action("Edit", "Category")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: formData.toString()
            });

            let result = await response.json();

            if (result.success) {
                alert("Lưu thay đổi thành công vào Database!");
                window.location.href = '@Url.Action("Index", "Category")';
            } else {
                alert(result.message || "Có lỗi xảy ra khi cập nhật.");
            }
        } catch (err) {
            console.error("Lỗi kết nối:", err);
            alert("Không thể kết nối đến máy chủ.");
        }
    });

    /* =====================================================
       3. XÓA DANH MỤC
       ===================================================== */
    document.getElementById("btnDelete").addEventListener("click", async function () {
        const categoryId = document.getElementById("categoryId").value.trim();
        const categoryName = document.getElementById("categoryName").value;

        const confirmed = confirm(`Bạn có chắc chắn muốn xóa danh mục "${categoryName}" này không?\n\nThao tác này không thể hoàn tác.`);
        if (!confirmed) {
            return;
        }

        const formData = new URLSearchParams();
        formData.append("id", categoryId);

        try {
            let response = await fetch('@Url.Action("Delete", "Category")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: formData.toString()
            });

            let result = await response.json();

            if (result.success) {
                alert("Xóa danh mục thành công!");
                window.location.href = '@Url.Action("Index", "Category")';
            } else {
                alert(result.message || "Không thể xóa danh mục này.");
            }
        } catch (err) {
            console.error("Lỗi kết nối:", err);
            alert("Không thể kết nối đến máy chủ để xóa.");
        }
    });
</script>