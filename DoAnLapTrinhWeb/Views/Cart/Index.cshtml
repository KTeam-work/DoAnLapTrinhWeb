@model List<DoAnLapTrinhWeb.Models.CartItem>
@{
    ViewBag.Title = "Giỏ Hàng - LumiTea";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Lấy tổng tiền và tổng số lượng từ Controller truyền sang
    decimal totalAmount = ViewBag.TotalAmount != null ? (decimal)ViewBag.TotalAmount : 0;
    int totalItems = Model != null ? Model.Sum(x => x.Quantity) : 0;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/Css/StyleCart.css" />

</head>
<body>

    <div class="container py-4">
        <!-- Nút quay lại và Tiêu đề -->
        <div class="d-flex align-items-center mb-4 gap-3">
            <a href="~/Menu/Index" class="text-decoration-none text-muted">
                <i class="fa-solid fa-arrow-left fs-5"></i>
            </a>
            <h2 class="fw-extrabold m-0" style="color: var(--lumitea-primary); letter-spacing: -0.8px;">Giỏ Hàng Của Bạn</h2>
        </div>

        @if (Model == null || !Model.Any())
        {
            <!-- HIỂN THỊ KHI GIỎ HÀNG TRỐNG -->
            <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
                <h4 class="fw-bold text-dark mt-3">Giỏ hàng của bạn đang trống</h4>
                <p class="text-muted mb-4">Hãy thử xem qua thực đơn của chúng tôi và chọn món bạn yêu thích nhé!</p>
                <a href="~/Menu/Index" class="btn text-white fw-bold px-4 py-2 rounded-pill" style="background-color: var(--lumitea-primary);">
                    Khám phá Thực đơn
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">

                <!-- CỘT TRÁI: DANH SÁCH SẢN PHẨM (Chiếm 8/12 màn hình) -->
                <div class="col-12 col-lg-8">

                    @foreach (var item in Model)
                    {
                        var imageUrl = string.IsNullOrEmpty(item.ImageUrl) ? "~/Assets/default.jpg" : item.ImageUrl;

                        <div class="cart-item-card d-flex gap-3 flex-column flex-sm-row align-items-sm-start mb-3">
                            <img src="@Url.Content(imageUrl)" alt="@item.ProductName" class="cart-img mx-auto mx-sm-0">

                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold text-dark m-0 fs-6">@item.ProductName</h5>
                                    <a href="#" class="text-danger" title="Xóa món này">
                                        <i class="fa-regular fa-trash-can remove-btn ms-2"></i>
                                    </a>
                                </div>

                                <!-- Chi tiết Option -->
                                <div class="text-muted small mb-2 border-start border-2 ps-2 ms-1" style="border-color: var(--lumitea-primary) !important;">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span>Ly cơ bản</span>
                                        <span class="fw-medium text-dark">@item.BasePrice.ToString("N0") đ</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span><span class="badge bg-light text-dark border p-1 me-1">Size @item.SizeName</span></span>
                                        <span class="fw-medium text-dark">+ @item.SizePrice.ToString("N0") đ</span>
                                    </div>

                                    @if (item.Toppings != null && item.Toppings.Any())
                                    {
                                        foreach (var topping in item.Toppings)
                                        {
                                            <div class="d-flex justify-content-between mb-1">
                                                <span>+ @topping.ToppingName</span>
                                                <span class="fw-medium text-dark">+ @topping.Price.ToString("N0") đ</span>
                                            </div>
                                        }
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(item.Note))
                                {
                                    <div class="text-muted small mb-3 fst-italic">
                                        <i class="fa-regular fa-comment-dots me-1"></i> Ghi chú: @item.Note
                                    </div>
                                }

                                <div class="d-flex align-items-center justify-content-between mt-auto pt-2">
                                    <div class="d-flex align-items-center gap-1">
                                        <button class="qty-btn" type="button"><i class="fa-solid fa-minus fs-7"></i></button>
                                        <input type="text" class="qty-input" value="@item.Quantity" readonly>
                                        <button class="qty-btn" type="button"><i class="fa-solid fa-plus fs-7"></i></button>
                                    </div>

                                    <span class="fw-extrabold fs-5" style="color: var(--lumitea-primary);">
                                        @item.TotalPrice.ToString("N0") <span class="fs-6 text-decoration-underline fw-normal">đ</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    }

                </div> <!-- KẾT THÚC CỘT TRÁI -->
                <!-- CỘT PHẢI: TÓM TẮT THANH TOÁN (Chiếm 4/12 màn hình) -->
                <div class="col-12 col-lg-4">
                    <div class="summary-box shadow-sm">
                        <h5 class="fw-bold mb-4" style="color: var(--lumitea-primary);">Tóm tắt đơn hàng</h5>

                        <div class="d-flex justify-content-between mb-3 text-muted">
                            <span>Tổng tiền hàng (@totalItems sản phẩm)</span>
                            <span class="fw-semibold text-dark">@totalAmount.ToString("N0") đ</span>
                        </div>

                        <div class="input-group mb-4">
                            <input type="text" class="form-control bg-light border-end-0" placeholder="Nhập mã ưu đãi...">
                            <button class="btn border border-start-0 bg-light text-success fw-bold" type="button">Áp dụng</button>
                        </div>

                        <div class="d-flex justify-content-between mb-3 text-muted">
                            <span>Giảm giá Voucher</span>
                            <span class="fw-semibold text-success">- 0 đ</span>
                        </div>

                        <hr class="text-muted opacity-25">

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fw-bold fs-6">TỔNG CỘNG</span>
                            <span class="fw-extrabold fs-4 text-danger" style="color: var(--lumitea-primary) !important;">
                                @totalAmount.ToString("N0") <span class="fs-5 text-decoration-underline fw-normal">đ</span>
                            </span>
                        </div>

                        <!-- ĐIỀU HƯỚNG QUA CHECK OUT -->
                        <a href="~/Order/Checkout" class="btn btn-checkout w-100 fs-6 d-flex justify-content-center align-items-center gap-2">
                            Thanh toán <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div> <!-- KẾT THÚC CỘT PHẢI -->

            </div> <!-- KẾT THÚC DÒNG ROW -->
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>