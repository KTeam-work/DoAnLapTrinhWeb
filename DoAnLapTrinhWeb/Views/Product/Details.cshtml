
@model DoAnLapTrinhWeb.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";

    var sizes = Model.ProductSizes ?? new List<DoAnLapTrinhWeb.Models.ProductSize>();
    var productToppings = Model.ProductToppings ?? new List<DoAnLapTrinhWeb.Models.ProductTopping>();

    var minPrice = sizes.Any() ? sizes.Min(x => x.price_add) : 0;
    var maxPrice = sizes.Any() ? sizes.Max(x => x.price_add) : 0;

    string pId = Model.product_id?.Trim() ?? "";
    string pName = Model.name ?? "";
    string pDesc = Model.description ?? "";
    string pStatus = Model.status ?? "Unavailable";
    string catName = Model.Category?.category_name ?? "Khác";

    string currentImage = string.IsNullOrWhiteSpace(Model.image_url)
        ? ""
        : System.IO.Path.GetFileName(Model.image_url.Trim());

    var sizeSObj = sizes.FirstOrDefault(s =>
        s.size_name != null &&
        (s.size_name.Trim() == "S" || s.size_name.Trim() == "Size S"));

    var sizeMObj = sizes.FirstOrDefault(s =>
        s.size_name != null &&
        (s.size_name.Trim() == "M" || s.size_name.Trim() == "Size M"));

    var sizeLObj = sizes.FirstOrDefault(s =>
        s.size_name != null &&
        (s.size_name.Trim() == "L" || s.size_name.Trim() == "Size L"));

    decimal valS = sizeSObj?.price_add ?? 0;
    decimal valM = sizeMObj?.price_add ?? 0;
    decimal valL = sizeLObj?.price_add ?? 0;

    var productImages = ViewBag.ProductImages as List<string>
        ?? new List<string>();

    string invariantS = valS.ToString(System.Globalization.CultureInfo.InvariantCulture);
    string invariantM = valM.ToString(System.Globalization.CultureInfo.InvariantCulture);
    string invariantL = valL.ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<link rel="stylesheet" href="~/Css/styleProduct_index.css" />

<style>
    .detail-image-box {
        width: 150px;
        height: 150px;
        border-radius: 24px;
        background: #eaf3ef;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e6dcc2;
        overflow: hidden;
        margin: auto;
    }

        .detail-image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .image-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(105px, 1fr));
        gap: 12px;
        margin-top: 15px;
    }

    .image-option {
        position: relative;
        border: 2px solid #e6ece8;
        border-radius: 12px;
        padding: 5px;
        background: #fff;
        cursor: pointer;
        transition: .2s;
    }

        .image-option:hover {
            border-color: #20584f;
            transform: translateY(-2px);
        }

        .image-option.selected {
            border-color: #20584f;
            background: #eaf3ef;
            box-shadow: 0 0 0 2px rgba(32, 88, 79, .12);
        }

        .image-option img {
            width: 100%;
            height: 90px;
            object-fit: cover;
            border-radius: 8px;
            display: block;
        }

        .image-option .image-check {
            display: none;
            position: absolute;
            top: 8px;
            right: 8px;
            width: 23px;
            height: 23px;
            border-radius: 50%;
            background: #20584f;
            color: white;
            align-items: center;
            justify-content: center;
        }

        .image-option.selected .image-check {
            display: flex;
        }

        .image-option .image-name {
            display: block;
            font-size: 11px;
            color: #52645d;
            margin-top: 6px;
            text-align: center;
            overflow-wrap: anywhere;
        }

    .image-gallery-wrapper {
        border: 1px dashed #cbd9d2;
        border-radius: 14px;
        padding: 15px;
        background: #fafcfb;
    }

    .review-card {
        border: 1px solid #eef2ef;
        border-radius: 16px;
        padding: 20px;
        background: #fafcfb;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all .3s ease;
    }

        .review-card:hover {
            border-color: #20584f;
            transform: translateY(-2px);
        }

    @@media (max-width: 768px) {
        .product-heading {
            flex-wrap: wrap;
            gap: 15px;
        }
    }
</style>

<div class="product-page">

    <!-- HEADER -->
    <div class="product-heading">

        <div class="heading-left">
            <div class="heading-icon">
                <i class="bi bi-cup-hot-fill"></i>
            </div>

            <div>
                <h1 class="page-title">Chi tiết sản phẩm</h1>
                <p class="page-subtitle">
                    Xem thông tin chi tiết về sản phẩm, giá bán và topping.
                </p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">

            <button type="button"
                    class="btn btn-outline-success d-inline-flex align-items-center px-3"
                    style="border-color:#20584f;color:#20584f;font-weight:600;border-radius:10px;"
                    onclick="openEditModal()">

                <i class="bi bi-pencil-square me-2"></i>
                Chỉnh sửa
            </button>

            <button type="button"
                    class="btn btn-outline-danger d-inline-flex align-items-center px-3"
                    style="font-weight:600;border-radius:10px;"
                    onclick="deleteProduct('@pId', @Html.Raw(Json.Encode(pName)))">

                <i class="bi bi-trash-fill me-2"></i>
                Xóa sản phẩm
            </button>

            <a href="@Url.Action("Index", "Product")"
               class="btn-filter d-inline-flex align-items-center px-3 text-decoration-none">

                <i class="bi bi-arrow-left me-2"></i>
                Quay lại danh sách
            </a>

        </div>
    </div>

    <!-- PRODUCT DETAIL -->
    <div class="row g-4">

        <!-- LEFT: PRODUCT INFORMATION -->
        <div class="col-lg-5">

            <div class="product-table-card h-100">

                <div class="p-4 text-center">

                    <!-- CURRENT PRODUCT IMAGE -->
                    <div class="detail-image-box mb-4">

                        @if (!string.IsNullOrWhiteSpace(Model.image_url))
                        {
                            <img id="currentProductImage"
                                 src="@Url.Content(Model.image_url)"
                                 alt="@pName" />
                        }
                        else
                        {
                            <img id="currentProductImage"
                                 src=""
                                 alt="@pName"
                                 style="display:none;" />

                            <i id="currentImagePlaceholder"
                               class="bi bi-cup-straw"
                               style="font-size:55px;color:#20584f;"></i>
                        }

                    </div>

                    <h2 style="margin:0;color:#17463e;font-size:22px;font-weight:800;">
                        @pName
                    </h2>

                    <div class="mt-3">
                        <span class="product-code">@pId</span>
                    </div>

                    <div class="mt-3">
                        @if (pStatus == "Available")
                        {
                            <span class="status-badge available">
                                <i class="bi bi-circle-fill"></i>
                                Đang bán
                            </span>
                        }
                        else
                        {
                            <span class="status-badge unavailable">
                                <i class="bi bi-circle-fill"></i>
                                Ngừng bán
                            </span>
                        }
                    </div>

                </div>

                <!-- DIRECT IMAGE CHANGE -->
                <div class="px-4 pb-4">

                    <div class="image-gallery-wrapper">

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                            <div>
                                <div style="font-weight:800;color:#20584f;">
                                    <i class="bi bi-images me-2"></i>
                                    Ảnh sản phẩm
                                </div>

                                <small class="text-muted">
                                    Thay đổi ảnh trực tiếp tại đây.
                                </small>
                            </div>

                            <button type="button"
                                    class="btn btn-outline-success btn-sm"
                                    onclick="toggleImageGallery()"
                                    id="toggleGalleryButton">

                                <i class="bi bi-images me-1"></i>
                                Thay đổi ảnh
                            </button>

                        </div>

                        <div id="imageGallerySection" style="display:none;">

                            <div class="mt-3 mb-2"
                                 style="font-size:12px;color:#78837e;">
                                Chọn hình ảnh muốn sử dụng:
                            </div>

                            <div class="image-gallery">

                                @foreach (var image in productImages)
                                {
                                    <button type="button"
                                            class="image-option"
                                            data-image="@image"
                                            onclick="selectDetailImage(this)">

                                        <img src="@Url.Content("~/Assets/" + image)"
                                             alt="Ảnh sản phẩm"
                                             onerror="this.style.opacity='0.3';" />

                                        <span class="image-check">
                                            <i class="bi bi-check-lg"></i>
                                        </span>

                                        <span class="image-name">
                                            @image
                                        </span>

                                    </button>
                                }

                            </div>

                            @if (!productImages.Any())
                            {
                                <div class="text-center text-muted py-3">
                                    Không tìm thấy ảnh trong thư mục Assets.
                                </div>
                            }

                            <div class="d-flex justify-content-end gap-2 mt-3">

                                <button type="button"
                                        class="btn btn-light btn-sm"
                                        onclick="cancelDetailImageChange()">
                                    Hủy
                                </button>

                                <button type="button"
                                        class="btn btn-success btn-sm"
                                        id="saveDetailImageButton"
                                        onclick="saveDetailImage()"
                                        disabled>

                                    <i class="bi bi-check-circle me-1"></i>
                                    Lưu ảnh
                                </button>

                            </div>

                        </div>

                    </div>

                    <div style="border-top:1px solid #eee8da;padding-top:20px;margin-top:20px;">

                        <div class="mb-3">
                            <div class="form-label">Danh mục</div>

                            <div>
                                <span class="category-badge">
                                    <i class="bi bi-tag-fill me-1"></i>
                                    @catName
                                </span>
                            </div>
                        </div>

                        <div>
                            <div class="form-label">Mô tả sản phẩm</div>

                            <div style="color:#78837e;font-size:13px;line-height:1.7;">
                                @pDesc
                            </div>
                        </div>

                    </div>

                </div>

            </div>
        </div>

        <!-- RIGHT: PRICE + TOPPING -->
        <div class="col-lg-7">

            <!-- PRICE CARD -->
            <div class="product-table-card mb-4">

                <div class="table-top">
                    <div>
                        <h2 class="table-title">
                            <i class="bi bi-cash-stack me-2"></i>
                            Giá bán theo size
                        </h2>

                        <span class="table-note">
                            Giá được quản lý theo bảng ProductSizes
                        </span>
                    </div>
                </div>

                <div class="p-4">

                    <div class="row g-3">

                        @if (sizes.Any())
                        {
                            foreach (var size in sizes)
                            {
                                <div class="col-md-4">

                                    <div style="border:1px solid #e6dcc2;border-radius:14px;padding:20px;text-align:center;background:#fffdf8;">

                                        <div style="width:48px;height:48px;margin:0 auto 12px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#eaf3ef;color:#20584f;font-weight:800;">
                                            @size.size_name
                                        </div>

                                        <div style="color:#78837e;font-size:12px;font-weight:700;margin-bottom:6px;">
                                            SIZE @size.size_name
                                        </div>

                                        <div style="color:#c65b4a;font-size:18px;font-weight:800;">
                                            @size.price_add.ToString("N0") đ
                                        </div>

                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center py-3 text-muted">
                                Sản phẩm chưa cấu hình giá theo size.
                            </div>
                        }

                    </div>
                </div>
            </div>

            <!-- TOPPING CARD -->
            <div class="product-table-card">

                <div class="table-top">

                    <div>
                        <h2 class="table-title">
                            <i class="bi bi-plus-circle me-2"></i>
                            Topping đi kèm
                        </h2>

                        <span class="table-note">
                            Danh sách topping thuộc sản phẩm
                        </span>
                    </div>

                    <span class="category-badge">
                        @productToppings.Count topping
                    </span>

                </div>

                <div class="p-4">

                    @if (productToppings.Any())
                    {
                        <div class="row g-3">

                            @foreach (var pt in productToppings)
                            {
                                string toppingName = pt.Topping?.name ?? "Topping";

                                <div class="col-md-6">

                                    <div style="display:flex;align-items:center;gap:12px;padding:14px 15px;border:1px solid #e6dcc2;border-radius:12px;background:#fffdf8;">

                                        <div style="width:38px;height:38px;flex:0 0 38px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:#fff7d7;color:#9a6b00;">
                                            <i class="bi bi-stars"></i>
                                        </div>

                                        <div style="color:#213430;font-size:13px;font-weight:700;">
                                            @toppingName
                                        </div>

                                    </div>
                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">

                            <i class="bi bi-info-circle"
                               style="font-size:30px;color:#b7c5bf;"></i>

                            <p style="margin:10px 0 0;color:#78837e;font-size:13px;">
                                Sản phẩm chưa có topping.
                            </p>

                        </div>
                    }

                </div>
            </div>

        </div>
    </div>

    <!-- BOTTOM INFORMATION -->
    <div class="product-table-card mt-4">

        <div class="table-top">
            <div>
                <h2 class="table-title">
                    <i class="bi bi-info-circle me-2"></i>
                    Tổng quan sản phẩm
                </h2>
            </div>
        </div>

        <div class="p-4">

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="form-label">Mã sản phẩm</div>
                    <span class="product-code">@pId</span>
                </div>

                <div class="col-md-4">
                    <div class="form-label">Danh mục</div>
                    <div class="category-badge">@catName</div>
                </div>

                <div class="col-md-4">
                    <div class="form-label">Khoảng giá</div>

                    <div class="product-price">

                        @if (minPrice == maxPrice)
                        {
                            @minPrice.ToString("N0") <text>đ</text>
                        }
                        else
                        {
                            @minPrice.ToString("N0")
                            <text> - </text>
                            @maxPrice.ToString("N0")
                            <text>đ</text>
                        }

                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

<!-- EDIT PRODUCT MODAL -->
<div class="modal fade product-page-modal"
     id="editProductModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    <i class="bi bi-pencil-square me-2"></i>
                    Chỉnh sửa sản phẩm
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <form id="editProductForm">

                    <div class="row g-4">

                        <div class="col-md-4">
                            <label class="modal-label">Mã sản phẩm</label>

                            <input type="text"
                                   id="editProductId"
                                   class="form-control"
                                   readonly />
                        </div>

                        <div class="col-md-8">
                            <label class="modal-label">
                                Tên sản phẩm <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="editProductName"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="modal-label">Loại sản phẩm</label>

                            <select id="editProductCategory"
                                    class="form-select">

                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in (List<DoAnLapTrinhWeb.Models.Category>)ViewBag.Categories)
                                    {
                                        <option value="@cat.category_name">
                                            @cat.category_name
                                        </option>
                                    }
                                }

                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="modal-label">Trạng thái</label>

                            <select id="editProductStatus"
                                    class="form-select">

                                <option value="Available">Đang bán</option>
                                <option value="Unavailable">Ngừng bán</option>

                            </select>
                        </div>

                        <div class="col-12">
                            <label class="modal-label">Mô tả sản phẩm</label>

                            <textarea id="editProductDescription"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                    </div>

                    <!-- SIZE PRICES -->
                    <div class="mt-4">

                        <h5 style="color:#20584f;font-weight:800;">
                            <i class="bi bi-cash-stack me-2"></i>
                            Cập nhật giá theo size
                        </h5>

                        <div class="row g-3 mt-1">

                            <div class="col-md-4">
                                <label class="modal-label">Size S</label>

                                <input type="number"
                                       id="editPriceS"
                                       class="form-control"
                                       min="0" />
                            </div>

                            <div class="col-md-4">
                                <label class="modal-label">Size M</label>

                                <input type="number"
                                       id="editPriceM"
                                       class="form-control"
                                       min="0" />
                            </div>

                            <div class="col-md-4">
                                <label class="modal-label">Size L</label>

                                <input type="number"
                                       id="editPriceL"
                                       class="form-control"
                                       min="0" />
                            </div>

                        </div>
                    </div>

                </form>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn-filter"
                        data-bs-dismiss="modal">
                    Hủy
                </button>

                <button type="button"
                        class="btn-save"
                        onclick="saveProductEdit()">
                    Lưu thay đổi
                </button>

            </div>

        </div>
    </div>
</div>

<!-- PRODUCT REVIEWS -->
<div class="product-table-card mt-4 p-4"
     style="border:1px solid #e6dcc2;border-radius:20px;background:#fff;box-shadow:0 10px 30px rgba(33,52,48,.04);">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pb-3 mb-4"
         style="border-bottom:2px dashed #f0eada;">

        <div class="d-flex align-items-center gap-3">

            <div style="width:48px;height:48px;border-radius:14px;background:#eaf3ef;color:#20584f;display:flex;align-items:center;justify-content:center;font-size:22px;">
                <i class="bi bi-chat-square-quote-fill"></i>
            </div>

            <div>
                <h2 class="table-title mb-0"
                    style="font-size:20px;font-weight:800;color:#17463e;">
                    Đánh giá từ khách hàng
                </h2>

                <span class="table-note"
                      style="color:#78837e;font-size:13px;">
                    Phản hồi và trải nghiệm thực tế về sản phẩm
                </span>
            </div>

        </div>

        <div style="background:#eaf3ef;color:#20584f;padding:6px 16px;border-radius:30px;font-weight:700;font-size:13px;border:1px solid #d0e2db;">
            <i class="bi bi-star-fill text-warning me-1"></i>
            @(Model.ProductReviews?.Count ?? 0) phản hồi
        </div>

    </div>

    @if (Model.ProductReviews != null && Model.ProductReviews.Any())
    {
        <div class="row g-4">

            @foreach (var review in Model.ProductReviews)
            {
                string customerName =
                    review.Customer != null &&
                    !string.IsNullOrEmpty(review.Customer.full_name)
                    ? review.Customer.full_name.Trim()
                    : "Khách hàng ẩn danh";

                string initial = customerName.Substring(0, 1).ToUpper();
                string comment = review.comment ?? "";
                int rating = review.rating;

                string reviewDate = review.created_at != default(DateTime)
                    ? review.created_at.ToString("dd/MM/yyyy HH:mm")
                    : "";

                <div class="col-md-6">

                    <div class="review-card">

                        <div>

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <div class="d-flex align-items-center"
                                     style="gap:10px;">

                                    <div style="width:38px;height:38px;border-radius:50%;background:#20584f;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;">
                                        @initial
                                    </div>

                                    <div>

                                        <div style="font-weight:700;color:#213430;font-size:14px;line-height:1.2;">
                                            @customerName
                                        </div>

                                        <div style="color:#99a39f;font-size:11px;margin-top:2px;">
                                            @reviewDate
                                        </div>

                                    </div>

                                </div>

                                <div style="color:#f5c84b;font-size:13px;letter-spacing:1px;background:#fff;padding:4px 10px;border-radius:20px;border:1px solid #f2eedb;">

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted opacity-25"></i>
                                        }
                                    }

                                </div>

                            </div>

                            <div style="color:#4a5c55;font-size:13.5px;line-height:1.6;background:#fff;padding:12px 14px;border-radius:10px;border:1px solid #edf2f0;">
                                &ldquo;@comment&rdquo;
                            </div>

                        </div>

                        <div class="d-flex align-items-center justify-content-end mt-3 pt-2 text-muted"
                             style="font-size:11px;">

                            <span class="badge bg-light text-dark fw-normal border">
                                Đã mua hàng
                            </span>

                        </div>

                    </div>
                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center py-5"
             style="background:#fafcfb;border-radius:16px;border:1px dashed #dbe4e1;">

            <div style="width:60px;height:60px;border-radius:50%;background:#eaf3ef;color:#20584f;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:24px;">
                <i class="bi bi-chat-left-text"></i>
            </div>

            <h5 style="color:#213430;font-weight:700;font-size:16px;margin-bottom:4px;">
                Chưa có đánh giá nào
            </h5>

            <p style="color:#78837e;font-size:13px;margin:0;">
                Sản phẩm này hiện chưa nhận được phản hồi công khai từ khách hàng.
            </p>

        </div>
    }

</div>

<!-- JAVASCRIPT -->
<script>

    // Đường dẫn thư mục Assets
    const productAssetsUrl = '@Url.Content("~/Assets/")';

    // Thông tin hiện tại của sản phẩm
    const detailProduct = {
        id: @Html.Raw(Json.Encode(pId)),
        name: @Html.Raw(Json.Encode(pName)),
        category: @Html.Raw(Json.Encode(catName)),
        status: @Html.Raw(Json.Encode(pStatus)),
        description: @Html.Raw(Json.Encode(pDesc)),
        priceS: "@invariantS",
        priceM: "@invariantM",
        priceL: "@invariantL"
    };

    let selectedDetailImage = "";
    let originalDetailImage = @Html.Raw(Json.Encode(currentImage));

    // Mở / đóng danh sách ảnh
    function toggleImageGallery() {

        const gallery = document.getElementById("imageGallerySection");
        const button = document.getElementById("toggleGalleryButton");

        const isHidden = gallery.style.display === "none";

        gallery.style.display = isHidden ? "block" : "none";

        button.innerHTML = isHidden
            ? '<i class="bi bi-x-lg me-1"></i> Đóng danh sách'
            : '<i class="bi bi-images me-1"></i> Thay đổi ảnh';

        if (isHidden) {
            selectedDetailImage = originalDetailImage;
            updateGallerySelection();
            document.getElementById("saveDetailImageButton").disabled = true;
        }
    }

    // Chọn ảnh trong danh sách
    function selectDetailImage(button) {

        selectedDetailImage = button.dataset.image || "";

        updateGallerySelection();

        const preview = document.getElementById("currentProductImage");
        const placeholder = document.getElementById("currentImagePlaceholder");

        preview.src = productAssetsUrl + encodeURIComponent(selectedDetailImage);
        preview.style.display = "block";

        if (placeholder) {
            placeholder.style.display = "none";
        }

        document.getElementById("saveDetailImageButton").disabled =
            selectedDetailImage === originalDetailImage;
    }

    // Cập nhật trạng thái ảnh được chọn
    function updateGallerySelection() {

        document.querySelectorAll(".image-option").forEach(function (item) {

            item.classList.toggle(
                "selected",
                item.dataset.image === selectedDetailImage
            );

        });
    }

    // Hủy thay đổi ảnh
    function cancelDetailImageChange() {

        selectedDetailImage = originalDetailImage;

        const preview = document.getElementById("currentProductImage");
        const placeholder = document.getElementById("currentImagePlaceholder");

        if (originalDetailImage) {

            preview.src = productAssetsUrl + encodeURIComponent(originalDetailImage);
            preview.style.display = "block";

            if (placeholder) {
                placeholder.style.display = "none";
            }

        } else {

            preview.src = "";
            preview.style.display = "none";

            if (placeholder) {
                placeholder.style.display = "flex";
            }
        }

        updateGallerySelection();

        document.getElementById("saveDetailImageButton").disabled = true;
    }

    // Lưu ảnh trực tiếp từ trang Details
    async function saveDetailImage() {

        if (!selectedDetailImage) {
            alert("Vui lòng chọn ảnh sản phẩm.");
            return;
        }

        if (selectedDetailImage === originalDetailImage) {
            alert("Ảnh được chọn hiện đang là ảnh của sản phẩm.");
            return;
        }

        const button = document.getElementById("saveDetailImageButton");

        button.disabled = true;
        button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

        const formData = new URLSearchParams();

        formData.append("product_id", detailProduct.id);
        formData.append("name", detailProduct.name);
        formData.append("category_name", detailProduct.category);
        formData.append("status", detailProduct.status);
        formData.append("description", detailProduct.description);

        formData.append("priceS", detailProduct.priceS);
        formData.append("priceM", detailProduct.priceM);
        formData.append("priceL", detailProduct.priceL);

        formData.append("image_url", selectedDetailImage);
        formData.append("remove_image", "false");

        try {

            const response = await fetch('@Url.Action("Edit", "Product")', {

                method: "POST",

                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },

                body: formData.toString()
            });

            const result = await response.json();

            if (result.success) {

                alert("Cập nhật ảnh sản phẩm thành công!");

                // Tải lại trang để lấy ảnh mới từ database
                window.location.reload();

            } else {

                alert(result.message || "Không thể cập nhật ảnh sản phẩm.");

                button.disabled = false;
                button.innerHTML = '<i class="bi bi-check-circle me-1"></i> Lưu ảnh';
            }

        } catch (error) {

            console.error(error);

            alert("Lỗi kết nối máy chủ.");

            button.disabled = false;
            button.innerHTML = '<i class="bi bi-check-circle me-1"></i> Lưu ảnh';
        }
    }

    // Mở modal chỉnh sửa thông tin sản phẩm
    function openEditModal() {

        document.getElementById("editProductId").value = detailProduct.id;
        document.getElementById("editProductName").value = detailProduct.name;
        document.getElementById("editProductCategory").value = detailProduct.category;

        document.getElementById("editProductStatus").value =
            detailProduct.status === "Available" ? "Available" : "Unavailable";

        document.getElementById("editProductDescription").value =
            detailProduct.description;

        document.getElementById("editPriceS").value =
            Number(detailProduct.priceS) > 0 ? detailProduct.priceS : "";

        document.getElementById("editPriceM").value =
            Number(detailProduct.priceM) > 0 ? detailProduct.priceM : "";

        document.getElementById("editPriceL").value =
            Number(detailProduct.priceL) > 0 ? detailProduct.priceL : "";

        if (typeof bootstrap === "undefined") {

            alert("Bootstrap JavaScript chưa được tải. Vui lòng kiểm tra Layout.");
            return;
        }

        bootstrap.Modal
            .getOrCreateInstance(document.getElementById("editProductModal"))
            .show();
    }

    // Lưu chỉnh sửa thông tin sản phẩm
    async function saveProductEdit() {

        const productId =
            document.getElementById("editProductId").value.trim();

        const productName =
            document.getElementById("editProductName").value.trim();

        const category =
            document.getElementById("editProductCategory").value;

        const status =
            document.getElementById("editProductStatus").value;

        const description =
            document.getElementById("editProductDescription").value.trim();

        const priceS =
            document.getElementById("editPriceS").value.trim();

        const priceM =
            document.getElementById("editPriceM").value.trim();

        const priceL =
            document.getElementById("editPriceL").value.trim();

        if (!productName) {
            alert("Tên sản phẩm không được để trống.");
            return;
        }

        const prices = [priceS, priceM, priceL];

        for (let price of prices) {

            if (price !== "" &&
                (!Number.isFinite(Number(price)) || Number(price) < 0)) {

                alert("Giá sản phẩm phải là số không âm.");
                return;
            }
        }

        const formData = new URLSearchParams();

        formData.append("product_id", productId);
        formData.append("name", productName);
        formData.append("category_name", category);
        formData.append("status", status);
        formData.append("description", description);

        if (priceS !== "") formData.append("priceS", priceS);
        if (priceM !== "") formData.append("priceM", priceM);
        if (priceL !== "") formData.append("priceL", priceL);

        // Giữ nguyên ảnh hiện tại khi chỉ sửa thông tin
        formData.append("image_url", originalDetailImage);
        formData.append("remove_image", "false");

        try {

            const response = await fetch('@Url.Action("Edit", "Product")', {

                method: "POST",

                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },

                body: formData.toString()
            });

            const result = await response.json();

            if (result.success) {

                alert(result.message);

                window.location.href =
                    result.redirectUrl || '@Url.Action("Index", "Product")';

            } else {

                alert(result.message || "Không thể cập nhật sản phẩm.");
            }

        } catch (error) {

            console.error(error);

            alert("Lỗi kết nối máy chủ.");
        }
    }

    // Xóa sản phẩm
    async function deleteProduct(id, name) {

        if (!confirm("Bạn có chắc chắn muốn xóa sản phẩm '" + name + "' này không?")) {
            return;
        }

        const formData = new URLSearchParams();

        formData.append("id", id);

        try {

            const response = await fetch('@Url.Action("Delete", "Product")', {

                method: "POST",

                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },

                body: formData.toString()
            });

            const result = await response.json();

            if (result.success) {

                alert(result.message);

                window.location.href = '@Url.Action("Index", "Product")';

            } else {

                alert(result.message || "Không thể xóa sản phẩm.");
            }

        } catch (error) {

            console.error(error);

            alert("Lỗi kết nối máy chủ.");
        }
    }

</script>
