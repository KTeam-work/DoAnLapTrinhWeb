@model IEnumerable<DoAnLapTrinhWeb.Models.Product>
@{
    ViewBag.Title = "Thực Đơn - LumiTea";
    Layout = "~/Views/Shared/_Layout.cshtml";

    
    var categories = ViewBag.Categories as IEnumerable<DoAnLapTrinhWeb.Models.Category>;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />



    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link href="~/Css/StyleMenu.css" rel="stylesheet" />
</head>
<body>

    <div class="container py-4">
        <!-- TIÊU ĐỀ VÀ TÌM KIẾM -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h2 class="fw-extrabold m-0" style="color: var(--lumitea-primary); letter-spacing: -0.8px;">Thực Đơn</h2>
                <p class="text-muted m-0">Chọn món yêu thích của bạn từ LumiTea</p>
            </div>
            <div class="search-box position-relative" style="max-width: 300px; width: 100%;">
                <!-- Tính năng tìm kiếm bằng JS -->
                <input type="text" id="searchInput" class="form-control rounded-pill ps-4" placeholder="Tìm kiếm món...">
                <i class="fa-solid fa-search position-absolute top-50 end-0 translate-middle-y me-3 text-muted"></i>
            </div>
        </div>

        <!-- DANH MỤC LẤY TỪ VIEWBAG -->
        <ul class="nav nav-pills category-filter mb-4 border-bottom pb-3" id="categoryTabs">
            <li class="nav-item">
                <a class="nav-link active filter-btn" data-category="all">Tất cả</a>
            </li>
            @if (categories != null)
            {
                foreach (var category in categories)
                {
                    <li class="nav-item">
                        <a class="nav-link filter-btn" data-category="@category.category_id">@category.category_name</a>
                    </li>
                }
            }
        </ul>

        <!-- SẢN PHẨM LẤY TỪ MODEL -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="productList">
            @if (Model != null)
            {
                foreach (var product in Model)
                {
                    var isAvailable = (product.status == "Available");
                    var opacityStyle = isAvailable ? "" : "opacity: 0.6;";
                    var imageUrl = string.IsNullOrEmpty(product.image_url) ? "~/Assets/default.jpg" : product.image_url;

                    <!-- Thêm data-category và class product-item để dùng JS lọc -->
                    <div class="col product-item" data-category="@product.category_id">
                        <div class="card product-card h-100" style="@opacityStyle">
                            <div class="product-img-wrapper">
                                @if (!isAvailable)
                                {
                                    <span class="badge bg-danger position-absolute top-0 start-0 m-2 z-1">Hết hàng</span>
                                }
                                <img src="@Url.Content(imageUrl)" alt="@product.name" />
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold text-dark mb-1 fs-6 product-title">@product.name</h5>
                                <p class="card-text text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @product.description
                                </p>
                                <div class="mt-auto d-flex align-items-center justify-content-between">
                                    <span class="price-text">@product.base_price.ToString("N0") <span class="fs-6 text-decoration-underline">đ</span></span>

                                    @if (isAvailable)
                                    {
                                        <!-- Truyền ProductId vào data-id để Modal dùng -->
                                        <button class="btn btn-add-cart px-3 btn-open-modal" data-id="@product.product_id">
                                            <i class="fa-solid fa-plus"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary px-3" disabled>
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- MODAL THÊM VÀO GIỎ -->
    <div class="modal fade" id="orderModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 overflow-hidden">

                <!-- Bọc form gửi sang CartController -->
                <form id="addToCartForm" action="/Cart/Add" method="POST">
                    <input type="hidden" name="ProductId" id="modalProductId" value="" />
                    <input type="hidden" name="BasePrice" id="modalBasePrice" value="0" />

                    <div class="modal-header border-0 pb-3">
                        <h5 class="modal-title" id="modalTitle">Đang tải...</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-4 bg-light">
                        <!-- SIZE SẼ ĐƯỢC TẠO TỪ JAVASCRIPT -->
                        <h6 class="fw-bold mb-3"><i class="fa-solid fa-mug-hot me-2 text-muted"></i>Chọn Size (Bắt buộc)</h6>
                        <div class="d-flex flex-column gap-2 mb-4" id="modalSizeContainer">
                            <div class="text-center text-muted small">Đang tải...</div>
                        </div>

                        <!-- TOPPING SẼ ĐƯỢC TẠO TỪ JAVASCRIPT -->
                        <h6 class="fw-bold mb-3"><i class="fa-solid fa-ice-cream me-2 text-muted"></i>Thêm Topping (Tùy chọn)</h6>
                        <div class="d-flex flex-column gap-2 mb-3" id="modalToppingContainer">
                            <div class="text-center text-muted small">Đang tải...</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Ghi chú cho quán</label>
                            <input type="text" class="form-control" name="Note" id="modalNote" placeholder="Ít đá, ít ngọt...">
                        </div>

                        <div class="d-flex align-items-center justify-content-between">
                            <div class="input-group" style="width: 120px;">
                                <button class="btn btn-outline-secondary" type="button" id="btnMinus">-</button>
                                <input type="text" class="form-control text-center fw-bold" name="Quantity" id="modalQuantity" value="1" readonly>
                                <button class="btn btn-outline-secondary" type="button" id="btnPlus">+</button>
                            </div>
                            <!-- Vùng hiển thị tổng tiền -->
                            <h4 class="fw-extrabold m-0 text-danger" id="modalTotalPrice" style="color: var(--lumitea-primary) !important;">0 đ</h4>
                        </div>
                    </div>

                    <div class="modal-footer border-0 p-3 bg-white">
                        <button type="submit" class="btn w-100 py-2 fs-5 text-dark" style="background-color: var(--lumitea-accent); font-weight: 700; border-radius: 12px;">
                            Thêm vào giỏ hàng
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <!-- SCRIPTS CƠ BẢN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {

            // 1. TÍNH NĂNG LỌC THEO DANH MỤC
            $('.filter-btn').click(function () {
                // Đổi style tab đang chọn
                $('.filter-btn').removeClass('active'); $(this).addClass('active');

                var categoryId = $(this).data('category');

                if (categoryId === 'all') {
                    $('.product-item').show();
                } else {
                    $('.product-item').hide(); $('.product-item[data-category="' + categoryId + '"]').show();
                }
            });

            // 2. TÍNH NĂNG TÌM KIẾM NHANH (Bằng tên món)
            $('#searchInput').on('keyup', function () {
                var value = $(this).val().toLowerCase(); $('.product-item').filter(function () {
                    var title = $(this).find('.product-title').text().toLowerCase(); $(this).toggle(title.indexOf(value) > -1);
                });
            });

            // 3. TÍNH NĂNG MODAL VÀ TÍNH TIỀN
            var orderModal = new bootstrap.Modal(document.getElementById('orderModal'));

            // Khi bấm nút dấu (+) trên thẻ sản phẩm
            $('.btn-open-modal').click(function () {
                var productId = $(this).data('id');

                // Reset form
                $('#modalQuantity').val(1);
                $('#modalNote').val('');
                $('#modalTitle').text('Đang tải...');
                $('#modalSizeContainer').html('');
                $('#modalToppingContainer').html('');

                // Gọi AJAX đến hàm GetProductDetails trong MenuController
                $.ajax({
                    url: '/Menu/GetProductDetails',
                    type: 'GET',
                    data: { id: productId },
                    success: function (response) {
                        if (response.success) {
                            var data = response.data;

                            // Gắn data cơ bản vào Modal
                            $('#modalProductId').val(data.ProductId);
                            $('#modalBasePrice').val(data.BasePrice);
                            $('#modalTitle').text(data.Name);

                            // Render danh sách Size
                            var sizeHtml = '';
                            $.each(data.Sizes, function (index, size) {
                                var isChecked = (index === 0) ? 'checked' : ''; // Tự động check size đầu tiên
                                sizeHtml += `
                                            <label class="d-flex justify-content-between align-items-center p-3 bg-white rounded-3 border shadow-sm cursor-pointer size-label">
                                                <div class="form-check m-0">
                                                    <input class="form-check-input calc-trigger" type="radio" name="SizeId" value="${size.SizeId}" data-price="${size.PriceAdd}" ${isChecked}>
                                                    <label class="form-check-label fw-semibold">${size.SizeName}</label>
                                                </div>
                                                <span class="text-muted small">+ ${size.PriceAdd.toLocaleString('vi-VN')} đ</span>
                                            </label>
                                        `;
                            });
                            $('#modalSizeContainer').html(sizeHtml);

                            // Render danh sách Topping
                            var toppingHtml = '';
                            if (data.Toppings.length === 0) {
                                toppingHtml = '<span class="text-muted small">Không có topping cho món này.</span>';
                            } else {
                                $.each(data.Toppings, function (index, topping) {
                                    toppingHtml += `
                                                <label class="d-flex justify-content-between align-items-center p-2 px-3 bg-white rounded-3 border cursor-pointer">
                                                    <div class="form-check m-0">
                                                        <input class="form-check-input calc-trigger" type="checkbox" name="ToppingIds" value="${topping.ToppingId}" data-price="${topping.Price}">
                                                        <label class="form-check-label">${topping.ToppingName}</label>
                                                    </div>
                                                    <span class="text-muted small">+ ${topping.Price.toLocaleString('vi-VN')} đ</span>
                                                </label>
                                            `;
                                });
                            }
                            $('#modalToppingContainer').html(toppingHtml);

                            // Tính lại tổng tiền ban đầu
                            calculateTotal();

                            // Hiển thị Modal
                            orderModal.show();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert('Lỗi kết nối tới máy chủ!');
                    }
                });
            });

            // Hàm tính tổng tiền (BasePrice + Size Price + Sum Topping Price) * Quantity
            function calculateTotal() {
                var basePrice = parseFloat($('#modalBasePrice').val()) || 0;
                var quantity = parseInt($('#modalQuantity').val()) || 1;

                // Lấy tiền size đang chọn
                var sizePrice = parseFloat($('input[name="SizeId"]:checked').data('price')) || 0;

                // Tính tổng tiền các topping được check
                var toppingPrice = 0;
                $('input[name="ToppingIds"]:checked').each(function () {
                    toppingPrice += parseFloat($(this).data('price')) || 0;
                });

                // Cập nhật lên UI
                var total = (basePrice + sizePrice + toppingPrice) * quantity;
                $('#modalTotalPrice').text(total.toLocaleString('vi-VN') + ' đ');
            }

            // Gắn sự kiện thay đổi radio, checkbox để tính lại tiền
            $(document).on('change', '.calc-trigger', function () {
                calculateTotal();
            });

            // Gắn sự kiện nút cộng trừ số lượng
            $('#btnMinus').click(function () {
                var qty = parseInt($('#modalQuantity').val());
                if (qty > 1) {
                    $('#modalQuantity').val(qty - 1);
                    calculateTotal();
                }
            });
            $('#btnPlus').click(function () {
                var qty = parseInt($('#modalQuantity').val());
                $('#modalQuantity').val(qty + 1);
                calculateTotal();
            });

        });
    </script>


</body>
</html>