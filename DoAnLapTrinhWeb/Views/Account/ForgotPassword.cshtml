@model DoAnLapTrinhWeb.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}


<style>
    .tv1-auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 75vh;
        background: #f8f9fa;
        padding: 20px;
    }

    .tv1-card {
        background: #ffffff;
        width: 100%;
        max-width: 420px;
        padding: 40px 30px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border: 1px solid #eaeaea;
    }

        .tv1-card h2 {
            font-size: 24px;
            font-weight: 700;
            color: #2c3e50;
            text-align: center;
            margin-bottom: 24px;
        }

    .tv1-form label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #495057;
        margin-bottom: 8px;
    }

    .tv1-form input[type="email"] {
        width: 100%;
        padding: 12px 16px;
        font-size: 15px;
        border: 1.5px solid #ced4da;
        border-radius: 10px;
        outline: none;
        transition: all 0.3s ease;
        background: #fdfdfd;
        margin-bottom: 6px;
    }

        .tv1-form input[type="email"]:focus {
            border-color: #198754;
            box-shadow: 0 0 0 4px rgba(25, 135, 84, 0.1);
            background: #fff;
        }

    .tv1-btn {
        width: 100%;
        padding: 12px;
        font-size: 16px;
        font-weight: 600;
        color: #fff;
        background-color: #198754;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: background-color 0.2s ease;
        margin-top: 10px;
    }

        .tv1-btn:hover {
            background-color: #157347;
        }

    .tv1-success {
        background-color: #d1e7dd;
        color: #0f5132;
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 14px;
        margin-bottom: 20px;
        border: 1px solid #badbcc;
    }

    .tv1-alert {
        background-color: #f8d7da;
        color: #842029;
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 14px;
        margin-bottom: 20px;
        border: 1px solid #f5c2c7;
    }

        .tv1-alert p {
            margin: 0;
        }

    .field-error {
        color: #dc3545;
        font-size: 13px;
        margin-bottom: 15px;
        display: block;
    }

    .tv1-links {
        text-align: center;
        margin-top: 20px;
    }

        .tv1-links a {
            color: #198754;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            transition: color 0.2s ease;
        }

            .tv1-links a:hover {
                text-decoration: underline;
                color: #157347;
            }
</style>

<div class="tv1-auth-container">
    <div class="tv1-card">
        <h2>Quên mật khẩu</h2>

        @if (Model != null && Model.EmailSent)
        {
            <div class="tv1-success">Nếu email này đã đăng ký, một liên kết đặt lại mật khẩu sẽ được gửi tới.</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="tv1-alert">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "tv1-form" }))
        {
            @Html.AntiForgeryToken()

            @Html.LabelFor(m => m.Email, "Nhập Email của bạn")
            @Html.TextBoxFor(m => m.Email, new { type = "email", placeholder = "name@example.com" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })

            <button type="submit" class="tv1-btn">Gửi yêu cầu</button>
        }

        <div class="tv1-links">
            <a href="@Url.Action("Login", "Account")"><i class="bi bi-arrow-left"></i> Quay lại đăng nhập</a>
        </div>
    </div>
</div>