@model QuanLyTraSua.Models.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="tv1-card">
    <h2>Tạo tài khoản</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="tv1-alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }

    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "tv1-form" }))
    {
        @Html.AntiForgeryToken()

        @Html.LabelFor(m => m.FullName)
        @Html.TextBoxFor(m => m.FullName, new { placeholder = "Nguyễn Văn A" })
        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "field-error" })

        @Html.LabelFor(m => m.Username)
        @Html.TextBoxFor(m => m.Username, new { placeholder = "username" })
        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "field-error" })

        @Html.LabelFor(m => m.Email)
        @Html.TextBoxFor(m => m.Email, new { type = "email", placeholder = "ban@email.com" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })

        @Html.LabelFor(m => m.Phone)
        @Html.TextBoxFor(m => m.Phone, new { placeholder = "09xxxxxxxx" })
        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "field-error" })

        @Html.LabelFor(m => m.Password)
        @Html.PasswordFor(m => m.Password, new { placeholder = "••••••••" })
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })

        @Html.LabelFor(m => m.ConfirmPassword)
        @Html.PasswordFor(m => m.ConfirmPassword, new { placeholder = "••••••••" })
        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-error" })

        <button type="submit" class="tv1-btn">Đăng ký</button>
    }

    <div class="tv1-links">
        Đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
    </div>
</div>
