@model IEnumerable<DoAnLapTrinhWeb.Models.StaffShift>

@{
    ViewBag.Title = "Bảng Lịch Phân Ca Tuần";
    int currentOffset = ViewBag.WeekOffset != null ? (int)ViewBag.WeekOffset : 0;
    DateTime startOfWeek = ViewBag.StartOfWeek != null ? (DateTime)ViewBag.StartOfWeek : DateTime.Today;
    DateTime endOfWeek = ViewBag.EndOfWeek != null ? (DateTime)ViewBag.EndOfWeek : DateTime.Today;
    var shifts = ViewBag.Shifts as List<DoAnLapTrinhWeb.Models.Shift> ?? new List<DoAnLapTrinhWeb.Models.Shift>();
    var users = ViewBag.Users as List<DoAnLapTrinhWeb.Models.User> ?? new List<DoAnLapTrinhWeb.Models.User>();

    // 7 ngày trong tuần từ Thứ 2 đến Chủ Nhật
    var weekDays = new List<DateTime>();
    for (int i = 0; i < 7; i++)
    {
        weekDays.Add(startOfWeek.AddDays(i));
    }
}

<!-- Fonts, FontAwesome, jQuery & Select2 -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<style>
    :root {
        --primary-color: #10b981;
        --primary-dark: #059669;
        --bg-main: #FCF9F2;
        --card-bg: #ffffff;
        --text-dark: #1e293b;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
    }

    body {
        background-color: var(--bg-main);
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        color: #334155;
    }

    .page-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--text-dark);
    }

    .app-card {
        background: var(--card-bg);
        border-radius: 20px;
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.03);
        padding: 24px;
    }

    .schedule-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .schedule-table th {
            background-color: #0f382c !important;
            color: #ffffff;
            font-size: 0.82rem;
            font-weight: 700;
            text-align: center;
            padding: 14px 10px;
            border: 1px solid #165b46;
        }

            .schedule-table th.time-col {
                background-color: #0b2920 !important;
                width: 160px;
            }

        .schedule-table td {
            border: 1px solid var(--border-color);
            padding: 10px;
            vertical-align: top;
            height: 130px;
            background-color: #fff;
        }

    .shift-chip {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-left: 4px solid #10b981;
        border-radius: 8px;
        padding: 6px 10px;
        margin-bottom: 6px;
        font-size: 0.8rem;
        position: relative;
        transition: all 0.2s;
    }

        .shift-chip:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.15);
        }

        .shift-chip .emp-name {
            font-weight: 700;
            color: #0f172a;
        }

        .shift-chip .emp-role {
            font-size: 0.72rem;
            color: #64748b;
        }

    .btn-add-shift {
        width: 100%;
        border: 2px dashed #cbd5e1;
        background: transparent;
        color: #94a3b8;
        border-radius: 8px;
        padding: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        transition: all 0.2s;
    }

        .btn-add-shift:hover {
            border-color: #10b981;
            color: #10b981;
            background-color: #f0fdf4;
        }

    .select2-container--default .select2-selection--single {
        height: 46px !important;
        border-radius: 10px !important;
        border: 1px solid #cbd5e1 !important;
        display: flex !important;
        align-items: center !important;
        background-color: #f8fafc !important;
    }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #1e293b !important;
            font-weight: 600 !important;
            padding-left: 12px !important;
        }

    .select2-dropdown {
        border-radius: 10px !important;
        border: 1px solid #cbd5e1 !important;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1) !important;
        z-index: 1060 !important;
    }
</style>

<div class="container-fluid px-4 py-4">

    <!-- Thông báo nếu có -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 1. Header Navigation -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h1 class="page-title mb-1">Bảng Lịch Phân Ca Tuần</h1>
            <p class="text-muted small mb-0">Quản lý và xếp lịch trực cho nhân sự toàn hệ thống LumiTea</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Index", "Shift")" class="btn btn-outline-secondary fw-bold px-3 py-2 text-decoration-none" style="border-radius: 12px;">
                <i class="fa-solid fa-fingerprint me-1"></i> Trang Điểm Danh Ca
            </a>
            <button class="btn btn-success fw-bold px-3 py-2" style="border-radius: 12px; background-color: #10b981;" data-bs-toggle="modal" data-bs-target="#assignShiftModal">
                <i class="fa-solid fa-plus me-1"></i> Phân Ca Mới
            </button>
        </div>
    </div>

    <!-- 2. Thanh Chọn Tuần -->
    <div class="app-card mb-4 py-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2">
                <a href="@Url.Action("Schedule", "Shift", new { weekOffset = currentOffset - 1 })" class="btn btn-light btn-sm fw-bold text-decoration-none">
                    <i class="fa-solid fa-chevron-left"></i> Tuần Trước
                </a>
                <span class="fw-bold text-dark px-2">
                    <i class="fa-regular fa-calendar-check text-success me-1"></i> Tuần: @startOfWeek.ToString("dd/MM/yyyy") - @endOfWeek.ToString("dd/MM/yyyy")
                </span>
                <a href="@Url.Action("Schedule", "Shift", new { weekOffset = currentOffset + 1 })" class="btn btn-light btn-sm fw-bold text-decoration-none">
                    Tuần Sau <i class="fa-solid fa-chevron-right"></i>
                </a>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="@Url.Action("Schedule", "Shift", new { weekOffset = 0 })" class="btn btn-outline-primary btn-sm fw-bold" style="border-radius: 8px;">
                    <i class="fa-solid fa-rotate-right me-1"></i> Tuần Hiện Tại
                </a>
            </div>
        </div>
    </div>

    <!-- 3. Bảng Thời Khóa Biểu 7 Ngày Tuần -->
    <div class="app-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="schedule-table">
                <thead>
                    <tr>
                        <th class="time-col">CA LÀM / NGÀY</th>
                        @for (int i = 0; i < 7; i++)
                        {
                            var d = weekDays[i];
                            string dayName = i == 6 ? "CHỦ NHẬT" : "THỨ " + (i + 2);
                            <th>@dayName<br><small class="fw-normal opacity-75">@d.ToString("dd/MM")</small></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sh in shifts)
                    {
                        <tr>
                            <td class="bg-light fw-bold text-dark align-middle text-center">
                                <i class="fa-solid fa-clock text-success me-1"></i> @sh.shift_name.ToUpper()<br>
                                <small class="text-muted fw-normal">(@sh.start_time.ToString(@"hh\:mm") - @sh.end_time.ToString(@"hh\:mm"))</small>
                            </td>

                            @foreach (var d in weekDays)
                            {
                                var assignedList = Model != null
                                    ? Model.Where(s => s.shift_id.Trim() == sh.shift_id.Trim() && s.work_date.Date == d.Date).ToList()
                                    : new List<DoAnLapTrinhWeb.Models.StaffShift>();

                                <td>
                                    @foreach (var item in assignedList)
                                    {
                                        <div class="shift-chip position-relative pe-4">
                                            <div class="emp-name">@(item.User != null ? item.User.full_name : "N/A")</div>
                                            <div class="emp-role">
                                                <i class="fa-solid fa-user-tag me-1"></i>@(item.User?.Role != null ? item.User.Role.role_name : "Nhân viên")
                                            </div>
                                            <button type="button" class="btn-close position-absolute top-50 end-0 translate-middle-y me-2"
                                                    style="font-size: 0.65rem;" onclick="removeAssignedShift('@item.staff_shift_id.Trim()')" title="Hủy ca trực"></button>
                                        </div>
                                    }
                                    <button type="button" class="btn-add-shift" onclick="openAssignModal('@d.ToString("yyyy-MM-dd")', '@sh.shift_id.Trim()')">+ Thêm</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL PHÂN CA LÀM VIỆC -->
<div class="modal fade" id="assignShiftModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);">
            <form action="@Url.Action("AssignShift", "Shift")" method="post">
                <div class="modal-header px-4 pt-4 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background-color: #d1fae5; color: #059669;">
                            <i class="fa-solid fa-calendar-plus fs-5"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Phân Ca Làm Việc</h5>
                            <p class="text-muted small mb-0">Xếp lịch làm việc cho nhân sự</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 py-3">

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">CHỌN NHÂN VIÊN <span class="text-danger">*</span></label>
                        <select name="UserId" class="form-select select2-assign" style="width: 100%;" required>
                            <option value="" disabled selected>-- Gõ tên hoặc Mã NV để tìm --</option>
                            @foreach (var u in users)
                            {
                                <option value="@u.user_id.Trim()">@u.user_id.Trim() - @u.full_name (@(u.Role != null ? u.Role.role_name : ""))</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">NGÀY LÀM VIỆC <span class="text-danger">*</span></label>
                        <input type="date" id="modalShiftDate" name="WorkDate" class="form-control bg-light fw-semibold" style="border-radius: 10px; padding: 11px; border: 1px solid #cbd5e1;" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">CHỌN CA LÀM <span class="text-danger">*</span></label>
                        <select id="modalShiftId" name="ShiftId" class="form-select bg-light text-dark fw-semibold" style="border-radius: 10px; padding: 11px; border: 1px solid #cbd5e1;" required>
                            @foreach (var sh in shifts)
                            {
                                <option value="@sh.shift_id.Trim()">@sh.shift_name (@sh.start_time.ToString(@"hh\:mm") - @sh.end_time.ToString(@"hh\:mm"))</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer px-4 pb-4 border-0">
                    <button type="button" class="btn btn-light fw-semibold px-4" data-bs-dismiss="modal" style="border-radius: 10px;">Hủy</button>
                    <button type="submit" class="btn btn-success fw-bold px-4" style="border-radius: 10px; background-color: #10b981; padding: 10px 24px;">Lưu Phân Ca</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openAssignModal(dateStr, shiftId) {
        document.getElementById('modalShiftDate').value = dateStr;
        if (shiftId) {
            document.getElementById('modalShiftId').value = shiftId;
        }
        new bootstrap.Modal(document.getElementById('assignShiftModal')).show();
    }

    function removeAssignedShift(id) {
        if (!confirm("Bạn có chắc muốn hủy ca làm việc này của nhân viên?")) return;
        $.post('@Url.Action("DeleteShift", "Shift")', { id: id }, function (res) {
            if (res.success) {
                location.reload();
            } else {
                alert(res.message);
            }
        });
    }

    $(document).ready(function () {
        $('.select2-assign').select2({
            dropdownParent: $('#assignShiftModal'),
            placeholder: "-- Gõ tên hoặc Mã NV để tìm --",
            allowClear: true
        });
    });
</script>