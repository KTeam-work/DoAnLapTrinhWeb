@model IEnumerable<DoAnLapTrinhWeb.Models.StaffShift>

@{
    ViewBag.Title = "Điểm Danh Ca Làm Việc";
    string userRole = (Session["UserRole"]?.ToString() ?? "").Trim();
    bool isAdmin = userRole == "R01" || userRole.Equals("Admin", StringComparison.OrdinalIgnoreCase);

    if (isAdmin)
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_StaffLayout.cshtml";
    }

    var myShift = ViewBag.MyShiftToday as DoAnLapTrinhWeb.Models.StaffShift;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<style>
    :root {
        --primary-color: #10b981;
        --banner-bg-start: #0f382c;
        --banner-bg-end: #165b46;
        --bg-main: #FCF9F2;
        --card-bg: #ffffff;
        --text-dark: #1e293b;
        --text-muted: #64748b;
        --border-color: #f1f5f9;
    }

    body {
        background-color: var(--bg-main);
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #334155;
    }

    .page-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--text-dark);
    }

    .hero-banner {
        background: linear-gradient(135deg, var(--banner-bg-start) 0%, var(--banner-bg-end) 100%) !important;
        border-radius: 20px;
        box-shadow: 0 10px 25px -5px rgba(15, 56, 44, 0.25);
    }

    .btn-action-in {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
        color: #fff !important;
        border: none;
        font-weight: 700;
        font-size: 1rem;
        padding: 12px 28px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
    }

    .btn-action-out {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
        color: #fff !important;
        border: none;
        font-weight: 700;
        font-size: 1rem;
        padding: 12px 28px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
    }

    .app-card {
        background: var(--card-bg);
        border-radius: 20px;
        border: 1px solid #edf2f7;
        box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.03);
        padding: 24px;
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .custom-table thead th {
            background-color: #f8fafc !important;
            color: #64748b;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            padding: 14px 16px;
            border: none;
        }

        .custom-table tbody td {
            padding: 14px 16px;
            vertical-align: middle;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.88rem;
        }

    .status-badge {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .status-working {
        background-color: #dcfce7;
        color: #15803d;
    }

    .status-completed {
        background-color: #e0f2fe;
        color: #0369a1;
    }

    .status-pending {
        background-color: #fef3c7;
        color: #b45309;
    }
</style>

<div class="container-fluid px-4 py-4">

    <!-- Thông báo Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 1. Tiêu đề trang -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h1 class="page-title mb-1">Trạm Chấm Công - Điểm Danh</h1>
            <div class="text-muted small">Quản lý và ghi nhận giờ vào ca, ra ca thực tế</div>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Schedule", "Shift")" class="btn btn-outline-success fw-bold px-3 py-2 text-decoration-none" style="border-radius: 12px;">
                <i class="fa-solid fa-calendar-days me-1"></i> Bảng Phân Ca Tuần
            </a>
        </div>
    </div>

    <!-- 2. Hero Banner: Khu vực chấm công của nhân viên đang đăng nhập -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-4 p-md-5 hero-banner position-relative overflow-hidden text-white">
                <div class="row align-items-center g-4">
                    <div class="col-lg-8">
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-25 mb-3 fs-7">
                            <span class="rounded-circle bg-success" style="width: 8px; height: 8px;"></span>
                            Phiên làm việc: @(Session["UserName"] ?? "Nhân viên") (#@(Session["UserId"] ?? ""))
                        </div>

                        @if (myShift != null)
                        {
                            <h2 class="fw-bold mb-2">Hôm nay bạn có ca: @(myShift.Shift != null ? myShift.Shift.shift_name : "")</h2>
                            <p class="mb-4 opacity-75">
                                Khung giờ quy định: <b>@(myShift.Shift != null ? myShift.Shift.start_time.ToString(@"hh\:mm") + " - " + myShift.Shift.end_time.ToString(@"hh\:mm") : "")</b>
                            </p>

                            if (myShift.check_in == null)
                            {
                                using (Html.BeginForm("CheckIn", "Shift", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    <input type="hidden" name="staffShiftId" value="@myShift.staff_shift_id" />
                                    <button type="submit" class="btn-action-in">
                                        <i class="fa-solid fa-right-to-bracket fs-5"></i> BẤM VÀO CA
                                    </button>
                                }
                            }
                            else if (myShift.check_out == null)
                            {
                                <div class="d-flex align-items-center gap-3 flex-wrap">
                                    <div class="bg-white bg-opacity-20 px-3 py-2 rounded-3">
                                        <i class="fa-regular fa-clock me-1"></i> Giờ vào ca: <b>@myShift.check_in.Value.ToString("HH:mm:ss")</b>
                                    </div>
                                    <button type="button" class="btn-action-out" onclick="handleCheckOut('@myShift.staff_shift_id')">
                                        <i class="fa-solid fa-right-from-bracket fs-5"></i> BẤM RA CA
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-light text-dark fw-bold d-inline-flex align-items-center gap-2 mb-0 rounded-3">
                                    <i class="fa-solid fa-circle-check text-success fs-5"></i>
                                    Bạn đã hoàn thành ca làm việc hôm nay! (Tổng: @myShift.total_hours giờ)
                                </div>
                            }
                        }
                        else
                        {
                            <h3 class="fw-bold mb-2">Hôm nay bạn không có lịch phân ca</h3>
                            <p class="mb-0 opacity-75">Nếu cần đăng ký bổ sung, vui lòng liên hệ quản lý để được xếp ca.</p>
                        }
                    </div>

                    <div class="col-lg-4 d-flex justify-content-lg-end">
                        <div class="text-center text-lg-end">
                            <div class="opacity-75 small text-uppercase fw-bold"><i class="fa-regular fa-clock me-1"></i> Đồng hồ hệ thống</div>
                            <div id="liveClock" class="fw-bold display-5 my-1" style="font-family: monospace;">00:00:00</div>
                            <div id="liveDate" class="small opacity-75">Đang cập nhật...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Bảng danh sách ca trực hôm nay (Giám sát) -->
    <div class="app-card">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
            <div>
                <h5 class="fw-bold text-dark mb-1">Danh Sách Ca Làm Hôm Nay (@(Model?.Count() ?? 0) Nhân viên)</h5>
                <p class="text-muted small mb-0">Theo dõi giờ vào, giờ ra và tổng thời gian làm việc thực tế</p>
            </div>
            <div class="d-flex gap-2">
                <input type="text" id="searchTableInput" class="form-control bg-light border-0 small" style="border-radius: 10px;" placeholder="Tìm nhân viên...">
                <input type="date" class="form-control bg-light border-0" style="border-radius: 10px;" value="@ViewBag.SelectedDate" readonly />
            </div>
        </div>

        <div class="table-responsive">
            <table class="custom-table" id="shiftTable">
                <thead>
                    <tr>
                        <th>NHÂN VIÊN</th>
                        <th>CA ĐĂNG KÝ</th>
                        <th>GIỜ VÀO THỰC TẾ</th>
                        <th>GIỜ RA THỰC TẾ</th>
                        <th>TỔNG GIỜ LÀM</th>
                        <th>TRẠNG THÁI</th>
                        @if (isAdmin)
                        {
                            <th class="text-end">THAO TÁC</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            bool hasCheckedIn = item.check_in != null;
                            bool hasCheckedOut = item.check_out != null;

                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@(item.User != null ? item.User.full_name : "N/A")</div>
                                    <div class="text-muted small">Mã NV: #@item.user_id.Trim()</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(item.Shift != null ? item.Shift.shift_name : "N/A")
                                    </span>
                                </td>
                                <td>
                                    @(hasCheckedIn ? item.check_in.Value.ToString("HH:mm:ss") : "--:--")
                                </td>
                                <td>
                                    @(hasCheckedOut ? item.check_out.Value.ToString("HH:mm:ss") : "--:--")
                                </td>
                                <td class="fw-bold text-success">
                                    @(hasCheckedOut && item.total_hours != null ? $"{item.total_hours}h" : "--")
                                </td>
                                <td>
                                    @if (!hasCheckedIn)
                                    {
                                        <span class="status-badge status-pending">
                                            <i class="fa-regular fa-clock"></i> Chưa vào ca
                                        </span>
                                    }
                                    else if (!hasCheckedOut)
                                    {
                                        <span class="status-badge status-working">
                                            <i class="fa-solid fa-spinner fa-spin"></i> Đang làm việc
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-completed">
                                            <i class="fa-solid fa-circle-check"></i> Đã hoàn thành
                                        </span>
                                    }
                                </td>
                                @if (isAdmin)
                                {
                                    <td class="text-end">
                                        @if (hasCheckedIn && !hasCheckedOut)
                                        {
                                            <button class="btn btn-sm btn-outline-danger me-1" onclick="handleCheckOut('@item.staff_shift_id')" title="Ra ca hộ nhân viên">
                                                <i class="fa-solid fa-right-from-bracket"></i> Ra ca
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-outline-secondary" onclick="deleteShift('@item.staff_shift_id')" title="Hủy ca trực">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Không có ca làm việc nào được phân công hôm nay.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function updateClock() {
        const now = new Date();
        document.getElementById('liveClock').innerText = now.toLocaleTimeString('vi-VN', { hour12: false });
        document.getElementById('liveDate').innerText = now.toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    }
    setInterval(updateClock, 1000);
    updateClock();

    function handleCheckOut(staffShiftId) {
        if (!confirm("Xác nhận bạn muốn kết thúc ca làm việc (Ra ca)?")) return;
        $.post('@Url.Action("CheckOut", "Shift")', { staffShiftId: staffShiftId }, function (res) {
            if (res.success) {
                alert(res.message);
                location.reload();
            } else {
                alert(res.message);
            }
        });
    }

    function deleteShift(id) {
        if (!confirm("Bạn có chắc chắn muốn hủy ca trực này?")) return;
        $.post('@Url.Action("DeleteShift", "Shift")', { id: id }, function (res) {
            if (res.success) {
                location.reload();
            } else {
                alert(res.message);
            }
        });
    }

    $(document).ready(function () {
        $("#searchTableInput").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("#shiftTable tbody tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });
    });
</script>