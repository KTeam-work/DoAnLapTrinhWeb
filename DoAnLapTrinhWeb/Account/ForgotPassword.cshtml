@page
@model TV1.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="tv1-card">
    <h2>Quên mật khẩu</h2>

    @if (Model.EmailSent)
    {
        <div class="tv1-alert">Đã gửi liên kết đặt lại mật khẩu đến email của bạn.</div>
    }

    <form method="post" class="tv1-form">
        <label asp-for="Email">Nhập email đã đăng ký</label>
        <input asp-for="Email" type="email" placeholder="ban@email.com" />

        <button type="submit" class="tv1-btn">Gửi yêu cầu</button>
    </form>

    <div class="tv1-links">
        <a asp-page="/Account/Login">Quay lại đăng nhập</a>
    </div>
</div>
